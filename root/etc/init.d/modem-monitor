#!/bin/sh /etc/rc.common
# Cable modem (Arris S33) signal monitor

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/modem-monitor

# How the router reaches the modem's management address (192.168.100.1):
#   host  - a /32 route via the WAN device; requests come from the WAN IP.
#           Adds no address, so DDNS/other tools never see a private WAN IP.
#   alias - adds 192.168.100.x/24 to the WAN device (label <dev>:mm). Some
#           ddns-scripts setups (ip_source=interface) pick this up as the WAN IP.
#   off   - you set up access yourself.
modem_mode() {
	local mode add
	config_get mode main modem_route ""
	if [ -z "$mode" ]; then
		config_get add main add_modem_route 1   # pre-1.0.8 setting
		[ "$add" = "1" ] && mode=host || mode=off
	fi
	echo "$mode"
}

wan_dev() {
	local dev
	config_get dev main wan_device ""
	if [ -z "$dev" ]; then
		. /lib/functions/network.sh
		network_flush_cache
		network_get_device dev wan || dev="$(uci -q get network.wan.device)"
	fi
	echo "$dev"
}

cleanup_modem_access() {
	local host alias dev
	config_get host main host 192.168.100.1
	config_get alias main modem_alias_ip 192.168.100.10
	dev="$(wan_dev)"
	[ -n "$dev" ] || return 0
	case "$host" in *[!0-9.]*) ;; *) ip route del "$host/32" dev "$dev" 2>/dev/null ;; esac
	ip addr del "$alias/24" dev "$dev" 2>/dev/null
}

setup_modem_access() {
	local host alias dev mode
	mode="$(modem_mode)"
	config_get host main host 192.168.100.1
	config_get alias main modem_alias_ip 192.168.100.10
	dev="$(wan_dev)"
	[ -n "$dev" ] || { logger -t modem-monitor "WAN device not found; not adding modem access"; return 0; }
	cleanup_modem_access
	case "$mode" in
	host)
		case "$host" in *[!0-9.]*) return 0 ;; esac
		ip route replace "$host/32" dev "$dev" 2>/dev/null && \
			logger -t modem-monitor "modem access: host route $host via $dev"
		;;
	alias)
		ip addr add "$alias/24" dev "$dev" label "$dev:mm" 2>/dev/null
		logger -t modem-monitor "modem access: alias $alias on $dev (label $dev:mm)"
		;;
	esac
}

start_service() {
	local enabled data_dir web_dir
	config_load modem_monitor
	config_get enabled main enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get data_dir main data_dir /root/modem-monitor
	config_get web_dir main web_dir /tmp/modem-monitor-www
	mkdir -p "$data_dir" "$web_dir"
	chmod 700 "$data_dir"
	setup_modem_access

	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	config_load modem_monitor
	cleanup_modem_access
}

service_triggers() {
	procd_add_reload_trigger modem_monitor
	procd_add_interface_trigger interface.* wan /etc/init.d/modem-monitor restart
}
