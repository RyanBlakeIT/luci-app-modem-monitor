
config modem_monitor 'main'
	option enabled '1'
	option isp_name ''
	option report_title ''
	option report_note ''
	option host '192.168.100.1'
	option username 'admin'
	option password ''
	option interval '300'
	option report_interval '900'
	option data_dir '/root/modem-monitor'
	option web_dir '/tmp/modem-monitor-www'
	option ping_targets '1.1.1.1 8.8.8.8'
	option ping_count '5'
	option retention_days '90'
	option us_power_min '35'
	option us_power_max '51'
	option ds_power_min '-7'
	option ds_power_max '7'
	option ds_snr_min '33'
	option modem_route 'host'
	option modem_alias_ip '192.168.100.10'
	option modem_eee '0'
	option modem_led '1'
