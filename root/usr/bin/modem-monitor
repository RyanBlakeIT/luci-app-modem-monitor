    "update_check": "1",  # check GitHub for a newer release once a day
    "update_repo": "RyanBlakeIT/luci-app-modem-monitor",
    "isp_name": "",      # shown in the report, e.g. "Comcast"; empty = "your ISP"
    "report_title": "",  # custom report title; empty = "Cable modem signal report"
    "report_note": "",   # one line under the title, e.g. account / complaint reference
