function count(lo){
 const t={T3:0,T4:0,DRW:0,uncorr:0,us_max:null,reboots:0,relocks:0,failed:0,loss_polls:0,polls:0,link_err:0,missed:0,missed_flag:false,link_drops:0};
 (D.evc||[]).forEach(e=>{if(e[0]>=lo&&(e[1]==="T3"||e[1]==="T4"||e[1]==="DRW"))t[e[1]]++});
 (D.samples||[]).forEach(r=>{if(r[0]<lo)return;t.polls++;t.failed+=r[1];t.reboots+=r[2];t.relocks+=r[3];t.uncorr+=r[4];if(r[5]!=null)t.us_max=t.us_max==null?r[5]:Math.max(t.us_max,r[5]);if((r[6]||0)>0)t.loss_polls++});
 (D.lk||[]).forEach(r=>{if(r[0]<lo)return;t.link_err+=r[1];t.missed+=r[2];t.link_drops+=r[3];if(r[2]>100)t.missed_flag=true});
 return t}
function tiles(rg){const t=count(Math.max(D.now-rg.span,SINCE||0)),u=T.us_power_max,li=D.link_info||{};
