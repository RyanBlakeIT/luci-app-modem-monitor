function speed(rg){const S=(D.speed||[]),card=$("#speedCard");if(!S.length){card.style.display="none";return}card.style.display="";
 /* one bar pair per test (daily tests are far apart on a time axis); at least the last 14 tests */
 const x0=Math.max(D.now-rg.span,SINCE||0),inR=S.filter(r=>r[0]>=x0),P=(inR.length>=14?inR:S.filter(r=>r[0]>=(SINCE||0)).slice(-14)).slice(-60);
 const pd=D.plan[0],pu=D.plan[1],pct=!!(pd&&pu),last=S[S.length-1],ok=P.filter(r=>r[1]!=null||r[2]!=null);
 const med=a=>{const v=a.filter(x=>x!=null).sort((x,y)=>x-y);return v.length?v[Math.floor(v.length/2)]:null};
 const f1=v=>v==null?"–":(v>=100?Math.round(v):v),pp=(v,pl)=>v==null||!pl?"":" ("+Math.round(v/pl*100)+"%)";
 const md=med(ok.map(r=>r[1])),mu=med(ok.map(r=>r[2])),li=med(ok.map(r=>r[3])),ll=med(ok.map(r=>r[4]));
 const sq=D.sqm||[],ed=pd&&sq[0]?Math.min(pd,sq[0]):pd,eu=pu&&sq[1]?Math.min(pu,sq[1]):pu;  /* the router's own shaper caps the tests */
 const low=pct?ok.filter(r=>(r[1]!=null&&r[1]<0.8*ed)||(r[2]!=null&&r[2]<0.8*eu)).length:0,fail=P.filter(r=>r[5]).length;
 const T=[["Latest",f1(last[1])+" / "+f1(last[2]),"Mb/s down / up · "+fmtFull(last[0]),!!last[5]],
  ["Median ("+P.length+" tests)",f1(md)+" / "+f1(mu),"Mb/s"+(pct?" · "+Math.round(md/pd*100)+"% / "+Math.round(mu/pu*100)+"% of plan":""),false],
  ["Latency idle → load",f1(li)+" → "+f1(ll),"ms (median) · "+(li!=null&&ll!=null?(ll-li>30?"bufferbloat":"no bufferbloat"):""),li!=null&&ll!=null&&ll-li>30],
  [pct?"Below 80% of plan":"Failed tests",pct?low+" of "+ok.length:String(fail),pct?((ed<pd||eu<pu)?"of SQM cap where lower":"tests")+(fail?" \u00b7 "+fail+" failed":""):"of "+P.length,pct?low>0:fail>0]];
 $("#speedNote").innerHTML="<div class=tiles style='margin:8px 0 6px'>"+T.map(i=>"<div class='tile"+(i[3]?" bad":"")+"'><div class=k>"+esc(i[0])+"</div><div class=v>"+esc(i[1])+"</div><div class=n>"+esc(i[2])+"</div></div>").join("")+"</div>"+
  "Measured from this router"+(sq[0]||sq[1]?"; the router\u2019s traffic shaping (SQM "+(sq[0]?Math.round(sq[0])+" down":"")+(sq[0]&&sq[1]?" / ":"")+(sq[1]?Math.round(sq[1])+" up":"")+" Mb/s) caps these results, so tests are judged against whichever is lower, the plan or the SQM limit.":"; traffic shaping on the router (SQM) caps these results.")+(pct?" Bars show each test as a percentage of your plan ("+pd+" down / "+pu+" up Mb/s), so download and upload share one scale.":(pd||pu?"":" Set your plan speeds under Settings → Speed tests to compare each test with what you pay for."))+(last[5]?" Latest error: "+esc(last[5]):"");
 if(!P.length){$("#speed").innerHTML="<div class=empty>No tests yet.</div>";return}
 const lab=r=>{const d=new Date(r[0]*1000);return (d.getMonth()+1)+"/"+d.getDate()};
 const tip=r=>esc(fmtFull(r[0]))+": "+(r[1]??"–")+" down"+pp(r[1],pd)+" / "+(r[2]??"–")+" up"+pp(r[2],pu)+" Mb/s; latency "+(r[3]??"–")+" ms idle, "+(r[4]??"–")+" ms loaded"+(r[5]?"; "+esc(r[5]):"");
 function bars(series,unit,refs,H){/* series: [[name,color,valueFn]] */
  const W=1000,L=50,Rr=56,Tp=8,B=22,n=P.length,vals=P.flatMap(r=>series.map(x=>x[2](r))).filter(v=>v!=null).concat(refs.map(x=>x[0]));
  const t=nice(0,Math.max(1,...vals),4),hi=t[t.length-1],Y=v=>Tp+(1-v/hi)*(H-Tp-B),slot=(W-L-Rr)/n,gapw=Math.min(8,slot*0.25),bw=Math.max(1.5,(slot-gapw)/series.length-1);
  let g="<svg viewBox='0 0 "+W+" "+H+"' role=img aria-label='Speed tests'><g class=axis>";
  t.forEach(v=>{g+="<line class=gl x1="+L+" x2="+(W-Rr)+" y1="+Y(v)+" y2="+Y(v)+" /><text x="+(L-6)+" y="+(Y(v)+4)+" text-anchor=end>"+v+"</text>"});
  const every=Math.max(1,Math.ceil(n/12));P.forEach((r,i)=>{if(i%every===0||i===n-1)g+="<text x="+(L+slot*i+slot/2).toFixed(1)+" y="+(H-5)+" text-anchor=middle>"+lab(r)+"</text>"});g+="</g>";
  /* reference lines; their labels sit in the right margin, nudged apart so close lines stay readable */
  const lbl=refs.map(x=>({y:Y(x[0]),t:x[1]})).sort((p,q)=>p.y-q.y);for(let i=1;i<lbl.length;i++)if(lbl[i].y-lbl[i-1].y<13)lbl[i].y=lbl[i-1].y+13;
  refs.forEach(x=>{g+="<line x1="+L+" x2="+(W-Rr)+" y1="+Y(x[0])+" y2="+Y(x[0])+" stroke='var(--text-secondary)' stroke-opacity=.7 stroke-dasharray='"+x[2]+"'/>"});
  lbl.forEach(l=>{g+="<text x="+(W-Rr+6)+" y="+(l.y+4).toFixed(1)+" text-anchor=start font-size=11 fill='var(--text-secondary)'>"+l.t+"</text>"});
  P.forEach((r,i)=>{series.forEach((x,k)=>{const v=x[2](r),X=L+slot*i+gapw/2+k*(bw+1);
   if(v==null){g+="<text x="+(X+bw/2).toFixed(1)+" y="+(Y(0)-3)+" text-anchor=middle font-size=10 fill='var(--critical)'>×<title>"+tip(r)+"</title></text>";return}
   const y=Y(v);g+="<rect x="+X.toFixed(1)+" y="+y.toFixed(1)+" width="+bw.toFixed(1)+" height="+Math.max(0,Y(0)-y).toFixed(1)+" rx=2 fill='"+x[1]+"'><title>"+tip(r)+"</title></rect>"})});
  return g+"</svg>"}
 const leg=n=>"<div class=legend>"+n.map(x=>"<span><i style='background:"+x[1]+"'></i>"+x[0]+"</span>").join("")+"</div>";
 if(pct){const S2=[["Download % of plan","var(--s1)",r=>r[1]==null?null:Math.round(r[1]/pd*1000)/10],["Upload % of plan","var(--s2)",r=>r[2]==null?null:Math.round(r[2]/pu*1000)/10]];
  const R2=[[100,"plan","5 4"],[80,"80%","2 4"]];
