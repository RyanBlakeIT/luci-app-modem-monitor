 $("#days").innerHTML=rows.length?"<tr><th>Day</th><th class=num>T3</th><th class=num>T4</th><th class=num>Sync loss</th><th class=num>DHCP/provisioning fail</th><th class=num>Power range (DRW)</th><th class=num>Uncorrectables</th><th class=num>Peak US power</th><th class=num>Reboots</th><th class=num>Re-reg.</th><th class=num>Unreachable</th><th class=num>Loss samples</th><th class=num>Link errors</th><th class=num>Link drops</th><th class=num>NIC missed</th><th class=num>Samples</th></tr>"+
 rows.map(d=>{const bad=d.T3||d.T4||d.PROVISION||d.link_err||d.link_drops||d.reboots||d.relocks||d.failed||(d.us_max!=null&&d.us_max>T.us_power_max);return"<tr><td"+(bad?" class=flag":"")+">"+(bad?"\u25B2 ":"")+d.day+"</td><td class=num>"+d.T3+"</td><td class=num>"+d.T4+"</td><td class=num>"+d.SYNC+"</td><td class=num>"+d.PROVISION+"</td><td class=num>"+d.DRW+"</td><td class=num>"+d.uncorr.toLocaleString()+"</td><td class=num>"+n(d.us_max)+"</td><td class=num>"+d.reboots+"</td><td class=num>"+d.relocks+"</td><td class=num>"+d.failed+"</td><td class=num>"+d.loss+"</td><td class=num>"+d.link_err+"</td><td class=num>"+d.link_drops+"</td><td class=num>"+d.missed.toLocaleString()+"</td><td class=num>"+d.polls+"</td></tr>"}).join(""):"<tr><td class=empty>No samples in this period yet.</td></tr>";
 const inc=D.incidents.filter(i=>i.ts>=lo),ev=D.events.filter(e=>e.ts>=lo);
 $("#inc").innerHTML=inc.length?"<tr><th>Start</th><th>End</th><th class=num>About (min)</th><th>What happened</th></tr>"+inc.map(i=>"<tr><td>"+i.start+"</td><td>"+i.end+"</td><td class=num>"+(i.mins||"\u2013")+"</td><td>"+esc(i.why)+"</td></tr>").join(""):"<tr><td class=empty>No incidents recorded"+(lo?" since the selected entry":"")+".</td></tr>";
 $("#ev").innerHTML=ev.length?"<tr><th>Time</th><th>Type</th><th>Message</th></tr>"+ev.map(e=>"<tr><td>"+e.time+"</td><td"+((e.type==="T3"||e.type==="T4"||e.type==="PROVISION")?" class=flag":"")+">"+esc(e.type)+"</td><td>"+esc(e.msg)+"</td></tr>").join(""):"<tr><td class=empty>No event log entries"+(lo?" since the selected entry":" collected yet")+".</td></tr>";
 const TR=(D.traces||[]).filter(t=>t.ts>=lo).reverse();$("#traceCard").style.display=TR.length?"":"none";
 $("#traces").innerHTML=TR.map(t=>{const S=t.start,sum=esc(t.time)+" \u00b7 "+esc(t.why)+(S?" \u00b7 <b>loss starts at hop "+S.hop+" ("+esc(S.host)+")</b>":t.hops?" \u00b7 no loss reached the destination":"");
  const body=t.hops?"<div class=scroll><table><tr><th class=num>Hop</th><th>Host</th><th class=num>Loss</th><th class=num>Sent</th><th class=num>Avg ms</th><th class=num>Best</th><th class=num>Worst</th></tr>"+t.hops.map(h=>"<tr"+(S&&h.hop>=S.hop?" style='color:var(--critical)'":"")+"><td class=num>"+h.hop+"</td><td>"+esc(h.host)+"</td><td class=num>"+h.loss+"%</td><td class=num>"+h.sent+"</td><td class=num>"+(h.avg??"\u2013")+"</td><td class=num>"+(h.best??"\u2013")+"</td><td class=num>"+(h.worst??"\u2013")+"</td></tr>").join("")+"</table></div>":"<pre style='font-size:12px;overflow:auto'>"+esc(t.out)+"</pre>";
  return "<details><summary>"+sum+"</summary>"+body+"</details>"}).join("");
 $("#maint").querySelectorAll("tr[data-s]").forEach(r=>r.classList.toggle("sel",r.dataset.s===SID))}
const ba=w=>{if(!w)return"<span class=ba>\u2013</span>";const r=a=>a&&a[0]!=null?a[0]+".."+a[1]:"?";return"<span class=ba>DS "+r(w.ds)+" \u00b7 US "+r(w.us)+" dBmV<br>"+(w.uncorr_day==null?"\u2013":w.uncorr_day.toLocaleString())+" uncorr/day \u00b7 "+w.t3t4+" T3/T4 \u00b7 "+w.drw+" DRW"+(w.hours<23?" ("+w.hours+" h)":"")+"</span>"};
$("#maint").innerHTML=(D.maint||[]).length?"<tr><th>#</th><th>When</th><th>Type</th><th>What happened</th><th>24 h before</th><th>24 h after</th></tr>"+D.maint.slice().reverse().map(m=>"<tr data-s='"+esc(m.id)+"'><td class=num>"+m.n+"</td><td>"+m.time+(m.end_time?" to "+(m.end_time.slice(0,10)===m.time.slice(0,10)?m.end_time.slice(11):m.end_time):"")+"</td><td>"+esc(m.type)+(m.status==="suggested"?" <span class=badge>suggested</span>":"")+"</td><td>"+esc(m.note)+" <a class=sl data-s='"+esc(m.id)+"'>show data after this</a></td><td>"+ba(m.before)+"</td><td>"+ba(m.after)+"</td></tr>").join(""):"<tr><td class=empty>No maintenance entries yet.</td></tr>";
$("#maint").addEventListener("click",e=>{const a=e.target.closest("a.sl");if(a){setSince(a.dataset.s);window.scrollTo({top:0,behavior:"smooth"})}});
tables();
$("#files").innerHTML=D.files.length?"<ul>"+D.files.map(f=>"<li><a href='data/"+encodeURIComponent(f.name)+"' download>"+esc(f.name)+"</a> <span class=sub>("+f.kb+" KB)</span></li>").join("")+"</ul>":"<div class=empty>No data files yet.</div>";
</script></body></html>
"""


# --------------------------------------------------------------------------
# Per-channel downstream errors: heatmap and ingress detection
# --------------------------------------------------------------------------

INGRESS_MIN = 1000     # uncorrectables in a day before its pattern is judged
INGRESS_SHARE = 0.6    # share on 3 adjacent channels that counts as "concentrated"


def _is_ofdm(mod):
    m = (mod or "").lower()
    return "ofdm" in m or m == "other"  # SB8200 labels its OFDM channel "Other"


def _bstart(t, size, _c={}):
    """Start of the local-time bucket (size seconds; >= 1 day means local midnight)."""
    k = (t, size)
    if k in _c:
        return _c[k]
    lt = time.localtime(t)
    if size >= 86400:
        b = int(time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1)))
    else:
        secs = lt.tm_hour * 3600 + lt.tm_min * 60 + lt.tm_sec
        b = t - secs % size
    if len(_c) > 20000:
        _c.clear()
    _c[k] = b
    return b


def channel_uncorr(cfg, specs, hi=None, skip=None):
    """Uncorrectable codewords per downstream channel, summed into time buckets.
    specs: {name: (lo, bucket_s)}. Returns ({name: {ch: {bucket_ts: n}}}, info)
    where info = {ch: {"freq": MHz, "ofdm": bool}} (latest values seen)."""
    lo_all = min(s[0] for s in specs.values())
    out = {n: {} for n in specs}
    info, prev = {}, {}
    for p in files_since(cfg, "channels", lo_all - 86400):
        try:
            f = _topen(p)
        except OSError:
            continue
        with f:
            for r in csv.DictReader(f):
                if r.get("dir") != "down":
                    continue
                try:
                    t = int(r["ts"])
                    u = int(float(r.get("uncorr") or 0))
                except (ValueError, KeyError, TypeError):
                    continue
                ch = r.get("ch", "")
                fr = num(r.get("freq_mhz"))
                if fr:
                    info[ch] = {"freq": fr, "ofdm": _is_ofdm(r.get("mod"))}
                pu = prev.get(ch)
                prev[ch] = u
                if pu is None or (hi is not None and t >= hi) or (skip and skip(t)):
                    continue
                d = u - pu if u >= pu else u  # counters reset on reboot / re-registration
                if d <= 0:
                    continue
                for n, (lo, size) in specs.items():
                    if t >= lo:
                        b = _bstart(t, size)
                        m = out[n].setdefault(ch, {})
                        m[b] = m.get(b, 0) + d
    return out, info


def concentration(vals, info):
    """vals: {ch: uncorrectables}. Finds the 3 frequency-adjacent SC-QAM channels
    with the most errors. Returns None, or {share, chs, fmin, fmax, total, ofdm}."""
    sc = sorted((c for c in info if not info[c]["ofdm"]), key=lambda c: info[c]["freq"])
    tot = sum(vals.get(c, 0) for c in sc)
    if len(sc) < 6 or tot <= 0:
        return None
    best, bi = -1, 0
    for i in range(len(sc) - 2):
        s = sum(vals.get(c, 0) for c in sc[i:i + 3])
        if s > best:
            best, bi = s, i
    chs = sc[bi:bi + 3]
    return {"share": best / float(tot), "chs": chs, "fmin": info[chs[0]]["freq"], "fmax": info[chs[-1]]["freq"],
            "total": tot, "ofdm": sum(vals.get(c, 0) for c in info if info[c]["ofdm"]), "n_sc": len(sc)}


def ingress_findings(daily, info, min_total=INGRESS_MIN):
    """daily: {ch: {day_ts: n}}. One finding per day with enough errors:
    'narrow' = concentrated on a few adjacent channels (typical of RF ingress),
    'wide' = spread across the band (wideband noise, low signal, or a CMTS/node issue)."""
    days = sorted({d for m in daily.values() for d in m})
    res = []
    for d in days:
        c = concentration({ch: m.get(d, 0) for ch, m in daily.items()}, info)
        if not c or c["total"] < min_total:
            continue
        res.append({"day": time.strftime("%Y-%m-%d", time.localtime(d)), "ts": d,
                    "kind": "narrow" if c["share"] >= INGRESS_SHARE else "wide",
                    "share": round(c["share"] * 100), "chs": c["chs"], "fmin": c["fmin"], "fmax": c["fmax"],
                    "total": c["total"], "ofdm": c["ofdm"]})
    return res


def heat_matrix(m, info, lo, size, now):
    """{ch: {bucket: n}} -> compact matrix for the page, rows sorted by frequency."""
    cols = []
    b = _bstart(lo, size)
    while b <= now:
        if b + size > lo:
            cols.append(b)
        nb = _bstart(b + size + 3600, size) if size >= 86400 else b + size
        b = nb if nb > b else b + size
    idx = {c: i for i, c in enumerate(cols)}
    rows = sorted(info, key=lambda c: (info[c]["ofdm"], info[c]["freq"]))
    v = []
    for ch in rows:
        line = [0] * len(cols)
        for bt, n in m.get(ch, {}).items():
            i = idx.get(bt)
            if i is not None:
                line[i] += n
        v.append(line)
    return {"cols": cols, "size": size,
            "rows": [{"ch": c, "freq": info[c]["freq"], "ofdm": info[c]["ofdm"]} for c in rows], "v": v}


# --------------------------------------------------------------------------
# Alerts (ntfy, Pushover, Telegram, webhook, email)
# --------------------------------------------------------------------------

ALERT_KINDS = ["outage", "reboot", "relock", "t3t4", "uncorr", "us_power", "loss", "channels", "dropouts"]


def _http_post(url, body, headers=None, timeout=15):
    """POST with certificate verification; falls back to curl if Python's SSL
    can't be used. Returns the HTTP status (raises on failure)."""
    cafile = next((c for c in CA_FILES if os.path.exists(c)), None)
    h = {"User-Agent": "luci-app-modem-monitor/" + VERSION}
    h.update(headers or {})
    data = body if isinstance(body, bytes) else body.encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=h, method="POST")
    try:
        ctx = ssl.create_default_context(cafile=cafile) if url.startswith("https:") else None
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            return r.status
    except urllib.error.HTTPError as e:
        raise ModemError("HTTP %d from %s" % (e.code, url.split("?")[0]))
    except (ssl.SSLError, urllib.error.URLError, OSError) as e:
        if not shutil.which("curl"):
            raise ModemError(str(getattr(e, "reason", e)))
        cmd = ["curl", "-sS", "-f", "-m", str(timeout), "-o", "/dev/null", "-w", "%{http_code}", "--data-binary", "@-"]
        for k, v in h.items():
            cmd += ["-H", "%s: %s" % (k, v)]
        out = subprocess.run(cmd + [url], input=data, capture_output=True, timeout=timeout + 5)
        if out.returncode != 0:
            raise ModemError((out.stderr or b"curl failed").decode("utf-8", "replace").strip()[:200])
        return int(out.stdout or 0)


def _hdr(s):
    """HTTP header values must be latin-1; ntfy accepts RFC 2047 for the rest."""
    try:
        s.encode("latin-1")
        return s
    except UnicodeEncodeError:
        import base64
        return "=?UTF-8?B?%s?=" % base64.b64encode(s.encode("utf-8")).decode()


def ntfy_url(v):
    v = (v or "").strip()
    if v and "://" not in v:
        v = "https://ntfy.sh/" + v.lstrip("/")  # just a topic name
    return v


def alert_targets(cfg):
    g = lambda k: (cfg.get(k) or "").strip()
    t = []
    if g("alert_ntfy_url"):
        t.append("ntfy")
    if g("alert_pushover_user") and g("alert_pushover_token"):
        t.append("pushover")
    if g("alert_telegram_token") and g("alert_telegram_chat"):
        t.append("telegram")
    if g("alert_webhook_url"):
        t.append("webhook")
    if g("alert_email_to"):
        t.append("email")
    return t


def send_alert(cfg, title, msg, prio=3, kind="info"):
    """Send to every configured channel. Returns [(channel, ok, detail)]."""
    g = lambda k: (cfg.get(k) or "").strip()
    host = _read("/proc/sys/kernel/hostname") or "router"
    res = []
    for ch in alert_targets(cfg):
        try:
            if ch == "ntfy":
                # tags that match ntfy emoji short names show as icons
                tag = "white_check_mark" if "back online" in title.lower() else "warning" if prio >= 4 else "satellite"
                h = {"Title": _hdr(title), "Priority": str(prio), "Tags": tag}
                if g("alert_ntfy_token"):
                    h["Authorization"] = "Bearer " + g("alert_ntfy_token")
                _http_post(ntfy_url(g("alert_ntfy_url")), msg, h)
            elif ch == "pushover":
                import urllib.parse
                body = urllib.parse.urlencode({"token": g("alert_pushover_token"), "user": g("alert_pushover_user"),
                                               "title": title, "message": msg,
                                               "priority": 1 if prio >= 5 else 0})
                _http_post("https://api.pushover.net/1/messages.json", body,
                           {"Content-Type": "application/x-www-form-urlencoded"})
            elif ch == "telegram":
                body = json.dumps({"chat_id": g("alert_telegram_chat"), "text": "%s\n%s" % (title, msg),
                                   "disable_web_page_preview": True})
                _http_post("https://api.telegram.org/bot%s/sendMessage" % g("alert_telegram_token"), body,
                           {"Content-Type": "application/json"})
            elif ch == "webhook":
                body = json.dumps({"title": title, "message": msg, "kind": kind, "priority": prio,
                                   "ts": int(time.time()), "host": host, "source": "modem-monitor"})
                _http_post(g("alert_webhook_url"), body, {"Content-Type": "application/json"})
            elif ch == "email":
                sm = shutil.which("sendmail") or ("/usr/sbin/sendmail" if os.path.exists("/usr/sbin/sendmail") else None)
                if not sm:
                    raise ModemError("no sendmail found (install msmtp and set it up)")
                frm = g("alert_email_from") or "modem-monitor@%s" % host
                m = "From: %s\nTo: %s\nSubject: %s\nContent-Type: text/plain; charset=utf-8\n\n%s\n" % (
                    frm, g("alert_email_to"), title, msg)
                out = subprocess.run([sm, "-t"], input=m.encode("utf-8"), capture_output=True, timeout=30)
                if out.returncode != 0:
                    raise ModemError((out.stderr or b"sendmail failed").decode("utf-8", "replace").strip()[:200])
            res.append((ch, True, "sent"))
        except Exception as e:  # one bad channel must not stop the others
            res.append((ch, False, str(e)[:200]))
    return res


def alert_check(cfg, st, row, events_new, chd, info, now):
    """Decide what to alert on after a poll; queue, then try to send the queue.
    Alerts raised while the line is down are delivered once it is back."""
    if cfg.get("alert_enabled", "0") != "1" or not alert_targets(cfg):
        return
    on = set((cfg.get("alert_on") or " ".join(ALERT_KINDS)).split())
    A = st.setdefault("alerts", {})
    last = A.setdefault("last", {})
    queue = A.setdefault("queue", [])
    cool = max(0, int(fnum(cfg, "alert_cooldown_min"))) * 60
    hm = lambda t: time.strftime("%H:%M", time.localtime(t))
    isp = (cfg.get("isp_name") or "").strip()
    found = []  # (kind, title, message, priority, bypass_cooldown)

    if row.get("ok") != 1:
        A["down_since"] = A.get("down_since") or int(now)
        A["down_polls"] = A.get("down_polls", 0) + 1
        if A["down_polls"] == max(1, int(fnum(cfg, "alert_outage_polls"))) and "outage" in on:
            found.append(("outage", "Cable modem unreachable",
                          "No answer from the modem since %s (%s). Internet is probably down%s." %
                          (hm(A["down_since"]), row.get("error") or "?", " (%s)" % isp if isp else ""), 5, False))
            A["down_alerted"] = True
    else:
        if A.get("down_alerted"):
            mins = round((now - A.get("down_since", now)) / 60)
            found.append(("outage", "Cable modem back online",
                          "The modem is answering again after about %d minutes (unreachable from %s)." %
                          (mins, hm(A.get("down_since", now))), 3, True))
        A["down_since"], A["down_polls"], A["down_alerted"] = None, 0, False

        if row.get("rebooted") == 1 and "reboot" in on:
            mine = [r for r in load_maint(cfg) if r["type"] == "modem-reboot" and r["source"] == "router"
                    and now - int(r["ts"]) < 1800]
            if not mine:
                found.append(("reboot", "Cable modem rebooted",
                              "The modem's uptime reset (it rebooted on its own or was rebooted remotely). "
                              "Downstream %s..%s dBmV, upstream %s..%s dBmV." %
                              (row.get("ds_power_min"), row.get("ds_power_max"),
                               row.get("us_power_min"), row.get("us_power_max")), 4, False))
        if row.get("relock") == 1 and row.get("rebooted") != 1 and "relock" in on:
            found.append(("relock", "Cable modem re-registered",
                          "The modem lost signal and re-registered without rebooting.", 4, False))

        hits = A.setdefault("t34", [])
        hits += [int(e["ts"]) for e in events_new if e["type"] in ("T3", "T4")]
        hits[:] = [t for t in hits if t > now - 3600][-200:]
        new34 = [e for e in events_new if e["type"] in ("T3", "T4")]
        if new34 and len(hits) >= max(1, int(fnum(cfg, "alert_t3t4_count"))) and "t3t4" in on:
            n3 = sum(1 for e in new34 if e["type"] == "T3")
            found.append(("t3t4", "Upstream timeouts (T3/T4)",
                          "%d T3/T4 timeouts in the last hour (%d T3, %d T4 just now). Latest: %s" %
                          (len(hits), n3, len(new34) - n3, new34[-1]["message"][:160]),
                          5 if len(new34) > n3 else 4, False))

        unc = row.get("uncorr_delta") or 0
        if row.get("rebooted") != 1 and unc >= fnum(cfg, "alert_uncorr") and "uncorr" in on:
            c = concentration(chd, info) if chd else None
            where = ""
            if c and c["share"] >= INGRESS_SHARE:
                where = (" %d%% of them on channels %s (%g-%g MHz): a pattern typical of RF ingress (outside "
                         "interference leaking into the cable)." % (round(c["share"] * 100), ", ".join(c["chs"]),
                                                                     c["fmin"], c["fmax"]))
            elif c:
                where = " Spread across the band (wideband noise or weak signal)."
            found.append(("uncorr", "Downstream errors spiking",
                          "%s uncorrectable codewords in the last sample.%s" % ("{:,}".format(int(unc)), where), 4, False))

        lost = row.get("_lost_ch")
        if lost and "channels" in on:
            found.append(("channels", "Modem lost channels",
                          "Only part of the bonded channels are locked: %s missing (compared with the last 24 h). "
                          "Speeds drop and the connection is less stable until they come back." % " and ".join(lost), 4, False))
        elif A.get("ch_alerted") and not lost and "channels" in on:
            found.append(("channels", "Modem channels back", "All bonded channels are locked again.", 2, True))
        A["ch_alerted"] = bool(lost) and "channels" in on

        usm = row.get("us_power_max")
        if usm not in ("", None) and usm > fnum(cfg, "us_power_max") and "us_power" in on:
            found.append(("us_power", "Upstream power too high",
                          "Upstream transmit power is %s dBmV (limit %g). The modem is straining to reach the "
                          "node; T3 timeouts usually follow." % (usm, fnum(cfg, "us_power_max")), 4, False))

    drops = row.get("hr_drops") or 0
    if drops >= max(1, fnum(cfg, "alert_dropouts")) and "dropouts" in on:
        found.append(("dropouts", "Short connection dropouts",
                      "%d short dropouts in the last %d minutes (longest %d s, %s%% of 1-second pings lost)." %
                      (drops, round(int(fnum(cfg, "interval")) / 60), row.get("hr_longest") or 0, row.get("hr_loss")), 4, False))

    loss = row.get("ping_loss")
    if loss not in ("", None) and loss >= fnum(cfg, "alert_loss") and row.get("ok") == 1 and "loss" in on:
        found.append(("loss", "Packet loss", "%g%% packet loss to %s." % (loss, cfg.get("ping_targets", "")), 3, False))

    for kind, title, msg, prio, bypass in found:
        if not bypass and now - last.get(kind, 0) < cool:
            continue
        last[kind] = int(now)
        queue.append({"ts": int(now), "kind": kind, "title": title, "prio": prio,
                      "msg": "%s %s" % (time.strftime("%b %d %H:%M", time.localtime(now)), msg)})
        log("alert: %s: %s" % (title, msg))
        if (cfg.get("mqtt_host") or "").strip():
            mqtt_publish(cfg, (cfg.get("mqtt_topic") or "modem_monitor").strip("/") + "/alert",
                         json.dumps({"kind": kind, "title": title, "message": msg, "priority": prio, "ts": int(now)}))

    queue[:] = [q for q in queue if now - q["ts"] < 86400][-30:]
    if not queue or row.get("ok") != 1 or (loss not in ("", None) and loss >= 100):
        return  # no way out right now; keep them for later
    keep = []
    for q in queue:
        res = send_alert(cfg, q["title"], q["msg"] if now - q["ts"] < 600 else q["msg"] + " (delayed: sent once the line was back)",
                         q["prio"], q["kind"])
        if not any(ok for _, ok, _ in res):
            keep.append(q)
            log("alert not sent yet: %s" % "; ".join("%s: %s" % (c, d) for c, ok, d in res if not ok))
    queue[:] = keep


def alert_test(cfg):
    if not alert_targets(cfg):
        return [("none", False, "no alert channel configured (set an ntfy topic, Pushover, Telegram, webhook or email)")]
    return send_alert(cfg, "Test alert from the cable modem monitor",
                      "If you can read this, alerts work. Sent %s from %s." %
                      (time.strftime("%Y-%m-%d %H:%M"), _read("/proc/sys/kernel/hostname") or "the router"), 3, "test")


# --------------------------------------------------------------------------
# Network path: ISP gateway (first hop) ping and traceroute during loss
# --------------------------------------------------------------------------

TRACE_EVERY_S = 900  # at most one traceroute per 15 minutes


def isp_gateway(cfg):
    """The WAN default gateway: the ISP's router at the other end of the cable
    segment. Loss to it points at the local cable plant rather than the internet."""
    t = (cfg.get("gw_target") or "").strip()
    if t:
        return t
    try:
        j = json.loads(subprocess.run(["ifstatus", "wan"], capture_output=True, text=True, timeout=10).stdout)
        for r in j.get("route", []):
            if r.get("target") == "0.0.0.0" and r.get("nexthop") not in (None, "0.0.0.0"):
                return r["nexthop"]
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    try:
        out = subprocess.run(["ip", "-4", "route", "show", "default"], capture_output=True, text=True, timeout=10).stdout
        m = re.search(r"via (\d+\.\d+\.\d+\.\d+)", out)
        return m.group(1) if m else None
    except (OSError, subprocess.SubprocessError):
        return None


def trace_file(cfg, ts):
    return os.path.join(cfg["data_dir"], "traces-%s.log" % time.strftime("%Y-%m", time.localtime(ts)))


def trace_status():
    """Which tool path traces will use."""
    mtr, tr = shutil.which("mtr"), shutil.which("traceroute")
    pkg = ""
    if mtr:
        for name in ("mtr-json", "mtr-nojson", "mtr"):
            try:
                if subprocess.run(["apk", "info", "-e", name], capture_output=True, timeout=10).returncode == 0:
                    pkg = name
                    break
            except (OSError, subprocess.SubprocessError):
                break
    return {"mtr": mtr, "mtr_pkg": pkg, "traceroute": tr, "using": "mtr" if mtr else ("traceroute" if tr else None)}


def trace_cmd(cfg):
    """(command, label, target) for a path trace, or None if no tool is available."""
    target = (cfg.get("ping_targets") or "1.1.1.1").split()[0]
    if not re.match(r"^[\w.:-]+$", target):
        return None
    mtr, tr = shutil.which("mtr"), shutil.which("traceroute")
    rounds = max(3, min(60, int(fnum(cfg, "trace_rounds"))))
    if mtr:
        # JSON where the build supports it (mtr-json), else the text report (mtr-nojson)
        return (["/bin/sh", "-c", '"$0" -n -j -c "$1" "$2" 2>/dev/null || "$0" -n -r -w -c "$1" "$2"',
                 mtr, str(rounds), target], "mtr (%d rounds)" % rounds, target)
    if tr:
        return [tr, "-n", "-q", "2", "-w", "2", "-m", "20", target], "traceroute", target
    return None


def _trace_head(now, why, label, target):
    return "### %d %s | %s | %s to %s" % (int(now), time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now)), why,
                                          label, target)


def start_trace(cfg, st, now, why):
    """Trace the path during packet loss, in the background so the sample
    isn't delayed, appending to the monthly traces log. Uses MTR (per-hop loss
    and latency over several rounds) when the mtr package is installed,
    otherwise traceroute."""
    if cfg.get("trace_on_loss", "1") != "1" or now - st.get("last_trace", 0) < TRACE_EVERY_S:
        return
    tc = trace_cmd(cfg)
    if not tc:
        return
    cmd, label, target = tc
    st["last_trace"] = int(now)
    path = trace_file(cfg, now)
    try:
        with open(path, "a") as f:
            f.write(_trace_head(now, why, label, target) + "\n")
        os.chmod(path, 0o644)
        out = open(path, "a")
        subprocess.Popen(cmd, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
        out.close()
    except OSError as e:
        log("path trace failed: %s" % e)


def trace_now(cfg):
    """Run a path trace now and wait for it (for the Settings button and CLI).
    It is saved with the others, marked as started by hand."""
    tc = trace_cmd(cfg)
    if not tc:
        raise ModemError("neither mtr nor traceroute is installed")
    cmd, label, target = tc
    now = time.time()
    rounds = max(3, min(60, int(fnum(cfg, "trace_rounds"))))
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=rounds * 2 + 40, stdin=subprocess.DEVNULL)
        body = (out.stdout or "") + (out.stderr or "")
    except subprocess.TimeoutExpired:
        raise ModemError("the trace took too long")
    os.makedirs(cfg["data_dir"], exist_ok=True)
    path = trace_file(cfg, now)
    with open(path, "a") as f:
        f.write(_trace_head(now, "started by hand", label, target) + "\n" + body.rstrip() + "\n")
    os.chmod(path, 0o644)
    hops = parse_hops(body)
    return {"ts": int(now), "what": "%s to %s" % (label, target), "hops": hops, "start": loss_start(hops),
            "out": body.strip()[:4000]}


def parse_hops(body):
    """Per-hop results from MTR output (JSON or text report). Returns a list
    of {hop, host, loss, sent, avg, best, worst} or None for plain traceroute."""
    body = body.strip()
    hops = []
    if body.startswith("{"):
        try:
            for h in json.loads(body).get("report", {}).get("hubs", []):
                hops.append({"hop": int(h.get("count", 0)), "host": h.get("host", "???"), "loss": float(h.get("Loss%", 0)),
                             "sent": int(h.get("Snt", 0)), "avg": h.get("Avg"), "best": h.get("Best"), "worst": h.get("Wrst")})
        except (ValueError, AttributeError):
            return None
        return hops or None
    for line in body.splitlines():
        m = re.match(r"\s*(\d+)\.\|--\s+(\S+)\s+([\d.]+)%?\s+(\d+)\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)", line)
        if m:
            hops.append({"hop": int(m.group(1)), "host": m.group(2), "loss": float(m.group(3)), "sent": int(m.group(4)),
                         "avg": float(m.group(6)), "best": float(m.group(7)), "worst": float(m.group(8))})
    return hops or None


def loss_start(hops):
    """Where the loss really begins: the first hop whose loss carries through to
    the destination. Loss at a middle hop only (with clean hops after it) is
    usually a router deprioritizing pings to itself, not real loss."""
    if not hops or hops[-1]["loss"] <= 0:
        return None
    i = len(hops) - 1
    while i > 0 and hops[i - 1]["loss"] > 0:  # silent "???" hops count as passing it on
        i -= 1
    while i < len(hops) - 1 and hops[i]["host"] == "???":
        i += 1  # name the first hop that actually answered
    h = hops[i]
    return {"hop": h["hop"], "host": h["host"], "loss": h["loss"], "end_loss": hops[-1]["loss"]}


def trace_starts(cfg, lo, hi):
    """How often loss began at each hop, over MTR traces in a period."""
    c = {}
    for t in read_traces(cfg, lo, 1000):
        if t["ts"] < hi and t["start"]:
            k = "%d|%s" % (t["start"]["hop"], t["start"]["host"])
            c[k] = c.get(k, 0) + 1
    return [{"hop": int(k.split("|")[0]), "host": k.split("|", 1)[1], "n": n}
            for k, n in sorted(c.items(), key=lambda x: (-x[1], int(x[0].split("|")[0])))]


def read_traces(cfg, since, limit=30):
    res = []
    for p in sorted(glob.glob(os.path.join(cfg["data_dir"], "traces-*.log*"))):
        try:
            with _topen(p) as f:
                text = f.read()
        except OSError:
            continue
        for block in text.split("### ")[1:]:
            head, _, body = block.partition("\n")
            m = re.match(r"(\d+) (\S+ \S+) \| (.*?) \| (.*)$", head)
            if m and int(m.group(1)) >= since:
                hops = parse_hops(body)
                res.append({"ts": int(m.group(1)), "time": m.group(2), "why": m.group(3), "what": m.group(4),
                            "out": body.strip()[:3000], "hops": hops, "start": loss_start(hops)})
    return res[-limit:]


# --------------------------------------------------------------------------
# Weather (Open-Meteo, free, no key): outdoor temperature and precipitation
# --------------------------------------------------------------------------

def weather_now(cfg, st, now, force=False):
    """Current temperature/precipitation for the configured location, fetched at
    most every 30 minutes. Returns (temp, precip) or (None, None)."""
    lat, lon = (cfg.get("weather_lat") or "").strip(), (cfg.get("weather_lon") or "").strip()
    if not lat or not lon:
        return None, None
    unit = "fahrenheit" if (cfg.get("weather_unit") or "C").upper().startswith("F") else "celsius"
    w = st.get("weather") or {}
    key = "%s,%s,%s" % (lat, lon, unit)
    if not force and w.get("key") == key and now - w.get("ts", 0) < 1800:
        return w.get("temp"), w.get("precip")
    if not force and w.get("key") == key and now - w.get("fail", 0) < 600:
        return w.get("temp") if now - w.get("ts", 0) < 3 * 3600 else None, None
    try:
        url = ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current=temperature_2m,precipitation"
               "&temperature_unit=%s&precipitation_unit=%s&timezone=auto" %
               (float(lat), float(lon), unit, "inch" if unit == "fahrenheit" else "mm"))
        cur = json.loads(_https_get(url, timeout=10, accept="application/json")).get("current", {})
        if cur.get("temperature_2m") is None:
            raise ModemError("Open-Meteo returned no current temperature for %s, %s" % (lat, lon))
        w = {"key": key, "ts": int(now), "temp": cur.get("temperature_2m"), "precip": cur.get("precipitation"),
             "obs": cur.get("time", "")}
    except Exception as e:
        log("weather fetch failed: %s" % e)
        w["fail"], w["key"], w["error"] = int(now), key, str(getattr(e, "reason", e))[:200]
        st["weather"] = w
        return (w.get("temp") if now - w.get("ts", 0) < 3 * 3600 else None), None
    st["weather"] = w
    return w["temp"], w["precip"]


def pearson(pairs):
    pairs = [(a, b) for a, b in pairs if a is not None and b is not None]
    n = len(pairs)
    if n < 24:
        return None, n
    ma = sum(a for a, _ in pairs) / n
    mb = sum(b for _, b in pairs) / n
    sa = sum((a - ma) ** 2 for a, _ in pairs) ** 0.5
    sb = sum((b - mb) ** 2 for _, b in pairs) ** 0.5
    if sa == 0 or sb == 0:
        return None, n
    return round(sum((a - ma) * (b - mb) for a, b in pairs) / (sa * sb), 2), n


def weather_effects(summ):
    """Hourly correlation of outdoor temperature with upstream/downstream power and
    errors, and errors during rain vs. dry hours."""
    hrs = {}
    for r in summ:
        h = int(r["ts"]) // 3600
        x = hrs.setdefault(h, {"t": [], "us": [], "ds": [], "unc": 0, "p": 0.0, "ok": 0})
        t, us, ds, p = fv(r, "temp"), fv(r, "us_power_avg"), fv(r, "ds_power_avg"), fv(r, "precip")
        if t is not None:
            x["t"].append(t)
        if r.get("ok") == "1":
            x["ok"] += 1
            x["unc"] += int(fv(r, "uncorr_delta") or 0)
            if us is not None:
                x["us"].append(us)
            if ds is not None:
                x["ds"].append(ds)
        if p:
            x["p"] = max(x["p"], p)
    avg = lambda v: sum(v) / len(v) if v else None
    H = [x for x in hrs.values() if x["t"] and x["ok"]]
    if len(H) < 24:
        return None
    r_us, n = pearson([(avg(x["t"]), avg(x["us"])) for x in H])
    r_ds, _ = pearson([(avg(x["t"]), avg(x["ds"])) for x in H])
    r_unc, _ = pearson([(avg(x["t"]), x["unc"]) for x in H])
    wet = [x for x in H if x["p"] > 0]
    dry = [x for x in H if x["p"] == 0]
    rate = lambda xs: round(sum(x["unc"] for x in xs) / float(len(xs))) if xs else None
    ts = [v for x in H for v in x["t"]]
    return {"hours": len(H), "r_us": r_us, "r_ds": r_ds, "r_unc": r_unc, "t_min": min(ts), "t_max": max(ts),
            "wet_hours": len(wet), "unc_wet": rate(wet), "unc_dry": rate(dry)}


def weather_text(w, unit):
    """Plain-language notes; only claims a link when it is reasonably strong."""
    if not w:
        return []
    out = []
    if w["r_us"] is not None and abs(w["r_us"]) >= 0.5:
        out.append("Upstream power %s as the outdoor temperature rose (correlation %+.2f over %d hours, %g to %g %s). "
                   "Levels that track temperature point to a temperature-sensitive fault outdoors, such as a corroded "
                   "or loose connector or damaged cable." % ("rose" if w["r_us"] > 0 else "fell", w["r_us"], w["hours"],
                                                              w["t_min"], w["t_max"], unit))
    if w["r_ds"] is not None and abs(w["r_ds"]) >= 0.5:
        out.append("Downstream power %s with temperature (correlation %+.2f)." %
                   ("rose" if w["r_ds"] > 0 else "fell", w["r_ds"]))
    if w["wet_hours"] >= 3 and w["unc_wet"] is not None and w["unc_dry"] is not None and \
            w["unc_wet"] >= max(100, 3 * (w["unc_dry"] or 0)):
        out.append("During %d hours with precipitation the modem saw %s uncorrectables per hour, against %s in dry "
                   "hours, which suggests water getting into the outdoor cabling or tap." %
                   (w["wet_hours"], "{:,}".format(w["unc_wet"]), "{:,}".format(w["unc_dry"])))
    return out


# --------------------------------------------------------------------------
# Integrations: Prometheus text file, MQTT / Home Assistant
# --------------------------------------------------------------------------

def _pl(v):
    return "%s" % v if v not in ("", None) else "NaN"


def write_metrics(cfg, st, row, ds, us):
    """Prometheus text format at <web_dir>/metrics.txt (http://router/modem-monitor/metrics.txt),
    plus an optional copy for a node-exporter textfile collector."""
    L = []
    def m(name, help_, typ, samples):
        L.append("# HELP modem_%s %s" % (name, help_))
        L.append("# TYPE modem_%s %s" % (name, typ))
        for labels, v in samples:
            lab = ",".join('%s="%s"' % (k, str(x).replace('"', "")) for k, x in labels.items())
            L.append("modem_%s%s %s" % (name, "{%s}" % lab if lab else "", _pl(v)))
    m("up", "1 if the modem answered the last sample", "gauge", [({}, row.get("ok", 0))])
    m("sample_timestamp_seconds", "Time of the last sample", "gauge", [({}, row.get("ts"))])
    if row.get("ok") == 1:
        m("uptime_seconds", "Modem uptime", "gauge", [({}, row.get("uptime_s"))])
        dl = lambda c: {"channel": c["ch"], "freq_mhz": c["freq"], "modulation": c["mod"]}
        m("downstream_power_dbmv", "Downstream receive power", "gauge", [(dl(c), c["power"]) for c in ds])
        m("downstream_snr_db", "Downstream SNR/MER", "gauge", [(dl(c), c["snr"]) for c in ds])
        m("downstream_corrected_total", "Corrected codewords (resets on reboot)", "counter", [(dl(c), c["corr"]) for c in ds])
        m("downstream_uncorrectable_total", "Uncorrectable codewords (resets on reboot)", "counter",
          [(dl(c), c["uncorr"]) for c in ds])
        m("upstream_power_dbmv", "Upstream transmit power", "gauge",
          [({"channel": c["ch"], "freq_mhz": c["freq"]}, c["power"]) for c in us])
        m("downstream_locked_channels", "Locked downstream channels", "gauge", [({}, row.get("ds_locked"))])
        m("upstream_locked_channels", "Locked upstream channels", "gauge", [({}, row.get("us_locked"))])
    m("events_total", "Modem event log entries by type since monitoring began", "counter",
      [({"type": k}, v) for k, v in sorted((st.get("event_counts") or {}).items())])
    m("ping_loss_percent", "Packet loss to the internet targets", "gauge", [({}, row.get("ping_loss"))])
    m("ping_rtt_ms", "Average ping to the internet targets", "gauge", [({}, row.get("ping_avg_ms"))])
    if row.get("gw_loss") not in ("", None):
        m("gateway_loss_percent", "Packet loss to the ISP gateway (first hop)", "gauge", [({}, row.get("gw_loss"))])
        m("gateway_rtt_ms", "Average ping to the ISP gateway", "gauge", [({}, row.get("gw_avg_ms"))])
    if row.get("hr_sent"):
        m("probe_loss_percent", "Loss of 1-second pings in the last sample interval", "gauge", [({}, row.get("hr_loss"))])
        m("probe_jitter_ms", "Jitter of 1-second pings", "gauge", [({}, row.get("hr_jitter"))])
        m("probe_p95_ms", "95th percentile latency of 1-second pings", "gauge", [({}, row.get("hr_p95"))])
        m("probe_dropouts", "Short dropouts in the last sample interval", "gauge", [({}, row.get("hr_drops"))])
        tot = st.setdefault("drops_total", 0) + int(row.get("hr_drops") or 0)
        st["drops_total"] = tot
        m("probe_dropouts_total", "Short dropouts since monitoring began", "counter", [({}, tot)])
    if row.get("temp") not in ("", None):
        m("outdoor_temperature", "Outdoor temperature (Open-Meteo)", "gauge", [({}, row.get("temp"))])
    text = "\n".join(L) + "\n"
    for path in [os.path.join(cfg["web_dir"], "metrics.txt"), (cfg.get("prom_textfile") or "").strip()]:
        if not path:
            continue
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".tmp", "w") as f:
                f.write(text)
            os.chmod(path + ".tmp", 0o644)
            os.replace(path + ".tmp", path)
        except OSError as e:
            log("metrics write failed (%s): %s" % (path, e))


HA_SENSORS = [
    # key, name, unit, device_class, icon
    ("ds_power_min", "Downstream power (lowest)", "dBmV", None, "mdi:arrow-down-bold"),
    ("ds_power_max", "Downstream power (highest)", "dBmV", None, "mdi:arrow-down-bold"),
    ("ds_snr_min", "Downstream SNR (lowest)", "dB", None, "mdi:signal"),
    ("us_power_max", "Upstream power (highest)", "dBmV", None, "mdi:arrow-up-bold"),
    ("uncorr_delta", "Uncorrectables (last sample)", None, None, "mdi:alert-circle"),
    ("uptime_s", "Modem uptime", "s", "duration", None),
    ("ping_loss", "Internet packet loss", "%", None, "mdi:lan-disconnect"),
    ("ping_avg_ms", "Internet ping", "ms", "duration", None),
    ("gw_loss", "ISP gateway packet loss", "%", None, "mdi:lan-disconnect"),
    ("gw_avg_ms", "ISP gateway ping", "ms", "duration", None),
    ("t3_today", "T3 timeouts today", None, None, "mdi:timer-alert"),
    ("hr_jitter", "Jitter", "ms", "duration", None),
    ("hr_drops", "Short dropouts (last sample)", None, None, "mdi:connection"),
    ("ds_locked", "Downstream channels locked", None, None, "mdi:numeric"),
    ("t4_today", "T4 timeouts today", None, None, "mdi:timer-alert"),
]


def mqtt_publish(cfg, topic, payload, retain=False):
    host = (cfg.get("mqtt_host") or "").strip()
    tool = shutil.which("mosquitto_pub")
    if not host or not tool:
        return False
    cmd = [tool, "-h", host, "-p", str(int(fnum(cfg, "mqtt_port")) or 1883), "-t", topic, "-s",
           "-i", "modem-monitor-%d" % os.getpid()]
    if cfg.get("mqtt_user"):
        cmd += ["-u", cfg["mqtt_user"]]
        if cfg.get("mqtt_pass"):
            cmd += ["-P", cfg["mqtt_pass"]]
    if cfg.get("mqtt_tls") == "1":
        ca = next((c for c in CA_FILES if os.path.exists(c)), None)
        if ca:
            cmd += ["--cafile", ca]
    if retain:
        cmd.append("-r")
    try:
        out = subprocess.run(cmd, input=payload.encode("utf-8"), capture_output=True, timeout=15)
        if out.returncode != 0:
            log("mqtt publish failed: %s" % (out.stderr or b"").decode("utf-8", "replace").strip()[:200])
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError) as e:
        log("mqtt publish failed: %s" % e)
        return False


def mqtt_update(cfg, st, row, today):
    if not (cfg.get("mqtt_host") or "").strip():
        return
    base = (cfg.get("mqtt_topic") or "modem_monitor").strip("/")
    state = {k: row.get(k) for k, *_ in HA_SENSORS if row.get(k) not in ("", None)}
    state.update(t3_today=today.get("T3", 0), t4_today=today.get("T4", 0), online="ON" if row.get("ok") == 1 else "OFF",
                 ts=row.get("ts"), error=row.get("error") or "")
    if row.get("temp") not in ("", None):
        state["temp"] = row["temp"]
    if cfg.get("mqtt_discovery", "1") == "1" and st.get("mqtt_disc") != VERSION + base:
        pre = (cfg.get("mqtt_discovery_prefix") or "homeassistant").strip("/")
        dev = {"identifiers": ["modem_monitor_" + base], "name": "Cable modem",
               "model": (st.get("modem_info") or {}).get("model") or "Cable modem",
               "sw_version": (st.get("modem_info") or {}).get("firmware") or "", "manufacturer": "modem-monitor"}
        ok = True
        for key, name, unit, dc, icon in HA_SENSORS:
            c = {"name": name, "unique_id": "%s_%s" % (base, key), "state_topic": base + "/state",
                 "value_template": "{{ value_json.%s }}" % key, "device": dev, "state_class": "measurement"}
            if unit:
                c["unit_of_measurement"] = unit
            if dc:
                c["device_class"] = dc
            if icon:
                c["icon"] = icon
            ok &= mqtt_publish(cfg, "%s/sensor/%s/%s/config" % (pre, base, key), json.dumps(c), retain=True)
        c = {"name": "Modem online", "unique_id": base + "_online", "state_topic": base + "/state",
             "value_template": "{{ value_json.online }}", "device_class": "connectivity", "device": dev}
        ok &= mqtt_publish(cfg, "%s/binary_sensor/%s/online/config" % (pre, base), json.dumps(c), retain=True)
        if ok:
            st["mqtt_disc"] = VERSION + base
    mqtt_publish(cfg, base + "/state", json.dumps(state), retain=True)

# --------------------------------------------------------------------------
# 1-second latency probe (jitter, short dropouts) - runs inside the daemon
# --------------------------------------------------------------------------

class Prober:
    """Sends one ICMP echo per second to a target in a background thread and
    keeps (wall_time, rtt_ms or None) per probe. A probe without a reply within
    2 seconds counts as lost. Uses a raw socket (root), else an unprivileged
    ICMP datagram socket."""

    def __init__(self, target):
        import threading
        self.target = target
        self.lock = threading.Lock()
        self.records = []
        self.stop = False
        self.error = ""
        self.thread = threading.Thread(target=self._run, name="mm-probe", daemon=True)

    def start(self):
        self.thread.start()
        return self

    @staticmethod
    def _csum(b):
        if len(b) % 2:
            b += b"\0"
        s = sum((b[i] << 8) + b[i + 1] for i in range(0, len(b), 2))
        s = (s >> 16) + (s & 0xFFFF)
        s += s >> 16
        return (~s) & 0xFFFF

    def _packet(self, ident, seq):
        import struct
        payload = b"modem-monitor-probe-" + struct.pack("!d", time.time())
        hdr = struct.pack("!BBHHH", 8, 0, 0, ident, seq)
        c = self._csum(hdr + payload)
        return struct.pack("!BBHHH", 8, 0, c, ident, seq) + payload

    def _run(self):
        import select, socket, struct
        try:
            addr = socket.gethostbyname(self.target)
        except OSError as e:
            self.error = "cannot resolve %s: %s" % (self.target, e)
            log("latency probe: " + self.error)
            return
        raw = True
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_ICMP)
        except OSError:
            raw = False
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_ICMP)
            except OSError as e:
                self.error = "no ICMP socket available (%s)" % e
                log("latency probe: " + self.error)
                return
        ident = (os.getpid() * 31 + id(self)) & 0xFFFF  # distinct per probe
        seq = 0
        pending = {}
        nxt = time.monotonic()
        log("latency probe: 1 ping/s to %s" % addr)
        while not self.stop:
            now = time.monotonic()
            if now >= nxt:
                try:
                    sock.sendto(self._packet(ident, seq), (addr, 0))
                except OSError:
                    pass  # counted as lost when it times out
                pending[seq] = (now, time.time())
                seq = (seq + 1) & 0xFFFF
                nxt += 1.0
                if nxt < now - 5:  # we were suspended; don't burst to catch up
                    nxt = now + 1.0
            try:
                r, _, _ = select.select([sock], [], [], max(0.0, min(0.5, nxt - time.monotonic())))
            except (OSError, ValueError):
                r = []
            if r:
                try:
                    data, src = sock.recvfrom(2048)
                except OSError:
                    data = b""
                off = (data[0] & 0x0F) * 4 if raw and data else 0
                if len(data) >= off + 8 and data[off] == 0 and src[0] == addr:
                    _t, _c, _ck, rid, rseq = struct.unpack("!BBHHH", data[off:off + 8])
                    if (not raw or rid == ident) and rseq in pending:
                        t0, wall = pending.pop(rseq)
                        with self.lock:
                            self.records.append((wall, round((time.monotonic() - t0) * 1000, 2)))
            cutoff = time.monotonic() - 2.0
            for s in [s for s, (t0, _w) in pending.items() if t0 < cutoff]:
                _t0, wall = pending.pop(s)
                with self.lock:
                    self.records.append((wall, None))
            with self.lock:
                if len(self.records) > 7200:
                    del self.records[:len(self.records) - 7200]

    def take(self):
        with self.lock:
            recs = sorted(self.records)
            self.records = []
        return recs


def probe_stats(recs, drop_min=2):
    """Summary of one window of 1-second probes."""
    if not recs:
        return {}
    rt = [r for _, r in recs if r is not None]
    n, lost = len(recs), sum(1 for _, r in recs if r is None)
    out = {"hr_sent": n, "hr_loss": round(lost * 100.0 / n, 2)}
    if rt:
        s = sorted(rt)
        out["hr_avg"] = round(sum(rt) / len(rt), 2)
        out["hr_p95"] = round(s[min(len(s) - 1, int(len(s) * 0.95))], 2)
        out["hr_max"] = round(s[-1], 2)
        seq = [r for _, r in recs]
        d = [abs(b - a) for a, b in zip(seq, seq[1:]) if a is not None and b is not None]
        out["hr_jitter"] = round(sum(d) / len(d), 2) if d else 0.0
    drops, run, longest = 0, 0, 0
    for _, r in recs + [(0, 0.0)]:
        if r is None:
            run += 1
        else:
            if run >= drop_min:
                drops += 1
                longest = max(longest, run)
            run = 0
    out["hr_drops"], out["hr_longest"] = drops, longest
    return out


PROBER = None


def path_hops(cfg, max_hops=6):
    """First hops toward the internet (traceroute), for when the gateway
    doesn't answer pings itself."""
    tool = shutil.which("traceroute")
    target = (cfg.get("ping_targets") or "1.1.1.1").split()[0]
    if not tool:
        return []
    try:
        out = subprocess.run([tool, "-n", "-q", "1", "-w", "1", "-m", str(max_hops), target],
                             capture_output=True, text=True, timeout=max_hops * 3 + 10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    hops = []
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+\.\d+\.\d+\.\d+)", line)
        if m and m.group(2) not in hops:
            hops.append(m.group(2))
    return hops


def probe_target(cfg, st=None, exclude=()):
    """hires_target "gateway" (default) means: the ISP gateway if it answers
    pings, otherwise the next hop along the path that does, otherwise the first
    ping target. Any other value is used as given."""
    t = (cfg.get("hires_target") or "gateway").strip()
    fallback = (cfg.get("ping_targets") or "1.1.1.1").split()[0]
    if t not in ("", "gateway"):
        return t
    cands = []
    gw = isp_gateway(cfg)
    for c in ([gw] if gw else []) + path_hops(cfg):
        if c and c not in cands and c not in exclude:
            cands.append(c)
    tried = []
    for c in cands[:6]:
        loss, _avg, _mx = ping(c, 5)
        tried.append("%s %s%%" % (c, "?" if loss is None else int(loss)))
        if loss is not None and loss <= 20:
            why = "ISP gateway" if c == gw else "first hop past the gateway that answers pings"
            if st is not None:
                st["probe"] = {"target": c, "why": why, "tried": tried, "ts": int(time.time())}
            log("latency probe target: %s (%s; tried %s)" % (c, why, ", ".join(tried)))
            return c
    if st is not None:
        st["probe"] = {"target": fallback, "why": "no hop near you answers pings; using the first ping target",
                       "tried": tried, "ts": int(time.time())}
    log("latency probe target: %s (no nearby hop answered pings; tried %s)" % (fallback, ", ".join(tried) or "none"))
    return fallback


HR_KEYS = ("hr_sent", "hr_loss", "hr_avg", "hr_p95", "hr_max", "hr_jitter", "hr_drops", "hr_longest")


def probe_health(cfg, st, row):
    """If the probe target stops answering while ordinary pings to the internet
    all get through, the target (not the line) is the problem: discard that
    window and pick a new target. Partial answers (rate limiting) for three
    windows in a row also trigger a new choice."""
    global PROBER
    if PROBER is None or not row.get("hr_sent"):
        return
    net_ok = row.get("ping_loss") not in ("", None) and row["ping_loss"] == 0
    bad = net_ok and row.get("hr_loss", 0) >= 100
    flaky = net_ok and row.get("hr_loss", 0) >= 20
    st["probe_flaky"] = st.get("probe_flaky", 0) + 1 if flaky else 0
    pr = st.get("probe") or {}
    if not (bad or flaky) and pr.get("why", "").startswith(("first hop", "no hop")) and \
            time.time() - pr.get("ts", 0) > 6 * 3600:
        # every 6 h, check whether the gateway itself answers again
        st["probe"]["ts"] = int(time.time())
        new = probe_target(cfg, st)
        if new != PROBER.target:
            PROBER.stop = True
            PROBER = Prober(new).start()
        return
    if bad or st["probe_flaky"] >= 3:
        old = PROBER.target
        log("latency probe: %s %s while the internet answered normally; choosing another target" %
            (old, "stopped answering" if bad else "keeps dropping pings"))
        if bad:
            for k in HR_KEYS:
                row[k] = ""  # not a line problem: don't count it
        PROBER.stop = True
        PROBER = Prober(probe_target(cfg, st, exclude=(old,))).start()
        st["probe_flaky"] = 0


# --------------------------------------------------------------------------
# Channel watch: channels the modem had locked but lost (partial service)
# --------------------------------------------------------------------------

def channel_watch(cfg, st, row, now):
    """Baseline = most channels locked at once in the last 24 h. Fewer now means
    the modem is running on part of its channels (slower, less reliable)."""
    if cfg.get("channel_watch", "1") != "1" or row.get("ok") != 1:
        return None
    seen = [x for x in st.get("ch_seen", []) if x[0] >= now - 86400]
    dsl, usl = int(row.get("ds_locked") or 0), int(row.get("us_locked") or 0)
    base_ds = max([x[1] for x in seen] + [0])
    base_us = max([x[2] for x in seen] + [0])
    seen.append([int(now), dsl, usl])
    st["ch_seen"] = seen[-400:]
    row["ds_base"], row["us_base"] = base_ds or dsl, base_us or usl
    lost = []
    if base_ds and dsl < base_ds:
        lost.append("%d of %d downstream" % (base_ds - dsl, base_ds))
    if base_us and usl < base_us:
        lost.append("%d of %d upstream" % (base_us - usl, base_us))
    return lost


# --------------------------------------------------------------------------
# Daily digest
# --------------------------------------------------------------------------

def day_digest(cfg, day=None):
    """One-paragraph summary of a day (default yesterday) for a notification."""
    if not day:
        day = time.strftime("%Y-%m-%d", time.localtime(time.time() - 86400))
    lo = _day_ts(day)
    hi = _bstart(lo + 86400 + 7200, 86400)
    summ = [r for r in mark_reboots(read_csvs(files_since(cfg, "summary", lo - 3600), lo - 3600)) if lo <= int(r["ts"]) < hi]
    ev = [e for e in read_csvs([os.path.join(cfg["data_dir"], "events.csv")], lo) if int(e["ts"]) < hi]
    if not summ:
        return day, "No samples were recorded (monitor or router was off)."
    c = lambda t: sum(1 for e in ev if e["type"] == t)
    okr = [r for r in summ if r.get("ok") == "1"]
    rng = lambda k1, k2: (lambda a, b: "%g..%g" % (min(a), max(b)) if a and b else "?")(
        [fv(r, k1) for r in okr if fv(r, k1) is not None], [fv(r, k2) for r in okr if fv(r, k2) is not None])
    unc = sum(int(fv(r, "uncorr_delta") or 0) for r in okr)
    down = sum(1 for r in summ if modem_down(r))
    reb = sum(1 for r in summ if r["_reb"])
    rel = sum(1 for r in summ if r["_rel"])
    loss = sum(1 for r in summ if (fv(r, "ping_loss") or 0) > 0)
    drops = sum(int(fv(r, "hr_drops") or 0) for r in summ)
    longest = max([int(fv(r, "hr_longest") or 0) for r in summ] + [0])
    lostch = sum(1 for r in summ if fv(r, "ds_base") and (fv(r, "ds_locked") or 0) < fv(r, "ds_base"))
    t3, t4 = c("T3"), c("T4")
    bad = t3 or t4 or reb or rel or down or unc >= 1000 or drops or lostch
    parts = ["T3 %d, T4 %d" % (t3, t4), "uncorrectables %s" % "{:,}".format(unc),
             "downstream %s dBmV" % rng("ds_power_min", "ds_power_max"),
             "upstream %s dBmV" % rng("us_power_min", "us_power_max")]
    if reb or rel:
        parts.append("%d reboot%s, %d re-registration%s" % (reb, "" if reb == 1 else "s", rel, "" if rel == 1 else "s"))
    parts.append("unreachable in %d sample%s" % (down, "" if down == 1 else "s") if down else "no outages")
    if loss:
        parts.append("packet loss in %d sample%s" % (loss, "" if loss == 1 else "s"))
    if any(fv(r, "hr_sent") for r in summ):
        parts.append("%d short dropout%s%s" % (drops, "" if drops == 1 else "s", " (longest %d s)" % longest if drops else ""))
    if lostch:
        parts.append("channels missing in %d sample%s" % (lostch, "" if lostch == 1 else "s"))
    for r in speed_rows(cfg, lo, hi)[-1:]:
        if r.get("error") and fv(r, "down_mbps") is None and fv(r, "up_mbps") is None:
            parts.append("speed test failed (%s)" % r["error"][:60])
        else:
            parts.append("speed test %s/%s Mb/s, latency %s ms idle / %s ms loaded" % (
                r.get("down_mbps") or "-", r.get("up_mbps") or "-", r.get("idle_ms") or "-", r.get("loaded_ms") or "-"))
    try:
        ch, info = channel_uncorr(cfg, {"d": (lo, 86400)}, hi=hi)
        f = ingress_findings(ch["d"], info)
        if f and f[0]["kind"] == "narrow":
            parts.append("errors concentrated on %g-%g MHz (likely ingress)" % (f[0]["fmin"], f[0]["fmax"]))
    except Exception:
        pass
    return day, ("Problems: " if bad else "Clean day: ") + "; ".join(parts) + "."


def digest_due(cfg, st, now):
    if cfg.get("daily_digest", "0") != "1" or not alert_targets(cfg):
        return
    lt = time.localtime(now)
    today = time.strftime("%Y-%m-%d", lt)
    if st.get("digest_day") == today or lt.tm_hour < int(fnum(cfg, "digest_hour")):
        return
    day, text = day_digest(cfg)
    res = send_alert(cfg, "Modem report for %s" % time.strftime("%a %b %d", time.strptime(day, "%Y-%m-%d")), text, 2, "digest")
    if any(ok for _, ok, _ in res):
        st["digest_day"] = today
        log("daily digest sent")
    if (cfg.get("mqtt_host") or "").strip():
        mqtt_publish(cfg, (cfg.get("mqtt_topic") or "modem_monitor").strip("/") + "/digest",
                     json.dumps({"day": day, "text": text}), retain=True)

# --------------------------------------------------------------------------
# Outage credits: monthly outage totals and a credit-request letter
# --------------------------------------------------------------------------

def month_bounds(ym):
    y, m = (int(x) for x in ym.split("-"))
    lo = int(time.mktime((y, m, 1, 0, 0, 0, 0, 0, -1)))
    ny, nm = (y + 1, 1) if m == 12 else (y, m + 1)
    hi = int(time.mktime((ny, nm, 1, 0, 0, 0, 0, 0, -1)))
    return lo, hi


def outage_month(cfg, ym, summ_all=None, maint_all=None):
    """Outages in a month, leaving out planned work: start, minutes, cause."""
    lo, hi = month_bounds(ym)
    interval = int(fnum(cfg, "interval"))
    summ = summ_all if summ_all is not None else mark_reboots(read_csvs(files_since(cfg, "summary", lo - 86400), lo - 86400))
    summ = [r for r in summ if lo - 86400 <= int(r["ts"]) < hi]
    allm = maint_all if maint_all is not None else load_maint(cfg)
    wins = work_windows([m for m in allm if lo - 86400 <= int(m["ts"]) < hi], summ, interval)
    inw = lambda t: any(w["a"] <= t < w["b"] for w in wins)
    summ = [r for r in summ if lo <= int(r["ts"]) < hi and not inw(int(r["ts"]))]
    outs = []
    for o in group_outages(summ, interval):
        outs.append({"ts": o["start"], "start": time.strftime("%Y-%m-%d %H:%M", time.localtime(o["start"])),
                     "mins": round((o["end"] - o["start"]) / 60 + interval / 60), "why": o["why"]})
    rereg = [r for r in summ if r["_reb"] or r["_rel"]]
    drops = int(sum(fv(r, "hr_drops") or 0 for r in summ))
    mins = sum(o["mins"] for o in outs)
    days = sorted({o["start"][:10] for o in outs} | {time.strftime("%Y-%m-%d", time.localtime(int(r["ts"]))) for r in rereg})
    price = fnum(cfg, "credit_monthly_price")
    ndays = (hi - lo) / 86400.0
    # outages the user logged for times nothing was measured (before monitoring began)
    alls = [int(r["ts"]) for r in summ]
    logged = []
    for m in allm:
        a, b = int(m["ts"]), max(int(m.get("end_ts") or 0), int(m["ts"]))
        if m["type"] == "outage" and m["status"] == "confirmed" and lo <= a < hi and \
                not any(a - interval <= t <= b + interval for t in alls):
            logged.append({"start": m["time"][:16], "end": (m.get("end_time") or "")[:16], "note": m["note"]})
    return {"month": ym, "outages": outs, "logged": logged, "minutes": mins, "rereg": len(rereg), "drops": drops,
            "days": days, "samples": len(summ),
            "prorated": round(price * mins / (ndays * 1440), 2) if price else None,
            "per_day": round(price * len(days) / ndays, 2) if price else None, "price": price or None}


def credit_months(cfg, n=6):
    now = time.localtime()
    out, y, m = [], now.tm_year, now.tm_mon
    lo = month_bounds("%04d-%02d" % ((y, m - n + 1) if m - n + 1 >= 1 else (y - 1, m - n + 13)))[0]
    summ = mark_reboots(read_csvs(files_since(cfg, "summary", lo - 86400), lo - 86400))
    maint = load_maint(cfg)
    for _ in range(n):
        ym = "%04d-%02d" % (y, m)
        r = outage_month(cfg, ym, summ, maint)
        if r["samples"] or r["logged"]:
            r["outages_n"] = len(r.pop("outages"))
            r["logged_n"] = len(r.pop("logged"))
            out.append(r)
        y, m = (y - 1, 12) if m == 1 else (y, m - 1)
    return out


def credit_letter(cfg, ym):
    r = outage_month(cfg, ym)
    isp = (cfg.get("isp_name") or "").strip() or "your company"
    name = (cfg.get("credit_name") or "").strip()
    acct = (cfg.get("credit_account") or "").strip()
    addr = (cfg.get("credit_address") or "").strip()
    mname = time.strftime("%B %Y", time.strptime(ym + "-01", "%Y-%m-%d"))
    data = {"isp": isp, "name": name, "acct": acct, "addr": addr, "month": mname, "r": r,
            "interval": int(fnum(cfg, "interval")), "today": time.strftime("%B %d, %Y"),
            "note": (cfg.get("report_note") or "").strip()}
    out = os.path.join(cfg["web_dir"], "credit.html")
    os.makedirs(cfg["web_dir"], exist_ok=True)
    page = CREDIT_HTML.replace("/*__DATA__*/null", json.dumps(data, separators=(",", ":")).replace("</", "<\\/"))
    with open(out + ".tmp", "w") as f:
        f.write(page)
    os.chmod(out + ".tmp", 0o644)
    os.replace(out + ".tmp", out)
    return out


