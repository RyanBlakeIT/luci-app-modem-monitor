# --------------------------------------------------------------------------
# Off-router backup of the data directory
# --------------------------------------------------------------------------

def backup_files(cfg):
    d = cfg["data_dir"]
    pats = ("*.csv", "*.csv.gz", "*.log", "*.log.gz")
    return sorted({p for pat in pats for p in glob.glob(os.path.join(d, pat))})


def run_backup(cfg, st=None):
    """Mirror the data files (never state.json, which holds the modem session)
    to a mounted directory or, over SSH, to user@host:/path. Nothing is deleted
    at the destination, so pruned history survives there."""
    dest = (cfg.get("backup_dest") or "").strip()
    if not dest:
        raise ModemError("no backup destination set")
    files = backup_files(cfg)
    t0 = time.time()
    remote = re.match(r"^([\w.-]+@)?[\w.-]+:(.*)$", dest) and not dest.startswith("/")
    if not remote:
        if not os.path.isdir(dest):
            raise ModemError("%s is not a directory (is the share mounted?)" % dest)
        if os.path.realpath(dest).startswith(os.path.realpath(cfg["data_dir"])):
            raise ModemError("the backup destination is inside the data directory")
        n = 0
        for p in files:
            q = os.path.join(dest, os.path.basename(p))
            try:
                s1, s2 = os.stat(p), os.stat(q) if os.path.exists(q) else None
                if s2 and s2.st_size == s1.st_size and int(s2.st_mtime) >= int(s1.st_mtime):
                    continue
                shutil.copy2(p, q + ".tmp")
                os.replace(q + ".tmp", q)
                n += 1
            except OSError as e:
                raise ModemError("copy to %s failed: %s" % (dest, e))
        msg = "copied %d changed file%s of %d to %s" % (n, "" if n == 1 else "s", len(files), dest)
    else:
        key = (cfg.get("backup_ssh_key") or "").strip()
        sshopt = ["-i", key] if key else []
        if shutil.which("rsync"):
            ssh = "ssh -y" if os.path.basename(os.path.realpath(shutil.which("ssh") or "")).startswith("dropbear") \
                else "ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes"
            cmd = ["rsync", "-a", "--timeout=60", "-e", " ".join([ssh] + sshopt)] + files + [dest.rstrip("/") + "/"]
        elif shutil.which("scp"):
            cmd = ["scp", "-q"] + sshopt + files + [dest.rstrip("/") + "/"]
        else:
            raise ModemError("no rsync or scp on the router (install rsync or openssh-client)")
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=600, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise ModemError("backup timed out after 10 minutes")
        if out.returncode != 0:
            raise ModemError((out.stderr or out.stdout or "failed").strip()[-300:])
        msg = "sent %d files to %s with %s" % (len(files), dest, cmd[0])
    msg += " (%.1f s)" % (time.time() - t0)
    return msg


def backup_due(cfg, st, now):
    if cfg.get("backup_enabled", "0") != "1":
        return
    lt = time.localtime(now)
    today = time.strftime("%Y-%m-%d", lt)
    if st.get("backup_day") == today or lt.tm_hour < int(fnum(cfg, "backup_hour")):
        return
    if now - st.get("backup_try", 0) < 3600:
        return
    st["backup_try"] = int(now)
    try:
        msg = run_backup(cfg, st)
        st["backup_day"], st["backup_last"] = today, {"ts": int(now), "ok": True, "msg": msg}
        log("backup: " + msg)
    except ModemError as e:
        st["backup_last"] = {"ts": int(now), "ok": False, "msg": str(e)}
        log("backup failed: %s" % e)
        if cfg.get("alert_enabled") == "1" and alert_targets(cfg):
            send_alert(cfg, "Modem data backup failed", str(e), 3, "backup")


# --------------------------------------------------------------------------
# Speed tests (optional; uses data)
# --------------------------------------------------------------------------

def sqm_limits():
    """Download/upload shaper rates (Mb/s) of enabled SQM queues, if any.
    Speed tests from the router can't exceed these, so low results are judged
    against min(plan, SQM limit) rather than the plan alone."""
    try:
        out = subprocess.run(["uci", "-q", "show", "sqm"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None
    q = {}
    for line in out.splitlines():
        m = re.match(r"sqm\.([^.=]+)\.(enabled|download|upload)='?([^']*)'?$", line)
        if m:
            q.setdefault(m.group(1), {})[m.group(2)] = m.group(3)
    down = [float(x["download"]) / 1000 for x in q.values() if x.get("enabled") == "1" and (x.get("download") or "0") not in ("0", "")]
    up = [float(x["upload"]) / 1000 for x in q.values() if x.get("enabled") == "1" and (x.get("upload") or "0") not in ("0", "")]
    return (min(down) if down else None), (min(up) if up else None)


def speed_rows(cfg, since, hi=None):
    """Speed test history. Directions that moved under 1 MB (refused downloads
    recorded as 0 Mb/s by versions before 1.6.5) are failed tests, not speeds."""
    out = []
    for r in read_csvs([os.path.join(cfg["data_dir"], "speedtest.csv")], since):
        if hi is not None and int(r["ts"]) >= hi:
            continue
        for d in ("down", "up"):
            mb = fv(r, d + "_mb")
            if mb is not None and mb < 1:
                r[d + "_mbps"], r[d + "_mb"] = "", ""
                r["error"] = (r.get("error") or "%s failed (no data moved)" % ("download" if d == "down" else "upload"))
        out.append(r)
    return out


SPEED_COLS = ["ts", "time", "down_mbps", "up_mbps", "idle_ms", "loaded_ms", "down_mb", "up_mb", "server", "error"]


def _speed_dir(url, seconds, max_bytes, streams, upload=False):
    """One direction of the test: `streams` parallel connections for up to
    `seconds`, stopping early at `max_bytes` in total (0 = no data limit).
    Each stream repeats requests of up to 100 MB so long tests at gigabit
    speed don't depend on one huge request."""
    import http.client, threading, urllib.parse
    u = urllib.parse.urlparse(url)
    base = u.path.rstrip("/")
    total = [0]
    errs = []
    lock = threading.Lock()
    stop_at = time.monotonic() + seconds
    cafile = next((c for c in CA_FILES if os.path.exists(c)), None)
    # Cloudflare refuses single requests near 100 MB, and from some connections
    # far smaller ones: start at 25 MB and halve on a refusal (down to 1 MB).
    req = [25 * 1000000]
    reserved = [0]
    ua = "Mozilla/5.0 (compatible; luci-app-modem-monitor/%s)" % VERSION

    def room():
        """Claim the next request's size, so parallel streams can't overshoot the limit."""
        with lock:
            size = req[0] if not max_bytes else max(0, min(req[0], max_bytes - reserved[0]))
            reserved[0] += size
            return size

    def unclaim(n):
        with lock:
            reserved[0] -= n

    def refused(size):
        """Smaller requests after a 403; False once even 1 MB is refused."""
        unclaim(size)
        with lock:
            if req[0] <= 1000000:
                return False
            req[0] = max(1000000, req[0] // 2)
            return True

    def add(n):
        with lock:
            total[0] += n

    def conn():
        if u.scheme == "https":
            return http.client.HTTPSConnection(u.hostname, u.port or 443, timeout=15,
                                               context=ssl.create_default_context(cafile=cafile))
        return http.client.HTTPConnection(u.hostname, u.port or 80, timeout=15)

    def worker():
        try:
            c = conn()
            while time.monotonic() < stop_at:
                size = room()
                if size <= 0:
                    break
                if upload:
                    c.putrequest("POST", base + "/__up")
                    c.putheader("User-Agent", ua)
                    c.putheader("Content-Type", "application/octet-stream")
                    c.putheader("Content-Length", str(size))
                    c.endheaders()
                    chunk, sent = b"\0" * 65536, 0
                    while sent < size and time.monotonic() < stop_at:
                        n = min(len(chunk), size - sent)
                        c.send(chunk[:n])
                        sent += n
                        add(n)
                    if sent < size:
                        break  # out of time mid-request; the connection is abandoned
                    r = c.getresponse()
                    r.read()
                    if r.status == 403 and refused(size):
                        c.close()
                        c = conn()
                        continue
                    if r.status >= 400:
                        raise ModemError("upload refused: HTTP %d %s" % (r.status, r.reason))
                else:
                    c.request("GET", "%s/__down?bytes=%d" % (base, size), headers={"User-Agent": ua, "Accept": "*/*"})
                    r = c.getresponse()
                    if r.status != 200:
                        body = r.read(300).decode("utf-8", "replace")
                        if r.status == 403 and refused(size):
                            c.close()
                            c = conn()
                            continue
                        raise ModemError("download refused: HTTP %d %s %s" % (r.status, r.reason, " ".join(body.split())[:120]))
                    got = 0
                    while time.monotonic() < stop_at:
                        b = r.read(65536)
                        if not b:
                            break
                        got += len(b)
                        add(len(b))
                    if got < size:
                        unclaim(size - got)
                        break
            c.close()
        except Exception as e:
            errs.append(str(e))

    t0 = time.monotonic()
    th = [threading.Thread(target=worker, daemon=True) for _ in range(streams)]
    for t in th:
        t.start()
    for t in th:
        t.join(seconds + 20)
    el = max(0.001, min(time.monotonic(), stop_at) - t0)
    if errs and total[0] < 1000000:  # under 1 MB: the test didn't really run
        raise ModemError(errs[0][:200])
    if total[0] < 1000000:
        raise ModemError("%s: the server sent/accepted only %d bytes" % ("upload" if upload else "download", total[0]))
    return round(total[0] * 8 / el / 1e6, 1), round(total[0] / 1e6, 1)


SPEED_LOCK = "/tmp/modem-monitor-speedtest.running"


def speed_test(cfg):
    url = (cfg.get("speedtest_url") or "https://speed.cloudflare.com").rstrip("/")
    secs = max(3, int(fnum(cfg, "speedtest_seconds")))
    mb = int(fnum(cfg, "speedtest_max_mb"))
    cap = 0 if mb <= 0 else max(10, mb) * 1000000  # 0 = unlimited (time limit only)
    now = time.time()
    row = {"ts": int(now), "time": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now)), "server": url, "error": ""}
    try:
        open(SPEED_LOCK, "w").close()
    except OSError:
        pass
    tgt = (load_state(cfg).get("probe") or {}).get("target") or probe_target(cfg)
    try:
        p = Prober(tgt).start()
        time.sleep(4)
        idle = [r for _, r in p.take() if r is not None]
        row["idle_ms"] = round(sorted(idle)[len(idle) // 2], 1) if idle else ""
        errs = []
        try:
            row["down_mbps"], row["down_mb"] = _speed_dir(url, secs, cap, 4)
        except ModemError as e:
            errs.append(str(e))
        dl = [r for _, r in p.take() if r is not None]
        try:
            row["up_mbps"], row["up_mb"] = _speed_dir(url, secs, cap, 4, upload=True)
        except ModemError as e:
            errs.append(str(e))
        ul = [r for _, r in p.take() if r is not None]
        row["error"] = "; ".join(errs)
        p.stop = True
        loaded = sorted(dl + ul)
        row["loaded_ms"] = round(loaded[len(loaded) // 2], 1) if loaded else ""
    except ModemError as e:
        row["error"] = str(e)
    except Exception as e:
        row["error"] = repr(e)[:200]
    append_csv(os.path.join(cfg["data_dir"], "speedtest.csv"), SPEED_COLS, [row])
    try:
        os.remove(SPEED_LOCK)
    except OSError:
        pass
    return row


def speed_due(cfg, st, now):
    if cfg.get("speedtest_enabled", "0") != "1":
        return
    lt = time.localtime(now)
    today = time.strftime("%Y-%m-%d", lt)
    if "speed_min" not in st:
        import random
        st["speed_min"] = random.randint(0, 50)  # spread users across the hour
    if st.get("speed_day") == today or (lt.tm_hour, lt.tm_min) < (int(fnum(cfg, "speedtest_hour")), st["speed_min"]):
        return
    st["speed_day"] = today
    r = speed_test(cfg)
    log("speed test: %s down / %s up Mb/s, latency %s ms idle, %s ms loaded%s" % (
        r.get("down_mbps"), r.get("up_mbps"), r.get("idle_ms"), r.get("loaded_ms"),
        " (error: %s)" % r["error"] if r.get("error") else ""))

# --------------------------------------------------------------------------
# Printable complaint summary for a date range
# --------------------------------------------------------------------------

def mark_reboots(summ):
    """Reboot = uptime went backwards; re-registration = counters reset (or the
    modem logged registration trouble) while uptime kept counting."""
    prev_up = None
    for r in summ:
        up = fv(r, "uptime_s")
        stored = r.get("rebooted") == "1"
        reb = (up + 120 < prev_up) if (up is not None and prev_up is not None) else stored
        r["_reb"] = reb
        r["_rel"] = (r.get("relock") == "1" or stored) and not reb
        if up is not None:
            prev_up = up
    return summ


def is_outage(r):
    """Service was down: pings failed completely, or the modem didn't answer and
    pings were failing too (or weren't measured). A modem status page that
    times out while pings get through is not an outage."""
    loss = fv(r, "ping_loss")
    return (loss or 0) >= 100 or (modem_down(r) and (loss is None or loss > 0))


def group_outages(summ, interval):
    outs, cur = [], None
    for r in summ:
        bad = is_outage(r)
        t = int(r["ts"])
        if bad:
            why = r.get("error") or "100% packet loss"
            if cur and t - cur["end"] <= interval * 2 + 60:
                cur["end"] = t
                cur["polls"] += 1
            else:
                cur = {"start": t, "end": t, "polls": 1, "why": why}
                outs.append(cur)
        else:
            cur = None
    return outs


def _day_ts(s):
    return int(time.mktime(time.strptime(s, "%Y-%m-%d")))


WORK_TYPES = ("tech", "modem-reboot", "router-change", "wiring", "power")
POWER_PAIR_S = 15 * 60  # router and modem restarting this close together = power cut at home


def work_windows(maint, summ, interval):
    """Time taken up by planned work, from the confirmed tech / modem-reboot /
    router-change / wiring entries: from the start until the line has settled (first two
    clean samples after the work ends, looked for up to an hour; otherwise 15
    minutes after it ends, so lasting trouble is still counted)."""
    ok = lambda r: (r.get("ok") == "1" and not r["_reb"] and not r["_rel"] and (fv(r, "ping_loss") or 0) == 0)
    wins = []
    for m in maint:
        if m["status"] != "confirmed" or m["type"] not in WORK_TYPES or \
                (m["source"] == "auto" and m["type"] != "power"):
            continue
        a = int(m["ts"])
        b = max(int(m.get("end_ts") or 0), a)
        cand = [r for r in summ if b < int(r["ts"]) <= b + 3600]
        if m["type"] == "modem-reboot":
            hit = [i for i, r in enumerate(cand) if r["_reb"] and int(r["ts"]) <= b + 1800]
            if hit:
                cand = cand[hit[0] + 1:]
        end = b + 900
        for i, r in enumerate(cand):
            if ok(r) and i + 1 < len(cand) and ok(cand[i + 1]):
                end = int(r["ts"])
                break
        wins.append({"a": a, "b": max(end, a + interval), "type": m["type"], "note": m["note"],
                     "time": m["time"][:16]})
    return wins


def complaint_summary(cfg, d_from, d_to, exclude_work=True):
    lo, hi0 = _day_ts(d_from), _day_ts(d_to)
    if hi0 < lo:
        lo, hi0 = hi0, lo
    hi = _bstart(hi0 + 86400 + 7200, 86400)  # next local midnight (DST-safe)
    interval = int(fnum(cfg, "interval"))
    summ = mark_reboots(read_csvs(files_since(cfg, "summary", lo - 86400), lo - 86400))
    summ = [r for r in summ if lo <= int(r["ts"]) < hi]
    events = [e for e in read_csvs([os.path.join(cfg["data_dir"], "events.csv")], lo) if int(e["ts"]) < hi]
    links = [r for r in read_csvs(files_since(cfg, "link", lo - 86400), lo - 86400) if int(r["ts"]) < hi]
    prevl = {}
    for r in links:
        pr = prevl.get(r.get("dev"))
        tot = lambda x: sum(int(fv(x, k) or 0) for k in LINK_ERR_KEYS)
        r["_err"] = max(0, tot(r) - tot(pr)) if pr else 0
        prevl[r.get("dev")] = r
    links = [r for r in links if int(r["ts"]) >= lo]
    allm = sorted(load_maint(cfg), key=lambda r: int(r["ts"]))
    maint = [r for r in allm if lo <= int(r["ts"]) < hi]
    planned = [(int(m["ts"]), max(int(m["end_ts"] or 0), int(m["ts"])) + 1800) for m in maint
               if m["status"] == "confirmed" and m["source"] != "auto" and m["type"] in ("modem-reboot", "tech")]
    expl = sum(1 for r in summ if r["_reb"] and any(a <= int(r["ts"]) <= b for a, b in planned))
    wins = []
    if exclude_work:
        wins = [w for w in work_windows([m for m in allm if lo - 86400 <= int(m["ts"]) < hi], summ, interval)
                if w["b"] > lo and w["a"] < hi]
        inw = lambda t: next((w for w in wins if w["a"] <= t < w["b"]), None)
        for w in wins:
            w.update(samples=0, t34=0, uncorr=0, down=0, reb=0, rel=0)
        for r in summ:
            w = inw(int(r["ts"]))
            if w:
                w["samples"] += 1
                w["uncorr"] += int(fv(r, "uncorr_delta") or 0) if r.get("ok") == "1" else 0
                w["down"] += 1 if modem_down(r) else 0
                w["reb"] += 1 if r["_reb"] else 0
                w["rel"] += 1 if r["_rel"] else 0
        for e in events:
            w = inw(int(e["ts"]))
            if w and e["type"] in ("T3", "T4"):
                w["t34"] += 1
        summ = [r for r in summ if not inw(int(r["ts"]))]
        events = [e for e in events if not inw(int(e["ts"]))]
        links = [r for r in links if not inw(int(r["ts"]))]
    ch, info = channel_uncorr(cfg, {"day": (lo, 86400)}, hi=hi,
                             skip=(lambda t: any(w["a"] <= t < w["b"] for w in wins)) if wins else None)
    ingress = ingress_findings(ch["day"], info)
    ing_by_day = {f["day"]: f for f in ingress}
    st = load_state(cfg)
    usmax_lim = fnum(cfg, "us_power_max")

    days = []
    t = lo
    while t < hi:
        days.append(time.strftime("%Y-%m-%d", time.localtime(t)))
        t = _bstart(t + 86400 + 7200, 86400)
    D = {d: {"day": d, "T3": 0, "T4": 0, "DRW": 0, "REG": 0, "uncorr": 0, "us_max": None, "us_over": 0, "reboots": 0,
             "relocks": 0, "down": 0, "loss": 0, "polls": 0, "link_err": 0} for d in days}
    for e in events:
        x = D.get(e["time"][:10])
        if not x:
            continue
        if e["type"] in ("T3", "T4", "DRW"):
            x[e["type"]] += 1
        elif e["type"] in ("SYNC", "PROVISION"):
            x["REG"] += 1
    for r in summ:
        x = D.get(r["time"][:10])
        if not x:
            continue
        x["polls"] += 1
        x["uncorr"] += int(fv(r, "uncorr_delta") or 0) if r.get("ok") == "1" else 0
        x["reboots"] += 1 if r["_reb"] else 0
        x["relocks"] += 1 if r["_rel"] else 0
        x["down"] += 1 if modem_down(r) else 0
        x["loss"] += 1 if (fv(r, "ping_loss") or 0) > 0 else 0
        u = fv(r, "us_power_max")
        if u is not None:
            x["us_max"] = u if x["us_max"] is None else max(x["us_max"], u)
            x["us_over"] += 1 if u > usmax_lim else 0
    for r in links:
        x = D.get(r["time"][:10])
        if x:
            x["link_err"] += r["_err"]
    for e in events:
        x = D.get(e["time"][:10])
        if x:
            x["logged"] = True
    rows = [D[d] for d in days]
    while len(rows) > 1 and not rows[0]["polls"] and not rows[0].get("logged"):
        rows.pop(0)  # before monitoring (or the modem's log) began
    for x in rows:
        x["bad"] = bool(x["T3"] or x["T4"] or x["REG"] or x["reboots"] or x["relocks"] or x["down"]
                        or x["us_over"] or x["uncorr"] >= INGRESS_MIN)
        x["ingress"] = ing_by_day.get(x["day"])
    mon = [x for x in rows if x["polls"] or x.get("logged")]
    S = lambda k: sum(x[k] for x in rows)
    outs = [o for o in group_outages(summ, interval)]
    down_min = sum(round((o["end"] - o["start"]) / 60 + interval / 60) for o in outs)
    usm = [x["us_max"] for x in rows if x["us_max"] is not None]
    worst = max(rows, key=lambda x: x["uncorr"]) if rows else None
    pings = [fv(r, "ping_loss") for r in summ if fv(r, "ping_loss") is not None]
    data = {
        "title": (cfg.get("report_title") or "").strip() or "Cable internet service problems: summary",
        "isp": (cfg.get("isp_name") or "").strip(), "note": (cfg.get("report_note") or "").strip(),
        "from": rows[0]["day"] if rows else d_from, "asked_from": days[0] if days else d_from, "to": days[-1] if days else d_to,
        "generated": time.strftime("%Y-%m-%d %H:%M"), "interval": interval,
        "modem": st.get("modem_info", {}), "limits": {k: fnum(cfg, k) for k in
                                                      ("us_power_min", "us_power_max", "ds_power_min", "ds_power_max", "ds_snr_min")},
        "tot": {"days": len(rows), "mon_days": len(mon), "bad_days": sum(1 for x in mon if x["bad"]),
                "T3": S("T3"), "T4": S("T4"), "DRW": S("DRW"), "REG": S("REG"), "uncorr": S("uncorr"),
                "reboots": S("reboots"), "router_reboots": 0 if exclude_work else expl, "relocks": S("relocks"),
                "outages": len(outs), "down_min": down_min, "loss_polls": S("loss"), "polls": S("polls"),
                "us_peak": max(usm) if usm else None, "us_over_days": sum(1 for x in rows if x["us_over"]),
                "link_err": S("link_err"), "link_on": bool(links),
                "gw_loss_polls": sum(1 for r in summ if (fv(r, "gw_loss") or 0) > 0),
                "gw_on": any(fv(r, "gw_loss") is not None for r in summ),
                "both_loss": sum(1 for r in summ if (fv(r, "gw_loss") or 0) > 0 and (fv(r, "ping_loss") or 0) > 0),
                "traces": len(read_traces(cfg, lo, 1000)),
                "loss_starts": trace_starts(cfg, lo, hi),
                "speed": [[fv(r, "down_mbps"), fv(r, "up_mbps")] for r in speed_rows(cfg, lo, hi)
                          if fv(r, "down_mbps") is not None or fv(r, "up_mbps") is not None],
                "plan": [fnum(cfg, "plan_down") or None, fnum(cfg, "plan_up") or None],
                "sqm": list(sqm_limits()),
                "hires_on": any(fv(r, "hr_sent") for r in summ),
                "drops": int(sum(fv(r, "hr_drops") or 0 for r in summ)),
                "drop_days": len({r["time"][:10] for r in summ if (fv(r, "hr_drops") or 0) > 0}),
                "longest": int(max([fv(r, "hr_longest") or 0 for r in summ] + [0])),
                "lostch": sum(1 for r in summ if fv(r, "ds_base") is not None and r.get("ok") == "1" and
                              ((fv(r, "ds_locked") or 0) < fv(r, "ds_base") or (fv(r, "us_locked") or 0) < (fv(r, "us_base") or 0))),
                "loss_avg": round(sum(pings) / len(pings), 2) if pings else None,
                "worst_day": worst["day"] if worst and worst["uncorr"] else None,
                "worst_unc": worst["uncorr"] if worst else 0},
        "days": rows, "ingress": ingress, "exclude_work": bool(exclude_work),
        "excluded": [{"start": time.strftime("%Y-%m-%d %H:%M", time.localtime(w["a"])),
                      "end": time.strftime("%Y-%m-%d %H:%M", time.localtime(w["b"])), "type": w["type"],
                      "note": w["note"], "samples": w["samples"], "t34": w["t34"], "uncorr": w["uncorr"],
                      "down": w["down"], "reb": w["reb"], "rel": w["rel"]} for w in wins],
        "weather": weather_text(weather_effects(summ), "\u00b0F" if (cfg.get("weather_unit") or "C").upper().startswith("F") else "\u00b0C"),
        "outages": [{"start": time.strftime("%Y-%m-%d %H:%M", time.localtime(o["start"])),
                     "mins": round((o["end"] - o["start"]) / 60 + interval / 60), "why": o["why"]} for o in outs][:60],
        "maint": [{"time": m["time"][:16], "end": (m.get("end_time") or "")[:16], "type": m["type"], "note": m["note"],
                   "status": m["status"]} for m in maint],
        "t34": [{"time": e["time"][:16], "type": e["type"], "msg": re.sub(r";?\s*CM-MAC=.*$", "", e["message"])[:200]} for e in events
                if e["type"] in ("T3", "T4")][-40:],
    }
    os.makedirs(cfg["web_dir"], exist_ok=True)
    out = os.path.join(cfg["web_dir"], "summary.html")
    page = SUMMARY_HTML.replace("/*__DATA__*/null", json.dumps(data, separators=(",", ":")).replace("</", "<\\/"))
    with open(out + ".tmp", "w") as f:
        f.write(page)
    os.chmod(out + ".tmp", 0o644)
    os.replace(out + ".tmp", out)
    return out


