</style></head>
<body><div class="viz-root">
<h1 id="h1">Cable modem signal report</h1>
<div class="sub" id="gen"></div>
<div class="bar"><span class="sub">Time range</span><div class="seg" id="rng"></div><span class="sub" style="margin-left:12px">Show data since</span><select id="since"></select></div>
<div class="since" id="sinceBanner"></div>
<div class="tiles" id="tiles"></div>
<div class="mk" id="mk"></div>
