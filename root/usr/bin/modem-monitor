  else{if(sq[0]&&sq[0]<pd)R2.push([Math.round(sq[0]/pd*100),"SQM \u2193","8 3 2 3"]);if(sq[1]&&sq[1]<pu)R2.push([Math.round(sq[1]/pu*100),"SQM \u2191","8 3 2 3"])}
