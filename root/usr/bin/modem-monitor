 if(c.band){const a=c.band[0]!=null?Y(Math.max(lo,Math.min(hi,c.band[0]))):Tp,b=c.band[1]!=null?Y(Math.max(lo,Math.min(hi,c.band[1]))):Tp;
  g+="<rect x="+L+" width="+(W-L-Rr)+" y="+Math.min(a,b)+" height="+Math.abs(a-b)+" fill='var(--band)'/>";
  c.band.forEach(v=>{if(v!=null&&v>=lo&&v<=hi)g+="<line x1="+L+" x2="+(W-Rr)+" y1="+Y(v)+" y2="+Y(v)+" stroke='var(--band-line)' stroke-dasharray='4 3'/>"})}
 const MK=(D.maint||[]).filter(m=>(m.end||m.ts)>=x0&&m.ts<=x1);
