 (D.samples||[]).forEach(r=>{if(r[0]<lo)return;t.polls++;t.failed+=r[1];t.reboots+=r[2];t.relocks+=r[3];t.uncorr+=r[4];if(r[5]!=null)t.us_max=t.us_max==null?r[5]:Math.max(t.us_max,r[5]);if((r[6]||0)>0)t.loss_polls++});
