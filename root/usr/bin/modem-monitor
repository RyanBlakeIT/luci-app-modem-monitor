LOGIN_BACKOFF_S = 1800  # after a failed login, wait 30 min (avoid modem lockout)


LOG_STDERR = "--json" in sys.argv  # keep stdout clean for machine-readable output


def log(msg):
    # stdout -> daemon.info under procd (stderr would show as daemon.err)
    out = sys.stderr if LOG_STDERR else sys.stdout
    out.write("modem-monitor: %s\n" % msg)
    out.flush()


# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------

def load_config():
    cfg = dict(DEFAULTS)
    alt = os.environ.get("MODEM_MONITOR_CONF")
    if alt:  # simple key=value file, used for testing off-router
        with open(alt) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
        return cfg
    try:
        out = subprocess.run(["uci", "-q", "show", "modem_monitor.main"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    for line in out.splitlines():
        m = re.match(r"modem_monitor\.main\.(\w+)=(.*)$", line)
        if m:
            v = m.group(2)
            try:
                v = " ".join(shlex.split(v))  # handles 'a' and list values 'a' 'b'
            except ValueError:
                if len(v) >= 2 and v[0] == v[-1] == "'":
                    v = v[1:-1].replace("'\\''", "'")
            cfg[m.group(1)] = v
    return cfg


def fnum(cfg, key):
    """Numeric setting; empty or invalid values fall back to the default, or 0."""
    for v in (cfg.get(key), DEFAULTS.get(key)):
        try:
            return float(v)
        except (TypeError, ValueError):
            continue
    return 0.0


# --------------------------------------------------------------------------
# State (session, dedup of event log, last counters)
# --------------------------------------------------------------------------

def state_path(cfg):
    return os.path.join(cfg["data_dir"], "state.json")


def load_state(cfg):
    try:
        with open(state_path(cfg)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(cfg, st):
    p = state_path(cfg)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)


# --------------------------------------------------------------------------
# HNAP client for the Arris S33
# --------------------------------------------------------------------------

class ModemError(Exception):
    pass


class AuthError(ModemError):
    pass


class Unreachable(ModemError):
    pass


class S33:
    """HNAP JSON API used by the S33 web UI. Firmware differs in HMAC
    (older MD5, newer SHA-256) and http/https, so both are auto-detected
    and the working combination is remembered in state."""

    def __init__(self, cfg, st):
        self.host = cfg["host"]
        self.user = cfg["username"]
        self.password = cfg["password"]
        self.timeout = fnum(cfg, "timeout")
        self.st = st
        self.ctx = ssl.create_default_context()
        self.ctx.check_hostname = False
        self.ctx.verify_mode = ssl.CERT_NONE

    @staticmethod
    def _hmac(key, msg, algo):
        return hmac.new(key.encode(), msg.encode(), getattr(hashlib, algo)).hexdigest().upper()

    def _auth_header(self, action, algo, pk):
        ts = str(int(time.time() * 1000) % 2000000000000)
        sig = self._hmac(pk or "withoutloginkey", ts + '"%s%s"' % (HNAP_NS, action), algo)
        return "%s %s" % (sig, ts)

    def _post(self, scheme, action, body, algo, uid=None, pk=None):
        base = "%s://%s" % (scheme, self.host)
        headers = {
            "Content-Type": "application/json; charset=UTF-8",
            "Accept": "application/json",
            "SOAPACTION": '"%s%s"' % (HNAP_NS, action),
            "HNAP_AUTH": self._auth_header(action, algo, pk),
            "X-Requested-With": "XMLHttpRequest",
            "Referer": base + ("/Login.html" if action == "Login" else "/Cmconnectionstatus.html"),
        }
        if uid:
            headers["Cookie"] = "uid=%s; PrivateKey=%s" % (uid, pk)
        req = urllib.request.Request(base + "/HNAP1/", data=json.dumps(body).encode(),
                                     headers=headers, method="POST")
        kw = {"timeout": self.timeout}
        if scheme == "https":
            kw["context"] = self.ctx
        try:
            with urllib.request.urlopen(req, **kw) as r:
                raw = r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                raise AuthError("HTTP %d" % e.code)
            raise ModemError("HTTP %d from modem" % e.code)
        except (urllib.error.URLError, OSError) as e:
            raise Unreachable("cannot reach modem at %s (%s)" % (base, getattr(e, "reason", e)))
        try:
            return json.loads(raw)
        except ValueError:
            raise ModemError("modem returned non-JSON (%d bytes)" % len(raw))

    def login(self):
        if not self.password:
            raise AuthError("no modem password set (Status > Cable Modem > Settings)")
        pwtag = hashlib.sha256(("%s:%s" % (self.user, self.password)).encode()).hexdigest()[:16]
        until = self.st.get("login_backoff_until", 0)
        if time.time() < until and self.st.get("login_backoff_pw") == pwtag:
            raise AuthError("login failed earlier; waiting until %s before retrying (avoids lockout)"
                            % datetime.fromtimestamp(until).strftime("%H:%M"))
        schemes = [self.st.get("scheme", "https")]
        schemes += [s for s in ("https", "http") if s not in schemes]
        algos = [self.st.get("algo", "sha256")]
        algos += [a for a in ("sha256", "md5") if a not in algos]
        last_err = None
        rejected = None
        reached = False
        for scheme in schemes:
            for algo in algos:
                got_challenge = False
                try:
                    r = self._post(scheme, "Login", {"Login": {
                        "Action": "request", "Username": self.user, "LoginPassword": "",
                        "Captcha": "", "PrivateLogin": "LoginPassword"}}, algo)
                    reached = True
                    lr = r.get("LoginResponse", {})
                    ch, pub, uid = lr.get("Challenge"), lr.get("PublicKey"), lr.get("Cookie")
                    if not (ch and pub):
                        last_err = AuthError("unexpected login challenge: %s" % json.dumps(lr)[:200])
                        continue
                    got_challenge = True
                    pk = self._hmac(pub + self.password, ch, algo)
                    lp = self._hmac(pk, ch, algo)
                    r = self._post(scheme, "Login", {"Login": {
                        "Action": "login", "Username": self.user, "LoginPassword": lp,
                        "Captcha": "", "PrivateLogin": "LoginPassword"}}, algo, uid, pk)
                    res = r.get("LoginResponse", {}).get("LoginResult")
                    if res == "OK":
                        self.st.update(scheme=scheme, algo=algo, uid=uid, private_key=pk)
                        self.st.pop("login_backoff_until", None)
                        return
                    rejected = AuthError("modem rejected login (%s)" % res)
                except Unreachable as e:
                    last_err = e
                    break  # nothing listening on this scheme; try the next one
                except ModemError as e:
                    reached = True
                    last_err = e
                    if got_challenge and not rejected:
                        rejected = AuthError("modem rejected login (%s)" % e)
        if reached:
            self.st["login_backoff_until"] = time.time() + LOGIN_BACKOFF_S
            self.st["login_backoff_pw"] = pwtag
            raise AuthError("login failed - check the modem password (%s)" % (rejected or last_err))
        raise last_err or ModemError("cannot reach modem")

    def call(self, actions):
        """GetMultipleHNAPs with session reuse; logs in again if the session expired."""
        body = {"GetMultipleHNAPs": {a: "" for a in actions}}
        for attempt in (0, 1):
            if not self.st.get("uid") or attempt == 1:
                self.login()
            try:
                r = self._post(self.st["scheme"], "GetMultipleHNAPs", body,
                               self.st["algo"], self.st["uid"], self.st["private_key"])
            except Unreachable:
                raise
            except ModemError:
                # Stale session (e.g. after a modem reboot) may come back as
                # 401/403/404/500 depending on firmware: log in again once.
                self.st.pop("uid", None)
                continue
            # Some firmware omits the GetMultipleHNAPsResponse wrapper.
            resp = r.get("GetMultipleHNAPsResponse") or r
            if any(a + "Response" in resp for a in actions) \
                    and str(resp.get("GetMultipleHNAPsResult", "OK")).upper() == "OK":
                return resp
            self.st.pop("uid", None)  # session expired / UN-AUTH
        raise AuthError("modem refused the status request after re-login")




def _s33_set(self, action, payload):
    """One HNAP Set action. Re-login only on an auth refusal, so a command is
    never sent twice."""
    for attempt in (0, 1):
        if not self.st.get("uid") or attempt == 1:
            self.login()
        try:
            return self._post(self.st["scheme"], action, {action: payload},
                              self.st["algo"], self.st["uid"], self.st["private_key"])
        except AuthError:
            self.st.pop("uid", None)
    raise AuthError("modem refused %s after re-login" % action)


S33.set = _s33_set


# --------------------------------------------------------------------------
# Parsing
# --------------------------------------------------------------------------

NUM_RE = re.compile(r"-?\d+(?:\.\d+)?")


def num(s):
    m = NUM_RE.search(str(s or ""))
    return float(m.group(0)) if m else None


def mhz(s):
    v = num(s)
    if v is None:
        return None
    return round(v / 1e6, 3) if v > 100000 else v


def parse_downstream(raw):
    out = []
    for e in (raw or "").split("|+|"):
        f = e.split("^")
        if len(f) < 9:
            continue
        out.append({"ch": f[3].strip() or f[0].strip(), "lock": f[1].strip(), "mod": f[2].strip(),
                    "freq": mhz(f[4]), "power": num(f[5]), "snr": num(f[6]),
                    "corr": int(num(f[7]) or 0), "uncorr": int(num(f[8]) or 0)})
    return out


def parse_upstream(raw):
    out = []
    for e in (raw or "").split("|+|"):
        f = e.split("^")
        if len(f) < 7:
            continue
        out.append({"ch": f[3].strip() or f[0].strip(), "lock": f[1].strip(), "mod": f[2].strip(),
                    "width": mhz(f[4]), "freq": mhz(f[5]), "power": num(f[6])})
    return out


UPTIME_RE = re.compile(r"(?:(\d+)\s*day[^\d]*)?(\d+)\s*h\s*:?\s*(\d+)\s*m\s*:?\s*(\d+)\s*s", re.I)


def parse_uptime(resp):
    for v in (resp or {}).values():
        m = UPTIME_RE.search(str(v))
        if m:
            d, h, mi, s = (int(x or 0) for x in m.groups())
            return d * 86400 + h * 3600 + mi * 60 + s
    return None


DATE_RE = re.compile(r"^\d{1,2}/\d{1,2}/\d{2,4}$")
TIME_RE = re.compile(r"^\d{1,2}:\d{2}(:\d{2})?$")


def parse_events(resp):
    raw = ""
    for k, v in (resp or {}).items():
        if isinstance(v, str) and "^" in v and len(v) > len(raw):
            raw = v
    out = []
    for e in re.split(r"\}-\{|\|\+\|", raw):
        f = [x.strip() for x in e.strip("{} \n").split("^")]
        f = [x for x in f if x != ""]
        if not f:
            continue
        date = next((x for x in f if DATE_RE.match(x)), "")
        tm = next((x for x in f if TIME_RE.match(x)), "")
        msg = max(f, key=len)
        rest = f[1:] if len(f) >= 4 else f
        prio = next((x for x in reversed(rest) if x.isdigit() and len(x) == 1), "")
        out.append({"date": date, "time": tm, "prio": prio, "msg": msg})
    return out


def _parse_dt(ev):
    d, m, y = (int(x) for x in ev["date"].split("/"))
    if y < 100:
        y += 2000
    hh, mm, *ss = (int(x) for x in (ev["time"] or "0:0").split(":"))
    return datetime(y, m, d, hh, mm, ss[0] if ss else 0)


def boot_offset(ev):
    """Seconds since boot for entries logged before the modem set its clock
    (shown as 31/12/1969 19:00:xx or 1/1/1970 00:00:xx). None if dated."""
    try:
        t = _parse_dt(ev)
    except (ValueError, KeyError):
        return None
    if t.year >= 2020:
        return None
    # The modem shows its clock-not-set epoch either in local time
    # (31/12/1969 19:00 in US Eastern) or in UTC (1/1/1970 00:00), and can switch
    # after a reboot. Use whichever reading gives the smallest offset.
    return _boot_offset_from(t)


def _boot_offset_from(t):
    offs = [int((t - base).total_seconds()) for base in (
        datetime(1970, 1, 1, 0, 0, 0) - timedelta(seconds=_utc_offset()),  # local rendering
        datetime(1970, 1, 1, 0, 0, 0),                                      # UTC rendering
        datetime(1969, 12, 31, 19, 0, 0))]                                  # US Eastern
    offs = [o for o in offs if 0 <= o < 7 * 86400]
    return min(offs) if offs else 0


def _old_boot_offset(ev):
    """The pre-1.1.3 calculation, used to repair timestamps it produced."""
    t = _parse_dt(ev)
    for base in (datetime(1969, 12, 31, 19, 0, 0), datetime(1970, 1, 1, 0, 0, 0)):
        off = (t - base).total_seconds()
        if 0 <= off < 7 * 86400:
            return int(off)
    return 0


def _utc_offset():
    """Router's current offset from UTC in seconds (e.g. -18000 for EST)."""
    return time.localtime().tm_gmtoff or 0


MODEM_TIME_FORMATS = ("%a %b %d %H:%M:%S %Y", "%a %b %d %H:%M:%S %Z %Y", "%Y-%m-%d %H:%M:%S",
                      "%d/%m/%Y %H:%M:%S", "%m/%d/%Y %H:%M:%S", "%Y/%m/%d %H:%M:%S",
                      "%a, %d %b %Y %H:%M:%S", "%d %b %Y %H:%M:%S")


def _try_ts(ev):
    try:
        return _parse_dt(ev).timestamp()
    except (ValueError, KeyError):
        return 0


def modem_clock_offset(conninfo, now):
    """Seconds the modem's displayed clock runs ahead of the router's local
    clock (0 = local time, +18000 = UTC while the router is on EST), rounded to
    15 minutes. None if the modem doesn't report a readable time."""
    for k, v in (conninfo or {}).items():
        if not isinstance(v, str) or "time" not in k.lower() or "up" in k.lower():
            continue
        txt = " ".join(v.replace("\xa0", " ").split())
        for f in MODEM_TIME_FORMATS:
            try:
                t = datetime.strptime(txt, f)
            except ValueError:
                continue
            if t.year < 2020:
                return None  # clock not set yet
            off = time.mktime(t.timetuple()) - now
            off = int(round(off / 900.0) * 900)
            return off if abs(off) <= 14 * 3600 else None
    return None


def event_ts(ev, fallback, boot_ts=None, clock_offset=0):
    """Modem log date is D/M/YYYY in the modem's display clock, which may be
    local time or UTC (clock_offset). Entries from before the modem's clock was
    set are placed at boot time + offset (boot time comes from uptime)."""
    off = boot_offset(ev)
    if off is not None:
        return int(boot_ts + off) if boot_ts else int(fallback)
    try:
        t = _parse_dt(ev).timestamp() - (clock_offset or 0)
        return int(min(t, fallback))
    except (ValueError, KeyError):
        return int(fallback)


def event_key(ev, boot_ts, clock_offset=0, fallback=0):
    """Identify an entry by its real moment + message, so the same entry shown
    in a different clock format (local vs UTC) isn't stored twice."""
    return "%d|%s" % (event_ts(ev, fallback, boot_ts, clock_offset), ev["msg"])


def migrate_113(cfg, st, clock_offset):
    """Repair events.csv written before 1.1.3: pre-clock entries shown as
    1/1/1970 were placed hours late, and entries re-rendered in UTC after a
    modem reboot were stored twice. Re-key the seen-list by real time."""
    if st.get("migrated_113"):
        return
    path = os.path.join(cfg["data_dir"], "events.csv")
    rows = []
    if os.path.exists(path):
        with open(path, newline="") as f:
            rows = list(csv.DictReader(f))
    now = time.time()
    utc_shift = -_utc_offset()  # how far a UTC rendering runs ahead of local
    for r in rows:
        ev = {"date": r.get("modem_date", ""), "time": r.get("modem_time", ""), "msg": r.get("message", "")}
        try:
            t = _parse_dt(ev)
        except (ValueError, KeyError):
            continue
        ts = int(r["ts"])
        if t.year < 2020:
            ts = ts - _old_boot_offset(ev) + _boot_offset_from(t)
        elif ts > now + 600:
            ts -= clock_offset if clock_offset else utc_shift  # future = UTC-rendered
        r["ts"] = ts
        r["type"] = classify(ev["msg"])
    # Drop UTC re-renderings of entries already stored in local time, then exact duplicates
    have = {(int(r["ts"]), r["message"]) for r in rows}
    keep, seen = [], set()
    for r in sorted(rows, key=lambda x: int(x["ts"])):
        ts, msg = int(r["ts"]), r["message"]
        dated = not r.get("modem_date", "").endswith(("1969", "1970"))
        if dated and utc_shift and any((ts - utc_shift + d, msg) in have for d in (-2, -1, 0, 1, 2)):
            continue
        if (ts, msg) in seen:
            continue
        seen.add((ts, msg))
        r["time"] = _fmt(ts)
        keep.append(r)
    if rows:
        tmp = path + ".tmp"
        with open(tmp, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=EVENT_COLS, extrasaction="ignore")
            w.writeheader()
            w.writerows(keep)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
        log("repaired event log: %d entries kept, %d duplicates or mis-timed copies removed"
            % (len(keep), len(rows) - len(keep)))
    st["seen_events"] = ["%d|%s" % (int(r["ts"]), r["message"]) for r in keep][-3000:]
    st["migrated_113"] = 1


def migrate_102(cfg, st, boot_ts):
    """v1.0.1 stamped pre-clock entries with the time they were first read.
    Re-stamp them from the boot time and re-key them (current boot assumed)."""
    if st.get("migrated_102") or not boot_ts:
        return
    path = os.path.join(cfg["data_dir"], "events.csv")
    if os.path.exists(path):
        with open(path, newline="") as f:
            rows = list(csv.DictReader(f))
        changed = 0
        for r in rows:
            ev = {"date": r.get("modem_date", ""), "time": r.get("modem_time", ""), "msg": r.get("message", "")}
            if boot_offset(ev) is not None:
                ts = event_ts(ev, int(r["ts"]), boot_ts)
                r["ts"], r["time"] = ts, time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts))
                r["type"] = classify(r["message"])
                changed += 1
            else:
                r["type"] = classify(r.get("message", ""))
        tmp = path + ".tmp"
        with open(tmp, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=EVENT_COLS, extrasaction="ignore")
            w.writeheader()
            w.writerows(rows)
        os.replace(tmp, path)
        log("re-stamped %d pre-clock log entries from modem boot time" % changed)
    seen = st.get("seen_events", [])
    new = []
    for k in seen:
        parts = k.split("|", 2)
        if len(parts) == 3 and not k.startswith("boot"):
            ev = {"date": parts[0], "time": parts[1], "msg": parts[2]}
            k = event_key(ev, boot_ts)
        new.append(k)
    st["seen_events"] = new
    st["migrated_102"] = 1


def classify(msg):
    m = msg.lower()
    if "t3 time" in m or "t3 timeout" in m:
        return "T3"
    if "t4 time" in m or "t4 timeout" in m:
        return "T4"
    if "dhcp failed" in m or "tftp failed" in m or "tod request" in m or "reg rsp not received" in m:
        return "PROVISION"
    if "dynamic range window" in m or "top of the drw" in m:
        return "DRW"
    if "diplexer" in m or "honoring mdd" in m:
        return "INFO"
    if "sync" in m or "mdd" in m or "lost" in m:
        return "SYNC"
    if "webgui login" in m or "login from" in m:
        return "LOGIN"
    return "OTHER"


# --------------------------------------------------------------------------
# Ping
# --------------------------------------------------------------------------

def ping(target, count):
    try:
        out = subprocess.run(["ping", "-c", str(count), "-W", "2", target],
                             capture_output=True, text=True, timeout=count * 3 + 5).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None, None
    loss = re.search(r"(\d+(?:\.\d+)?)% packet loss", out)
    rtt = re.search(r"= ([\d.]+)/([\d.]+)/([\d.]+)", out)
    return (float(loss.group(1)) if loss else 100.0,
            float(rtt.group(2)) if rtt else None,
            float(rtt.group(3)) if rtt else None)


# --------------------------------------------------------------------------
# Modem drivers. Every driver offers:
#   status() -> {"ds": [...], "us": [...], "uptime": s|None, "conninfo": {...}}
#   events() -> [{"date": "D/M/YYYY", "time": "HH:MM:SS", "prio": "", "msg": ""}]
#   info()   -> {"model", "firmware", "hardware"}
#   reboot(cfg) -> outcome text   (raise ModemError if unsupported)
# Channel dicts: ch, lock, mod, freq (MHz), power, snr, corr, uncorr (down);
#                ch, lock, mod, width, freq, power (up).
# --------------------------------------------------------------------------

def _s33_status(self):
    resp = self.call(["GetCustomerStatusDownstreamChannelInfo", "GetCustomerStatusUpstreamChannelInfo",
                      "GetCustomerStatusConnectionInfo"])
    conn = resp.get("GetCustomerStatusConnectionInfoResponse")
    return {"ds": parse_downstream(resp.get("GetCustomerStatusDownstreamChannelInfoResponse", {})
                                   .get("CustomerConnDownstreamChannel")),
            "us": parse_upstream(resp.get("GetCustomerStatusUpstreamChannelInfoResponse", {})
                                 .get("CustomerConnUpstreamChannel")),
            "uptime": parse_uptime(conn), "conninfo": conn}


def _s33_events(self):
    return parse_events(self.call(["GetCustomerStatusLog"]).get("GetCustomerStatusLogResponse", {}))


def _s33_info(self):
    sw = self.call(["GetCustomerStatusSoftware"]).get("GetCustomerStatusSoftwareResponse", {})
    return {"model": sw.get("StatusSoftwareModelName", ""), "firmware": sw.get("StatusSoftwareSfVer", ""),
            "hardware": sw.get("StatusSoftwareHdVer", "")}


def _s33_reboot(self, cfg):
    eee, led = cfg.get("modem_eee", "0"), cfg.get("modem_led", "1")
    try:
        info = self.call(["GetArrisConfigurationInfo"]).get("GetArrisConfigurationInfoResponse", {})
        for k, v in info.items():
            kl = k.lower()
            if isinstance(v, (str, int)) and "result" not in kl:
                if "eee" in kl:
                    eee = str(v)
                elif "led" in kl:
                    led = str(v)
    except ModemError as e:
        log("could not read current EEE/LED settings (%s); using configured %s/%s" % (e, eee, led))
    r = self.set("SetArrisConfigurationInfo", {"Action": "reboot", "SetEEEEnable": eee, "LED_Status": led})
    res = (r.get("SetArrisConfigurationInfoResponse") or {}).get("SetArrisConfigurationInfoResult", "")
    if str(res).upper() not in ("OK", "REBOOT", ""):
        raise ModemError("modem answered %r to the reboot request" % res)
    return "modem accepted the reboot (%s)" % (res or "no result field")


S33.status, S33.events, S33.info, S33.reboot = _s33_status, _s33_events, _s33_info, _s33_reboot
S33.label = "Arris/CommScope SURFboard with HNAP web UI (S33, S34)"
S33.can_reboot = True


class _Table(__import__("html.parser").parser.HTMLParser):
    """Collects every <table> as a list of rows of cell text."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.tables, self._stack, self._cell = [], [], None
        self.text = []

    def handle_starttag(self, tag, attrs):
        if tag == "table":
            self._stack.append([])
        elif tag == "tr" and self._stack:
            self._stack[-1].append([])
        elif tag in ("td", "th") and self._stack:
            self._cell = []

    def handle_endtag(self, tag):
        if tag in ("td", "th") and self._cell is not None and self._stack and self._stack[-1]:
            self._stack[-1][-1].append(" ".join("".join(self._cell).split()))
            self._cell = None
        elif tag == "table" and self._stack:
            self.tables.append(self._stack.pop())

    def handle_data(self, d):
        if self._cell is not None:
            self._cell.append(d)
        self.text.append(d)


def html_tables(page):
    p = _Table()
    p.feed(page)
    return p.tables, " ".join(" ".join(p.text).split())


def _col(header, *names):
    h = [x.lower() for x in header]
    for n in names:
        for i, x in enumerate(h):
            if x == n:
                return i
    for n in names:
        for i, x in enumerate(h):
            if n in x:
                return i
    return None


def _find_table(tables, must):
    """First table with a row containing all `must` words (case-insensitive);
    returns (header_row, data_rows)."""
    for t in tables:
        for i, row in enumerate(t):
            low = [c.lower() for c in row]
            if all(any(m in c for c in low) for m in must):
                return row, [r for r in t[i + 1:] if len(r) >= len(row) - 1 and any(c.strip() for c in r)]
    return None, []


def _mdy_to_dmy(s):
    m = re.match(r"(\d{1,2})/(\d{1,2})/(\d{2,4})", s or "")
    if not m:
        return ""
    a, b, y = int(m.group(1)), int(m.group(2)), m.group(3)
    mo, d = (b, a) if a > 12 else (a, b)  # US pages: M/D/YYYY
    return "%d/%d/%s" % (d, mo, y)


MONTHS = {m: i for i, m in enumerate(("jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"), 1)}


def _norm_event_time(s):
    """'11/25/2026 13:06', 'Wed Nov 25 13:06:56 2026', 'Time Not Established' -> (D/M/YYYY, HH:MM:SS)."""
    s = (s or "").strip()
    m = re.search(r"(\d{1,2}/\d{1,2}/\d{2,4})\s+(\d{1,2}:\d{2}(?::\d{2})?)", s)
    if m:
        t = m.group(2) if m.group(2).count(":") == 2 else m.group(2) + ":00"
        return _mdy_to_dmy(m.group(1)), t
    m = re.search(r"([A-Za-z]{3})\s+(\d{1,2})\s+(\d{1,2}:\d{2}:\d{2})\s+(\d{4})", s)
    if m and m.group(1).lower() in MONTHS:
        return "%d/%d/%s" % (int(m.group(2)), MONTHS[m.group(1).lower()], m.group(4)), m.group(3)
    return "1/1/1970", "00:00:00"  # not established yet: placed at boot time


class _HttpModem:
    """Shared plumbing for modems with a plain HTML status page."""
    can_reboot = False

    def __init__(self, cfg, st):
        self.host = cfg["host"]
        self.user = cfg.get("username") or "admin"
        self.password = cfg.get("password") or ""
        self.timeout = fnum(cfg, "timeout")
        self.st = st
        self.ctx = ssl.create_default_context()
        self.ctx.check_hostname = False
        self.ctx.verify_mode = ssl.CERT_NONE

    def _get(self, path, headers=None, scheme=None):
        schemes = [scheme] if scheme else [self.st.get("html_scheme") or "https", "http"]
        last = None
        for sc in dict.fromkeys(schemes):
            url = "%s://%s%s" % (sc, self.host, path)
            req = urllib.request.Request(url, headers=dict({"User-Agent": "Mozilla/5.0 modem-monitor"}, **(headers or {})))
            try:
                with urllib.request.urlopen(req, timeout=self.timeout, context=self.ctx if sc == "https" else None) as r:
                    self.st["html_scheme"] = sc
                    return r.read().decode("utf-8", "replace")
            except urllib.error.HTTPError as e:
                if e.code in (401, 403):
                    raise AuthError("HTTP %d on %s" % (e.code, path))
                last = ModemError("HTTP %d on %s" % (e.code, path))
                if e.code == 404:
                    raise last
            except (urllib.error.URLError, OSError) as e:
                last = Unreachable("cannot reach modem at %s (%s)" % (url, getattr(e, "reason", e)))
        raise last

    def reboot(self, cfg):
        raise ModemError("rebooting from the router isn't supported for this modem model yet; use the modem's web page")


class ArrisHTML(_HttpModem):
    """Arris/CommScope SURFboard models with HTML status pages: SB8200, SB6183,
    SB6190, SB8200v3 and similar (newer SB8200 firmware needs a login)."""
    label = "Arris/CommScope SURFboard with HTML status pages (SB8200, SB6183, SB6190)"
    PAGES = {"status": ("/cmconnectionstatus.html", "/RgConnect.asp"),
             "info": ("/cmswinfo.html", "/RgSwInfo.asp"),
             "log": ("/cmeventlog.html", "/RgEventLog.asp")}

    def _page(self, kind):
        last = None
        for p in self.PAGES[kind]:
            if self.st.get("html_pages", {}).get(kind) not in (None, p):
                continue
            try:
                body = self._authed(p)
                self.st.setdefault("html_pages", {})[kind] = p
                return body
            except ModemError as e:
                last = e
                if isinstance(e, (AuthError, Unreachable)):
                    raise
        self.st.get("html_pages", {}).pop(kind, None)
        raise last or ModemError("no %s page" % kind)

    def _authed(self, path):
        tok = self.st.get("html_token")
        if tok:
            body = self._get("%s?ct_%s" % (path, tok), {"Cookie": "credential=%s" % tok})
            if "login" not in body.lower()[:3000] or "channel" in body.lower():
                return body
            self.st.pop("html_token", None)
        try:
            body = self._get(path)
        except AuthError:
            body = ""
        low = body.lower()
        if body and not ("password" in low and "login" in low and "channel" not in low):
            return body
        if not self.password:
            raise AuthError("this modem needs its password (set it in Settings)")
        import base64
        cred = base64.b64encode(("%s:%s" % (self.user, self.password)).encode()).decode()
        tok = self._get("%s?login_%s" % (path, cred), {"Authorization": "Basic " + cred}).strip()
        if not tok or len(tok) > 200 or "<" in tok:
            raise AuthError("modem refused the login")
        self.st["html_token"] = tok
        return self._get("%s?ct_%s" % (path, tok), {"Cookie": "credential=%s" % tok})

    def status(self):
        tables, text = html_tables(self._page("status"))
        hd, rows = _find_table(tables, ["channel", "power", "uncorrect"])
        ds = []
        if hd:
            c = {k: _col(hd, *n) for k, n in {"ch": ("channel id", "channel"), "lock": ("lock status",),
                                               "mod": ("modulation",), "freq": ("frequency",), "power": ("power",),
                                               "snr": ("snr/mer", "snr"), "corr": ("corrected",),
                                               "uncorr": ("uncorrectables", "uncorrectable")}.items()}
            for r in rows:
                g = lambda k: r[c[k]] if c[k] is not None and c[k] < len(r) else ""
                if not g("freq"):
                    continue
                ds.append({"ch": g("ch"), "lock": g("lock"), "mod": g("mod"), "freq": mhz(g("freq")),
                           "power": num(g("power")), "snr": num(g("snr")), "corr": int(num(g("corr")) or 0),
                           "uncorr": int(num(g("uncorr")) or 0)})
        hu, rows = _find_table(tables, ["channel", "power", "width"])
        if not hu:
            hu, rows = _find_table(tables, ["channel", "power", "symbol"])
        us = []
        if hu:
            c = {k: _col(hu, *n) for k, n in {"ch": ("channel id",), "lock": ("lock status",),
                                               "mod": ("us channel type", "channel type", "modulation"),
                                               "freq": ("frequency",), "width": ("width",), "power": ("power",)}.items()}
            for r in rows:
                g = lambda k: r[c[k]] if c[k] is not None and c[k] < len(r) else ""
                if not g("freq"):
                    continue
                us.append({"ch": g("ch"), "lock": g("lock"), "mod": g("mod"), "width": mhz(g("width")),
                           "freq": mhz(g("freq")), "power": num(g("power"))})
        conn = {}
        m = re.search(r"Current System Time:?\s*([A-Za-z]{3} [A-Za-z]{3} +\d+ [\d:]+ \d{4})", text)
        if m:
            conn["CustomerCurSystemTime"] = m.group(1)
        up = None
        m = UPTIME_RE.search(text)
        if m:
            up = parse_uptime({"x": m.group(0)})
        else:
            try:
                up = parse_uptime({"x": html_tables(self._page("info"))[1]})
            except ModemError:
                pass
        return {"ds": ds, "us": us, "uptime": up, "conninfo": conn}

    def events(self):
        tables, _ = html_tables(self._page("log"))
        hd, rows = _find_table(tables, ["time", "description"])
        if not hd:
            return []
        ct, cl, cd = _col(hd, "date time", "time"), _col(hd, "event level", "level", "priority"), _col(hd, "description")
        out = []
        for r in rows:
            if cd is None or cd >= len(r):
                continue
            d, t = _norm_event_time(r[ct] if ct is not None and ct < len(r) else "")
            out.append({"date": d, "time": t, "prio": "".join(ch for ch in (r[cl] if cl is not None and cl < len(r) else "") if ch.isdigit())[:1],
                        "msg": r[cd]})
        return list(reversed(out)) if len(out) > 1 and _try_ts(out[0]) > _try_ts(out[-1]) else out

    def info(self):
        tables, text = html_tables(self._page("info"))
        g = lambda rx: (re.search(rx, text, re.I) or [None, ""])[1].strip()
        model = g(r"\b(SB\d{4}v?\d?|S3\dv?\d?)\b")
        if not model:
            st_tables, st_text = html_tables(self._page("status"))
            model = (re.search(r"\b(SB\d{4}v?\d?)\b", st_text) or [None, ""])[1]
        return {"model": model, "firmware": g(r"Software Version:?\s*(\S+)"),
                "hardware": g(r"Hardware Version:?\s*(\S+)")}


class NetgearCM(_HttpModem):
    """Netgear cable modems (CM500, CM600, CM700, CM1000, CM1100, CM1200, CM2000,
    CM3000). The status page embeds its tables as '|'-separated JavaScript strings."""
    label = "Netgear CM series (CM600 through CM3000)"

    def _status_page(self):
        import base64
        cred = base64.b64encode(("%s:%s" % (self.user or "admin", self.password)).encode()).decode()
        last = None
        for p in ("/DocsisStatus.htm", "/DocsisStatus.asp"):
            try:
                body = self._get(p, {"Authorization": "Basic " + cred}, scheme=self.st.get("html_scheme") or "http")
            except ModemError as e:
                last = e
                if isinstance(e, (AuthError, Unreachable)):
                    raise
                continue
            if "tagValueList" in body:
                return body
            if "login" in body.lower():
                raise AuthError("the modem shows a login form (newer Netgear firmware); not supported yet, please open an issue")
        raise last or ModemError("no Netgear status page found")

    @staticmethod
    def _lists(body):
        out = {}
        for fn, val in re.findall(r"function\s+(\w+)\s*\([^)]*\)\s*\{[^}]*?var\s+tagValueList\s*=\s*['\"]([^'\"]*)['\"]", body, re.S):
            out[fn] = [v.strip() for v in val.split("|")]
        return out

    @staticmethod
    def _rows(vals):
        if not vals or not vals[0].isdigit():
            return []
        n = int(vals[0])
        body = [v for v in vals[1:]]
        while body and body[-1] == "":
            body.pop()
        if n <= 0 or len(body) < n:
            return []
        w = len(body) // n
        return [body[i * w:(i + 1) * w] for i in range(n)]

    def status(self):
        body = self._status_page()
        L = self._lists(body)
        ds, us = [], []
        for r in self._rows(L.get("InitDsTableTagValue")):
            # num | lock | modulation | channel id | freq | power | snr | corrected | uncorrectable
            if len(r) >= 9:
                ds.append({"ch": r[3], "lock": r[1], "mod": r[2], "freq": mhz(r[4]), "power": num(r[5]),
                           "snr": num(r[6]), "corr": int(num(r[7]) or 0), "uncorr": int(num(r[8]) or 0)})
        for r in self._rows(L.get("InitDsOfdmTableTagValue")):
            # num | lock | profile | channel id | freq | power | snr | subcarriers | unerrored | corrected | uncorrectable
            if len(r) >= 11 and r[1].strip().lower() == "locked":
                ds.append({"ch": r[3], "lock": r[1], "mod": "OFDM", "freq": mhz(r[4]), "power": num(r[5]),
                           "snr": num(r[6]), "corr": int(num(r[9]) or 0), "uncorr": int(num(r[10]) or 0)})
        for r in self._rows(L.get("InitUsTableTagValue")):
            # num | lock | type | channel id | symbol rate | freq | power
            if len(r) >= 7:
                us.append({"ch": r[3], "lock": r[1], "mod": r[2], "width": None, "freq": mhz(r[5]), "power": num(r[6])})
        for r in self._rows(L.get("InitUsOfdmaTableTagValue")):
            if len(r) >= 6 and r[1].strip().lower() == "locked":
                us.append({"ch": r[3], "lock": r[1], "mod": "OFDMA", "width": None, "freq": mhz(r[4]), "power": num(r[5])})
        text = " ".join(L.get("InitTagValue", [])) + " " + re.sub(r"<[^>]+>", " ", body)
        up = None
        m = re.search(r"(\d+)\s*days?\s*(\d{1,2}):(\d{2}):(\d{2})", text) or None
        if m:
            d, h, mi, s = (int(x) for x in m.groups())
            up = d * 86400 + h * 3600 + mi * 60 + s
        else:
            up = parse_uptime({"x": text})
        conn = {}
        m = re.search(r"([A-Za-z]{3} [A-Za-z]{3} +\d+ [\d:]+ \d{4})", text)
        if m:
            conn["CustomerCurSystemTime"] = m.group(1)
        return {"ds": ds, "us": us, "uptime": up, "conninfo": conn}

    def events(self):
        raise ModemError("the event log isn't read on Netgear modems yet")

    def info(self):
        body = self._status_page()
        m = re.search(r"\b(CM\d{3,4}v?\d?)\b", body)
        fw = re.search(r"V\d+\.\d+\.\d+\.\d+[\w.]*", body)
        return {"model": "Netgear " + m.group(1) if m else "Netgear", "firmware": fw.group(0) if fw else "", "hardware": ""}


DRIVERS = {"s33": S33, "arris_html": ArrisHTML, "netgear": NetgearCM}


def make_driver(cfg, st):
    """modem_type: auto (default), s33, arris_html, netgear. Auto keeps a working
    S33 session, otherwise looks at the modem's front page once and remembers."""
    t = (cfg.get("modem_type") or "auto").strip()
    if t in DRIVERS:
        return DRIVERS[t](cfg, st)
    if st.get("driver") in DRIVERS:
        return DRIVERS[st["driver"]](cfg, st)
    if st.get("scheme") and st.get("algo"):  # a working HNAP login already exists
        st["driver"] = "s33"
        return S33(cfg, st)
    probe = _HttpModem(cfg, st)
    guess = None
    for path in ("/", "/Login.html"):
        try:
            low = probe._get(path).lower()
        except AuthError:
            continue
        except ModemError:
            continue
        if "hnap" in low or "surfboard central" in low or "soapaction" in low:
            guess = "s33"
        elif "netgear" in low:
            guess = "netgear"
        elif "cmconnectionstatus" in low or "rgconnect" in low or "sb8200" in low or "sb6183" in low or "sb6190" in low:
            guess = "arris_html"
        if guess:
            break
    st.pop("html_scheme", None)
    if guess:
        st["driver"] = guess
        log("modem type detected: %s" % DRIVERS[guess].label)
    return DRIVERS[guess or "s33"](cfg, st)

# --------------------------------------------------------------------------
# Router <-> modem Ethernet link (WAN NIC counters)
# --------------------------------------------------------------------------

LINK_COLS = ["ts", "time", "dev", "operstate", "speed", "duplex", "carrier_changes",
             "rx_errors", "tx_errors", "rx_crc_errors", "rx_frame_errors", "rx_missed",
             "rx_dropped", "align_errors", "collisions", "tx_underrun",
             "err_delta", "missed_delta", "link_drops", "speed_changed"]
# Counters whose increase means a physical/link problem (rx_dropped excluded:
# Linux counts unhandled protocols such as LLDP there).
ERR_KEYS = ("rx_errors", "tx_errors", "rx_missed", "collisions", "tx_underrun")
LINK_ERR_KEYS = ("rx_errors", "tx_errors", "collisions", "tx_underrun", "align_errors")


def wan_device(cfg):
    if cfg.get("wan_device"):
        return cfg["wan_device"]
    try:
        out = subprocess.run(["ifstatus", "wan"], capture_output=True, text=True, timeout=10).stdout
        j = json.loads(out)
        return j.get("l3_device") or j.get("device")
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    try:
        return subprocess.run(["uci", "-q", "get", "network.wan.device"], capture_output=True,
                              text=True, timeout=10).stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def _int(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def link_sample(cfg, st, now, stamp):
    dev = wan_device(cfg)
    if not dev or not os.path.isdir("/sys/class/net/%s" % dev):
        return None
    base = "/sys/class/net/%s/" % dev
    stats = lambda k: _int(_read(base + "statistics/" + k))
    r = {"ts": int(now), "time": stamp, "dev": dev,
         "operstate": _read(base + "operstate"),
         "speed": _int(_read(base + "speed")), "duplex": _read(base + "duplex"),
         "carrier_changes": _int(_read(base + "carrier_changes")),
         "rx_errors": stats("rx_errors"), "tx_errors": stats("tx_errors"),
         "rx_crc_errors": stats("rx_crc_errors"), "rx_frame_errors": stats("rx_frame_errors"),
         "rx_missed": stats("rx_missed_errors"), "rx_dropped": stats("rx_dropped"),
         "collisions": stats("collisions"), "align_errors": None, "tx_underrun": None}
    # NIC-specific counters (r8169: rx_missed, align_errors, tx_underrun, ...)
    try:
        out = subprocess.run(["ethtool", "-S", dev], capture_output=True, text=True, timeout=10).stdout
        e = {}
        for line in out.splitlines():
            m = re.match(r"\s*([\w.\-]+):\s*(\d+)\s*$", line)
            if m:
                e[m.group(1)] = int(m.group(2))
        if "rx_missed" in e:
            r["rx_missed"] = max(r["rx_missed"] or 0, e["rx_missed"])
        r["align_errors"] = e.get("align_errors")
        r["tx_underrun"] = e.get("tx_underrun")
        col = e.get("tx_single_collisions", 0) + e.get("tx_multi_collisions", 0)
        if col:
            r["collisions"] = max(r["collisions"] or 0, col)
    except (OSError, subprocess.SubprocessError):
        pass

    boot_id = _read("/proc/sys/kernel/random/boot_id")
    prev = st.get("link_prev") or {}
    if prev.get("dev") != dev or prev.get("boot_id") != boot_id:
        prev = {}  # new device or router rebooted: counters restarted, no deltas
    def delta(keys):
        d = 0
        for k in keys:
            cur, old = r.get(k), prev.get(k)
            if cur is None or old is None:
                continue
            d += cur - old if cur >= old else cur  # counter reset -> count from zero
        return d if prev else 0
    # Cable/port faults vs NIC receive overruns (router CPU/buffer, not the cable)
    r["err_delta"] = delta(LINK_ERR_KEYS)
    r["missed_delta"] = delta(("rx_missed",))
    cc, oc = r["carrier_changes"], prev.get("carrier_changes")
    r["link_drops"] = (cc - oc + 1) // 2 if cc is not None and oc is not None and cc >= oc else 0
    r["speed_changed"] = 1 if prev and r["speed"] != prev.get("speed") else 0
    st["link_prev"] = {k: r.get(k) for k in ("dev", "speed", "carrier_changes", "align_errors") + ERR_KEYS}
    st["link_prev"]["boot_id"] = boot_id
    return r


# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------

SUMMARY_COLS = ["ts", "time", "ok", "error", "uptime_s", "rebooted", "relock",
                "ds_count", "ds_locked", "ds_power_min", "ds_power_max", "ds_snr_min", "ds_snr_avg",
                "corr_total", "uncorr_total", "uncorr_delta",
                "us_count", "us_locked", "us_power_min", "us_power_max",
                "ping_loss", "ping_avg_ms", "ping_max_ms", "ds_power_avg", "us_power_avg",
                "gw_loss", "gw_avg_ms", "temp", "precip",
                "hr_sent", "hr_loss", "hr_avg", "hr_p95", "hr_max", "hr_jitter", "hr_drops", "hr_longest",
                "ds_base", "us_base"]
CHANNEL_COLS = ["ts", "time", "dir", "ch", "lock", "mod", "freq_mhz", "power", "snr", "corr", "uncorr"]
EVENT_COLS = ["ts", "time", "modem_date", "modem_time", "prio", "type", "message"]


def append_csv(path, cols, rows):
    new = not os.path.exists(path)
    if not new:
        with open(path, newline="") as f:
            header = next(csv.reader(f), None)
        if header and header != cols:
            # A newer version added columns: rewrite the file once with the new header.
            with open(path, newline="") as f:
                old_rows = list(csv.DictReader(f))
            tmp = path + ".tmp"
            with open(tmp, "w", newline="") as f:
                w = csv.DictWriter(f, fieldnames=cols + [c for c in header if c not in cols], extrasaction="ignore")
                w.writeheader()
                w.writerows(old_rows)
            os.chmod(tmp, 0o644)
            os.replace(tmp, path)
            cols = cols + [c for c in header if c not in cols]
    with open(path, "a", newline="") as f:
        w = csv.DictWriter(f, fieldnames=cols, extrasaction="ignore")
        if new:
            w.writeheader()
        for r in rows:
            w.writerow(r)


def _topen(p):
    """Open a data file as text; older months may be gzip-compressed (.gz)."""
    if p.endswith(".gz"):
        return gzip.open(p, "rt", newline="", encoding="utf-8", errors="replace")
    return open(p, newline="", encoding="utf-8", errors="replace")


def compress_old(cfg):
    """gzip monthly files older than last month (CSV compresses about 8-10x).
    Readers handle .gz transparently; the current and previous month stay plain."""
    if cfg.get("compress_old", "1") != "1":
        return 0
    t = time.localtime()
    y, m = (t.tm_year, t.tm_mon - 1) if t.tm_mon > 1 else (t.tm_year - 1, 12)
    keep_from = "%04d-%02d" % (y, m)
    n = 0
    for p in glob.glob(os.path.join(cfg["data_dir"], "*-????-??.csv")) + \
            glob.glob(os.path.join(cfg["data_dir"], "traces-????-??.log")):
        mm = re.search(r"(\d{4}-\d{2})\.(csv|log)$", p)
        if not mm or mm.group(1) >= keep_from or os.path.exists(p + ".gz"):
            continue
        try:
            with open(p, "rb") as src, gzip.open(p + ".gz.tmp", "wb", compresslevel=6) as dst:
                shutil.copyfileobj(src, dst)
            os.chmod(p + ".gz.tmp", 0o644)
            os.replace(p + ".gz.tmp", p + ".gz")
            os.remove(p)
            n += 1
        except OSError as e:
            log("compress %s failed: %s" % (p, e))
            try:
                os.remove(p + ".gz.tmp")
            except OSError:
                pass
    if n:
        log("compressed %d old monthly file%s" % (n, "" if n == 1 else "s"))
    return n


def month_file(cfg, kind, ts):
    return os.path.join(cfg["data_dir"], "%s-%s.csv" % (kind, time.strftime("%Y-%m", time.localtime(ts))))


def prune(cfg):
    keep = int(fnum(cfg, "retention_days"))
    cutoff = time.strftime("%Y-%m", time.localtime(time.time() - keep * 86400))
    for p in glob.glob(os.path.join(cfg["data_dir"], "*-????-??.csv*")) + \
            glob.glob(os.path.join(cfg["data_dir"], "traces-????-??.log*")):
        m = re.search(r"(\d{4}-\d{2})\.(csv|log)(\.gz)?$", p)
        if m and m.group(1) < cutoff:
            os.remove(p)
    rows = load_maint(cfg)
    keep_rows = [r for r in rows if int(r["ts"]) >= time.time() - keep * 86400]
    if len(keep_rows) != len(rows):
        save_maint(cfg, keep_rows)


# --------------------------------------------------------------------------
# Maintenance log (manual entries, backfill, and auto-suggested entries)
# --------------------------------------------------------------------------

MAINT_COLS = ["id", "ts", "time", "end_ts", "end_time", "type", "note", "source", "status"]
MAINT_TYPES = ("tech", "modem-reboot", "router-change", "wiring", "power", "isp-call", "outage", "other")


def maint_path(cfg):
    return os.path.join(cfg["data_dir"], "maintenance.csv")


def load_maint(cfg):
    try:
        with open(maint_path(cfg), newline="") as f:
            rows = list(csv.DictReader(f))
    except OSError:
        return []
    return [r for r in rows if r.get("id")]


def save_maint(cfg, rows):
    os.makedirs(cfg["data_dir"], exist_ok=True)
    rows = sorted(rows, key=lambda r: int(r["ts"]))
    tmp = maint_path(cfg) + ".tmp"
    with open(tmp, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=MAINT_COLS, extrasaction="ignore")
        w.writeheader()
        w.writerows(rows)
    os.chmod(tmp, 0o644)
    os.replace(tmp, maint_path(cfg))


def _fmt(ts):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(ts))) if ts not in (None, "") else ""


def parse_local_time(s):
    """'now', 'YYYY-MM-DD HH:MM[:SS]' or 'YYYY-MM-DDTHH:MM' (local time) -> epoch."""
    s = (s or "").strip()
    if not s or s == "now":
        return int(time.time())
    for f in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M"):
        try:
            return int(time.mktime(datetime.strptime(s, f).timetuple()))
        except ValueError:
            pass
    raise ValueError("unrecognised time %r (use YYYY-MM-DD HH:MM)" % s)


def add_maint(cfg, ts, mtype, note, source="manual", status="confirmed", end_ts=None, rows=None):
    own = rows is None
    rows = load_maint(cfg) if own else rows
    if mtype not in MAINT_TYPES:
        raise ValueError("type must be one of: " + ", ".join(MAINT_TYPES))
    nid = max([int(r["id"]) for r in rows] + [0]) + 1
    row = {"id": nid, "ts": int(ts), "time": _fmt(ts), "end_ts": int(end_ts) if end_ts else "",
           "end_time": _fmt(end_ts) if end_ts else "", "type": mtype,
           "note": " ".join(str(note).split())[:500], "source": source, "status": status}
    rows.append(row)
    if own:
        save_maint(cfg, rows)
    return row


def suggest(cfg, st, ts, mtype, note, end_ts=None):
    """Auto entry, shown as 'suggested' until confirmed or edited."""
    try:
        row = add_maint(cfg, ts, mtype, note, source="auto", status="suggested", end_ts=end_ts)
        log("suggested maintenance entry #%s: %s" % (row["id"], note))
        return row
    except (OSError, ValueError) as e:
        log("could not add suggestion: %s" % e)
        return None


def extend_maint(cfg, mid, end_ts, note=None):
    rows = load_maint(cfg)
    for r in rows:
        if str(r["id"]) == str(mid):
            r["end_ts"], r["end_time"] = int(end_ts), _fmt(end_ts)
            if note:
                r["note"] = note
            save_maint(cfg, rows)
            return True
    return False


def auto_suggest(cfg, st, row, now, uptime, new_events):
    interval = int(fnum(cfg, "interval"))
    prev_ts = st.get("last_ok_ts")

    # Router reboot: detected on the first sample after the router booted, but held
    # for a while, because after a power cut the modem comes back later than the router
    boot_id = _read("/proc/sys/kernel/random/boot_id")
    if boot_id and st.get("router_boot_id") != boot_id:
        try:
            up = float(_read("/proc/uptime").split()[0])
        except (ValueError, IndexError):
            up = None
        if st.get("router_boot_id") and up is not None and up < 3600:
            st["router_boot_pending"] = int(now - up)
        st["router_boot_id"] = boot_id

    # 1. Modem reboot (uptime went backwards)
    if row.get("rebooted") == 1 and uptime is not None:
        boot = int(now - uptime)
        mine = [r for r in load_maint(cfg) if r["type"] in ("modem-reboot", "tech", "power") and r["status"] == "confirmed"
                and abs(int(r["ts"]) - boot) < 1800]
        rb = st.get("router_boot_pending") or st.get("router_boot_last")
        if mine:
            pass
        elif rb and abs(rb - boot) <= POWER_PAIR_S:
            suggest(cfg, st, min(rb, boot), "power",
                    "Power outage at home? The router (%s) and the modem (%s) both restarted. If the power stayed on, "
                    "change the type to Outage." % (time.strftime("%H:%M", time.localtime(rb)),
                                                    time.strftime("%H:%M", time.localtime(boot))))
            st.pop("router_boot_pending", None)
        else:
            suggest(cfg, st, boot, "outage",
                    "Modem rebooted on its own (uptime reset; not started from this router). If the power went out "
                    "at home, change the type to Power outage (home).")

    # 2. Loss of signal / re-registration without a reboot
    reg = [e for e in new_events if e["type"] in ("PROVISION", "T4", "SYNC")
           and prev_ts and int(e["ts"]) > prev_ts - 60]
    if reg and row.get("rebooted") != 1:
        row["relock"] = 1
    if row.get("relock") == 1:
        start = min([int(e["ts"]) for e in reg] + [prev_ts or int(now)])
        o = st.get("open_relock")
        if o and int(o["end"]) >= start - (2 * interval + 60):
            o["end"] = int(now)
            extend_maint(cfg, o["id"], now)
        else:
            r = suggest(cfg, st, start, "outage",
                        "Lost signal / re-registered (no modem reboot; uptime kept counting)", end_ts=now)
            if r:
                st["open_relock"] = {"id": r["id"], "end": int(now)}

    # 3. Level shift: median power, hour before vs hour after, >= 1.5 dB
    if row.get("ok") == 1 and row.get("ds_power_avg") not in ("", None):
        lv = st.get("levels", [])
        lv.append([int(now), row["ds_power_avg"], row.get("us_power_avg") or None])
        lv = [x for x in lv if x[0] >= now - 3 * 3600][-24:]
        st["levels"] = lv
        if len(lv) == 24 and lv[-1][0] - lv[0][0] <= 2.5 * 3600 and now - st.get("last_shift", 0) > 2 * 3600:
            med = lambda xs: sorted(xs)[len(xs) // 2]
            msgs = []
            for idx, name in ((1, "downstream"), (2, "upstream")):
                b = [x[idx] for x in lv[:12] if x[idx] is not None]
                a = [x[idx] for x in lv[12:] if x[idx] is not None]
                if len(b) >= 8 and len(a) >= 8 and abs(med(a) - med(b)) >= 1.5:
                    msgs.append("%s %+.1f dB (%.1f -> %.1f dBmV)" % (name, med(a) - med(b), med(b), med(a)))
            if msgs:
                suggest(cfg, st, lv[12][0], "other", "Signal level shift: " + "; ".join(msgs))
                st["last_shift"] = int(now)

    # 4. Router reboot on its own: no modem reboot followed within the window
    rb = st.get("router_boot_pending")
    if rb and now - rb > POWER_PAIR_S + 2 * interval:
        suggest(cfg, st, rb, "router-change", "Router rebooted")
        st.pop("router_boot_pending", None)
        st["router_boot_last"] = rb

    if row.get("ok") == 1:
        st["last_ok_ts"] = int(now)


# --------------------------------------------------------------------------
# Poll
# --------------------------------------------------------------------------

def rnd(v, n=1):
    return None if v is None else round(v, n)


def poll(cfg):
    os.makedirs(cfg["data_dir"], exist_ok=True)
    st = load_state(cfg)
    now = time.time()
    stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now))
    row = {"ts": int(now), "time": stamp, "ok": 0, "error": "", "rebooted": 0}

    # Ping first, so it reflects the line, not the polling itself.
    losses, avgs, maxs = [], [], []
    for t in cfg["ping_targets"].split():
        lo, av, mx = ping(t, int(fnum(cfg, "ping_count")))
        if lo is not None:
            losses.append(lo)
        if av is not None:
            avgs.append(av)
            maxs.append(mx)
    row["ping_loss"] = rnd(sum(losses) / len(losses)) if losses else ""
    row["ping_avg_ms"] = rnd(sum(avgs) / len(avgs)) if avgs else ""
    row["ping_max_ms"] = rnd(max(maxs)) if maxs else ""
    if PROBER is not None:
        row.update(probe_stats(PROBER.take(), max(1, int(fnum(cfg, "hires_drop_min")))))
        try:
            probe_health(cfg, st, row)
        except Exception as e:
            log("probe check error: %r" % e)
    row["gw_loss"] = row["gw_avg_ms"] = ""
    if cfg.get("gw_ping", "1") == "1":
        gw = isp_gateway(cfg)
        if gw:
            lo, av, mx = ping(gw, int(fnum(cfg, "ping_count")))
            row["gw_loss"] = rnd(lo) if lo is not None else ""
            row["gw_avg_ms"] = rnd(av) if av is not None else ""
            row["gw"] = gw
    if (row["ping_loss"] or 0) > 0 or (row["gw_loss"] or 0) > 0:
        start_trace(cfg, st, now, "%s%% loss to the internet, %s%% to the ISP gateway" %
                    (row["ping_loss"], row["gw_loss"] if row["gw_loss"] != "" else "?"))
    try:
        t, pr = weather_now(cfg, st, now)
    except Exception as e:
        log("weather error: %r" % e)
        t, pr = None, None
    row["temp"] = t if t is not None else ""
    row["precip"] = pr if pr is not None else ""

    modem = make_driver(cfg, st)
    events_new = []
    chd, chinfo = {}, {}
    ds, us = [], []
    try:
        S = modem.status()
        ds, us, uptime = S["ds"], S["us"], S["uptime"]
        co = modem_clock_offset(S.get("conninfo"), now)
        if co is not None:
            st["clock_offset"] = co
        if not ds and not us:
            raise ModemError("modem returned no channel data")
        row["ok"] = 1
        row["uptime_s"] = uptime if uptime is not None else ""

        sc = [c for c in ds if not _is_ofdm(c["mod"])]
        dsp = [c["power"] for c in ds if c["power"] is not None]
        snr = [c["snr"] for c in sc if c["snr"] is not None]
        usp = [c["power"] for c in us if c["power"] is not None]
        corr = sum(c["corr"] for c in ds)
        unc = sum(c["uncorr"] for c in ds)
        row.update(ds_count=len(ds), ds_locked=sum(1 for c in ds if c["lock"].lower() == "locked"),
                   ds_power_min=rnd(min(dsp)) if dsp else "", ds_power_max=rnd(max(dsp)) if dsp else "",
                   ds_snr_min=rnd(min(snr)) if snr else "",
                   ds_snr_avg=rnd(sum(snr) / len(snr)) if snr else "",
                   corr_total=corr, uncorr_total=unc,
                   us_count=len(us), us_locked=sum(1 for c in us if c["lock"].lower() == "locked"),
                   us_power_min=rnd(min(usp)) if usp else "", us_power_max=rnd(max(usp)) if usp else "")

        row["ds_power_avg"] = rnd(sum(dsp) / len(dsp), 2) if dsp else ""
        row["us_power_avg"] = rnd(sum(usp) / len(usp), 2) if usp else ""

        # Reboot = uptime went backwards. Counters resetting while uptime keeps
        # climbing = the modem lost signal and re-registered (no reboot).
        prev_unc, prev_up = st.get("last_uncorr"), st.get("last_uptime")
        counters_reset = prev_unc is not None and unc < prev_unc
        if uptime is not None and prev_up is not None:
            rebooted = uptime + 120 < prev_up
        else:
            rebooted = counters_reset  # no uptime available: best guess
        unlocked = bool(ds) and all(c["lock"].lower() != "locked" for c in ds)
        row["rebooted"] = 1 if rebooted else 0
        row["relock"] = 1 if (not rebooted and (counters_reset or unlocked)) else 0
        if prev_unc is None:
            row["uncorr_delta"] = 0
        elif counters_reset or rebooted:
            row["uncorr_delta"] = unc
        else:
            row["uncorr_delta"] = unc - prev_unc
        st["last_uncorr"], st["last_uptime"] = unc, uptime
        if uptime is not None:
            est = int(now - uptime)
            if rebooted or abs(est - st.get("boot_ts", 0)) > 600:
                st["boot_ts"] = est
        boot_ts = st.get("boot_ts")
        migrate_102(cfg, st, boot_ts)

        if now - st.get("modem_info", {}).get("ts", 0) > 86400:
            try:
                st["modem_info"] = dict(modem.info(), ts=int(now))
            except ModemError:
                pass

        chrows = []
        for d, chans in (("down", ds), ("up", us)):
            for c in chans:
                chrows.append({"ts": int(now), "time": stamp, "dir": d, "ch": c["ch"], "lock": c["lock"],
                               "mod": c["mod"], "freq_mhz": c["freq"], "power": c["power"],
                               "snr": c.get("snr", ""), "corr": c.get("corr", ""),
                               "uncorr": c.get("uncorr", "")})
        append_csv(month_file(cfg, "channels", now), CHANNEL_COLS, chrows)
        prevch = st.get("last_ch_unc", {})
        for c in ds:
            k = str(c["ch"])
            if k in prevch and not rebooted:
                chd[k] = c["uncorr"] - prevch[k] if c["uncorr"] >= prevch[k] else c["uncorr"]
            if c["freq"]:
                chinfo[k] = {"freq": c["freq"], "ofdm": _is_ofdm(c["mod"])}
        st["last_ch_unc"] = {str(c["ch"]): c["uncorr"] for c in ds}

        # Event log (separate request; some firmware may not support it)
        try:
            evs = modem.events()
            clock = st.get("clock_offset")
            if clock is None:
                # No readable modem clock: dated entries "in the future" mean UTC display.
                fut = [e for e in evs if boot_offset(e) is None and _try_ts(e) > now + 600]
                clock = -_utc_offset() if fut else 0
            migrate_113(cfg, st, clock)
            seen = st.get("seen_events", [])
            seen_set = set(seen)
            for ev in evs:
                key = event_key(ev, boot_ts, clock, now)
                if key in seen_set:
                    continue
                seen_set.add(key)
                seen.append(key)
                ets = event_ts(ev, now, boot_ts, clock)
                cnt = st.setdefault("event_counts", {})
                cnt[classify(ev["msg"])] = cnt.get(classify(ev["msg"]), 0) + 1
                events_new.append({"ts": ets, "time": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ets)),
                                   "modem_date": ev["date"], "modem_time": ev["time"], "prio": ev["prio"],
                                   "type": classify(ev["msg"]), "message": ev["msg"]})
            st["seen_events"] = seen[-3000:]
        except ModemError as e:
            log("event log unavailable: %s" % e)
    except ModemError as e:
        row["error"] = str(e)[:200]
        log(str(e))

    try:
        lk = link_sample(cfg, st, now, stamp)
        if lk:
            append_csv(month_file(cfg, "link", now), LINK_COLS, [lk])
            row["link"] = {k: lk[k] for k in ("dev", "speed", "operstate", "err_delta", "missed_delta", "link_drops")}
    except Exception as e:
        log("link stats error: %r" % e)

    try:
        auto_suggest(cfg, st, row, now, row.get("uptime_s") if row.get("uptime_s") != "" else None, events_new)
    except Exception as e:
        log("auto-suggest error: %r" % e)

    try:
        row["_lost_ch"] = channel_watch(cfg, st, row, now)
    except Exception as e:
        log("channel watch error: %r" % e)
    try:
        alert_check(cfg, st, row, events_new, chd, chinfo, now)
    except Exception as e:
        log("alert error: %r" % e)

    day = time.strftime("%Y-%m-%d", time.localtime(now))
    td = st.get("today") or {}
    if td.get("day") != day:
        td = {"day": day}
    for e in events_new:
        if e["time"][:10] == day:
            td[e["type"]] = td.get(e["type"], 0) + 1
    if row.get("ok") == 1 and row.get("rebooted") != 1:
        td["uncorr"] = td.get("uncorr", 0) + int(row.get("uncorr_delta") or 0)
    td["drops"] = td.get("drops", 0) + int(row.get("hr_drops") or 0)
    st["today"] = td
    row["today"] = {k: v for k, v in td.items() if k != "day"}
    row["tile"] = cfg.get("overview_tile", "1")
    row["limits"] = {k: fnum(cfg, k) for k in ("us_power_min", "us_power_max", "ds_power_min", "ds_power_max", "ds_snr_min")}
    row["isp"] = (cfg.get("isp_name") or "").strip()
    try:
        sp = speed_rows(cfg, now - 3 * 86400)
        if sp:
            r = sp[-1]
            row["speed_last"] = {"ts": int(r["ts"]), "down": fv(r, "down_mbps"), "up": fv(r, "up_mbps"),
                                 "idle": fv(r, "idle_ms"), "loaded": fv(r, "loaded_ms"), "error": r.get("error", "")}
    except Exception:
        pass
    row["lost_ch"] = " and ".join(row.pop("_lost_ch", None) or [])
    try:
        write_metrics(cfg, st, row, ds, us)
    except Exception as e:
        log("metrics error: %r" % e)
    try:
        mqtt_update(cfg, st, row, td)
    except Exception as e:
        log("mqtt error: %r" % e)

    append_csv(month_file(cfg, "summary", now), SUMMARY_COLS, [row])
    if events_new:
        append_csv(os.path.join(cfg["data_dir"], "events.csv"), EVENT_COLS, events_new)
    save_state(cfg, st)
    write_latest(cfg, row)
    return row


def write_latest(cfg, row):
    os.makedirs(cfg["web_dir"], exist_ok=True)
    tmp = os.path.join(cfg["web_dir"], "latest.json.tmp")
    with open(tmp, "w") as f:
        json.dump(row, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(cfg["web_dir"], "latest.json"))


# --------------------------------------------------------------------------
# Report
# --------------------------------------------------------------------------

def read_csvs(paths, since):
    rows = []
    for p in sorted(paths):
        try:
            with _topen(p) as f:
                for r in csv.DictReader(f):
                    try:
                        if int(r["ts"]) >= since:
                            rows.append(r)
                    except (KeyError, ValueError):
                        pass
        except OSError:
            pass
    rows.sort(key=lambda r: int(r["ts"]))
    return rows


def files_since(cfg, kind, since):
    first = time.strftime("%Y-%m", time.localtime(since))
    return [p for p in glob.glob(os.path.join(cfg["data_dir"], kind + "-????-??.csv*"))
            if re.search(r"(\d{4}-\d{2})\.csv(\.gz)?$", p) and
            re.search(r"(\d{4}-\d{2})\.csv(\.gz)?$", p).group(1) >= first]


def fv(r, k):
    try:
        v = r.get(k, "")
        return float(v) if v not in ("", None) else None
    except ValueError:
        return None


def bucketize(points, bucket, how):
    """points: list of (ts, value). Returns [(bucket_start, agg)]."""
    if bucket <= 0:
        return [(t, v) for t, v in points if v is not None]
    out, cur, vals = [], None, []
    for t, v in points:
        b = t - t % bucket
        if b != cur:
            if vals:
                out.append((cur, agg(vals, how)))
            cur, vals = b, []
        if v is not None:
            vals.append(v)
    if vals:
        out.append((cur, agg(vals, how)))
    return out


def agg(vals, how):
    if how == "max":
        return max(vals)
    if how == "min":
        return min(vals)
    if how == "sum":
        return sum(vals)
    return round(sum(vals) / len(vals), 2)


RANGES = [("24h", 86400, 0), ("7d", 7 * 86400, 1800), ("30d", 30 * 86400, 7200)]


SETUP_ERRORS = ("no modem password", "login failed", "modem rejected login")


def modem_down(r):
    """A failed sample that reflects the line/modem, not our own setup
    (missing or wrong password are excluded from outage statistics)."""
    if r.get("ok") == "1":
        return False
    err = (r.get("error") or "").lower()
    return not any(e in err for e in SETUP_ERRORS)


def build_report(cfg):
    now = int(time.time())
    longest = max(r[1] for r in RANGES)
    since = now - longest
    summ = read_csvs(files_since(cfg, "summary", since), since)
    chans = [r for r in read_csvs(files_since(cfg, "channels", since), since) if r.get("dir") == "up"]
    events = read_csvs([os.path.join(cfg["data_dir"], "events.csv")], since)
    links = read_csvs(files_since(cfg, "link", since), since)
    interval = int(fnum(cfg, "interval"))

    data = {"generated": time.strftime("%Y-%m-%d %H:%M:%S"), "now": now, "interval": interval,
            "report_interval": max(60, int(fnum(cfg, "report_interval"))),
            "thresholds": {k: fnum(cfg, k) for k in
                           ("us_power_min", "us_power_max", "ds_power_min", "ds_power_max", "ds_snr_min")},
            "ranges": {}}

    us_ids = sorted({r["ch"] for r in chans}, key=lambda x: (num(x) or 0, x))[:8]

    mark_reboots(summ)  # derived from history so old rows are classified the same way
    # Link counters: recomputed from the cumulative columns. Cable/port errors and
    # NIC receive overruns (rx_missed: router CPU/buffer) are kept apart.
    prevl = {}
    for r in links:
        pr = prevl.get(r.get("dev"))
        tot = lambda x: sum(int(fv(x, k) or 0) for k in LINK_ERR_KEYS)
        r["_err"] = max(0, tot(r) - tot(pr)) if pr else 0
        r["_missed"] = max(0, int(fv(r, "rx_missed") or 0) - int(fv(pr, "rx_missed") or 0)) if pr else 0
        prevl[r.get("dev")] = r

    for name, span, bucket in RANGES:
        lo = now - span
        s = [r for r in summ if int(r["ts"]) >= lo]
        c = [r for r in chans if int(r["ts"]) >= lo]
        ev = [e for e in events if int(e["ts"]) >= lo]
        lk = [r for r in links if int(r["ts"]) >= lo]
        b = bucket
        series = {
            "us_power": [{"name": "Ch %s" % ch, "pts": bucketize(
                [(int(r["ts"]), fv(r, "power")) for r in c if r["ch"] == ch], b, "max")} for ch in us_ids],
            "ds_snr": [{"name": "Lowest channel", "pts": bucketize([(int(r["ts"]), fv(r, "ds_snr_min")) for r in s], b, "min")},
                       {"name": "Average", "pts": bucketize([(int(r["ts"]), fv(r, "ds_snr_avg")) for r in s], b, "avg")}],
            "ds_power": [{"name": "Highest channel", "pts": bucketize([(int(r["ts"]), fv(r, "ds_power_max")) for r in s], b, "max")},
                         {"name": "Lowest channel", "pts": bucketize([(int(r["ts"]), fv(r, "ds_power_min")) for r in s], b, "min")}],
            "uncorr": [{"name": "Uncorrectable codewords", "pts": bucketize([(int(r["ts"]), fv(r, "uncorr_delta")) for r in s], b, "sum")}],
            "loss": [{"name": "Internet", "pts": bucketize([(int(r["ts"]), fv(r, "ping_loss")) for r in s], b, "max")},
                     {"name": "ISP gateway (first hop)", "pts": bucketize([(int(r["ts"]), fv(r, "gw_loss")) for r in s], b, "max")}],
            "latency": [{"name": "Internet", "pts": bucketize([(int(r["ts"]), fv(r, "ping_avg_ms")) for r in s], b, "avg")},
                        {"name": "ISP gateway (first hop)", "pts": bucketize([(int(r["ts"]), fv(r, "gw_avg_ms")) for r in s], b, "avg")}],
            "drops": [{"name": "Short dropouts", "pts": bucketize([(int(r["ts"]), fv(r, "hr_drops")) for r in s], b, "sum")}],
            "jitter": [{"name": "Worst 5% latency (p95)", "pts": bucketize([(int(r["ts"]), fv(r, "hr_p95")) for r in s], b, "max")},
                       {"name": "Jitter", "pts": bucketize([(int(r["ts"]), fv(r, "hr_jitter")) for r in s], b, "max")}],
            "temp": [{"name": "Outdoor temperature", "step": max(b, 1800),
                      "pts": bucketize([(int(r["ts"]), fv(r, "temp")) for r in s], max(b, 1800), "avg")}],
            "link_err": [{"name": "Link errors", "pts": bucketize([(int(r["ts"]), r["_err"]) for r in lk], b, "sum")}],
            "missed": [{"name": "Missed packets", "pts": bucketize([(int(r["ts"]), r["_missed"]) for r in lk], b, "sum")}],
        }
        failed = [r for r in s if modem_down(r)]
        reboots = [r for r in s if r["_reb"]]
        usmax = [fv(r, "us_power_max") for r in s if fv(r, "us_power_max") is not None]
        tiles = {
            "T3": sum(1 for e in ev if e["type"] == "T3"),
            "T4": sum(1 for e in ev if e["type"] == "T4"),
            "DRW": sum(1 for e in ev if e["type"] == "DRW"),
            "uncorr": int(sum(fv(r, "uncorr_delta") or 0 for r in s)),
            "us_max": max(usmax) if usmax else None,
            "reboots": len(reboots),
            "relocks": sum(1 for r in s if r["_rel"]),
            "failed": len(failed),
            "loss_polls": sum(1 for r in s if (fv(r, "ping_loss") or 0) > 0),
            "polls": len(s),
            "link_err": int(sum(r["_err"] for r in lk)),
            "missed": int(sum(r["_missed"] for r in lk)),
            "missed_flag": any(r["_missed"] > 100 for r in lk),
            "link_drops": int(sum(fv(r, "link_drops") or 0 for r in lk)),
            "link_dev": lk[-1]["dev"] if lk else "",
            "link_speed": lk[-1]["speed"] if lk else "",
            "link_on": bool(lk),
            "drops": int(sum(fv(r, "hr_drops") or 0 for r in s)),
            "longest": int(max([fv(r, "hr_longest") or 0 for r in s] + [0])),
            "lostch": sum(1 for r in s if fv(r, "ds_base") is not None and ((fv(r, "ds_locked") or 0) < fv(r, "ds_base") or (fv(r, "us_locked") or 0) < (fv(r, "us_base") or 0))),
        }
        data["ranges"][name] = {"bucket": b, "series": series, "tiles": tiles, "span": span}

    # Downstream errors per channel: heatmap per range + daily ingress check
    try:
        specs = {"24h": (now - 86400, 3600), "7d": (now - 7 * 86400, 4 * 3600),
                 "30d": (now - 30 * 86400, 86400)}
        chm, chinfo = channel_uncorr(cfg, specs)
        for name, (lo, size) in specs.items():
            if name in data["ranges"]:
                data["ranges"][name]["heat"] = heat_matrix(chm.get(name, {}), chinfo, lo, size, now)
        data["ingress"] = ingress_findings(chm.get("30d", {}), chinfo)
    except Exception as e:
        log("channel analysis error: %r" % e)
        data["ingress"] = []

    # Daily table (30 days)
    days = {}
    for i in range(30):
        d = time.strftime("%Y-%m-%d", time.localtime(now - i * 86400))
        days[d] = {"T3": 0, "T4": 0, "SYNC": 0, "PROVISION": 0, "DRW": 0, "uncorr": 0, "reboots": 0, "failed": 0, "loss": 0, "polls": 0, "us_max": None, "link_err": 0, "link_drops": 0, "relocks": 0, "missed": 0}
    for e in events:
        d = e["time"][:10]
        if d in days and e["type"] in ("T3", "T4", "SYNC", "PROVISION", "DRW"):
            days[d][e["type"]] += 1
    for r in summ:
        d = r["time"][:10]
        if d not in days:
            continue
        x = days[d]
        x["polls"] += 1
        x["uncorr"] += int(fv(r, "uncorr_delta") or 0)
        x["reboots"] += 1 if r["_reb"] else 0
        x["relocks"] += 1 if r["_rel"] else 0
        x["failed"] += 1 if modem_down(r) else 0
        x["loss"] += 1 if (fv(r, "ping_loss") or 0) > 0 else 0
        u = fv(r, "us_power_max")
        if u is not None:
            x["us_max"] = u if x["us_max"] is None else max(x["us_max"], u)
    for r in links:
        d = r["time"][:10]
        if d in days:
            days[d]["link_err"] += r["_err"]
            days[d]["missed"] += r["_missed"]
            days[d]["link_drops"] += int(fv(r, "link_drops") or 0)
    data["days"] = [dict(day=k, **v) for k, v in sorted(days.items(), reverse=True)]

    # Compact per-sample rows so the page can recount everything from any start
    # time (the "since maintenance entry" filter).
    daylist = sorted({r["time"][:10] for r in summ} | {e["time"][:10] for e in events}
                     | {r["time"][:10] for r in links})
    di = {d: i for i, d in enumerate(daylist)}
    data["daylist"] = daylist
    data["samples"] = [[int(r["ts"]), 1 if modem_down(r) else 0, 1 if r["_reb"] else 0, 1 if r["_rel"] else 0,
                        int(fv(r, "uncorr_delta") or 0) if r.get("ok") == "1" else 0, fv(r, "us_power_max"),
                        fv(r, "ping_loss"), di[r["time"][:10]], int(fv(r, "hr_drops") or 0),
                        1 if fv(r, "ds_base") is not None and ((fv(r, "ds_locked") or 0) < fv(r, "ds_base") or
                                                               (fv(r, "us_locked") or 0) < (fv(r, "us_base") or 0)) else 0]
                       for r in summ]
    data["evc"] = [[int(e["ts"]), e["type"], di[e["time"][:10]]] for e in events
                   if e["type"] in ("T3", "T4", "SYNC", "PROVISION", "DRW")]
    data["lk"] = [[int(r["ts"]), r["_err"], r["_missed"], int(fv(r, "link_drops") or 0), di[r["time"][:10]]]
                  for r in links]
    data["link_info"] = {"dev": links[-1].get("dev", ""), "speed": links[-1].get("speed", "")} if links else {}
    data["isp"] = cfg.get("isp_name", "").strip()
    unit = "\u00b0F" if (cfg.get("weather_unit") or "C").upper().startswith("F") else "\u00b0C"
    data["temp_unit"] = unit
    data["weather_on"] = bool((cfg.get("weather_lat") or "").strip()) or any(fv(r, "temp") is not None for r in summ)
    data["weather_notes"] = weather_text(weather_effects(summ), unit) if data["weather_on"] else []
    data["traces"] = read_traces(cfg, now - 30 * 86400)
    data["hires_on"] = cfg.get("hires_ping", "0") == "1" or any(fv(r, "hr_sent") for r in summ)
    data["probe"] = load_state(cfg).get("probe") if data["hires_on"] else None
    sp = speed_rows(cfg, now - 90 * 86400)
    data["speed"] = [[int(r["ts"]), fv(r, "down_mbps"), fv(r, "up_mbps"), fv(r, "idle_ms"), fv(r, "loaded_ms"), r.get("error", "")]
                     for r in sp]
    # plan speeds are Mb/s; ignore values that can't be (e.g. kb/s typed by mistake)
    data["plan"] = [v if v and v <= 10000 else None for v in (fnum(cfg, "plan_down"), fnum(cfg, "plan_up"))]
    data["sqm"] = list(sqm_limits())
    try:
        data["credit"] = credit_months(cfg) if cfg.get("credit_enabled", "1") == "1" else None
    except Exception as e:
        log("credit summary error: %r" % e)
        data["credit"] = None
    data["backup"] = load_state(cfg).get("backup_last") if cfg.get("backup_enabled", "0") == "1" else None
    data["title"] = cfg.get("report_title", "").strip()
    data["note"] = cfg.get("report_note", "").strip()
    data.pop("days", None)  # the page builds the daily table itself (see "samples")

    # Outages: consecutive failed polls or 100% loss, grouped
    outs = group_outages(summ, interval)
    for r in summ:
        if modem_down(r) and not is_outage(r) and "password" not in (r.get("error") or ""):
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "Modem status page didn't answer, but the internet was working (%s%% ping loss): not an outage"
                                % (r.get("ping_loss") or 0)})
    for r in summ:
        if r["_reb"]:
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0, "why": "Modem rebooted (uptime reset)"})
        elif r["_rel"]:
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "Modem lost signal and re-registered (no reboot; uptime kept counting)"})
    for r in summ:
        if fv(r, "ds_base") is not None and r.get("ok") == "1":
            dl, db = int(fv(r, "ds_locked") or 0), int(fv(r, "ds_base"))
            ul, ub = int(fv(r, "us_locked") or 0), int(fv(r, "us_base") or 0)
            if dl < db or ul < ub:
                outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                             "why": "Channels missing: %d of %d downstream, %d of %d upstream locked" % (dl, db, ul, ub)})
        if (fv(r, "hr_drops") or 0) > 0:
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "%d short dropout%s (longest %d s) in 1-second pings" % (
                             int(fv(r, "hr_drops")), "" if int(fv(r, "hr_drops")) == 1 else "s", int(fv(r, "hr_longest") or 0))})
    for r in links:
        n = int(fv(r, "link_drops") or 0)
        if n:
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "Router-to-modem Ethernet link (%s) went down %d time%s"
                                % (r["dev"], n, "" if n == 1 else "s")})
        if r.get("speed_changed") == "1":
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "Link speed on %s changed to %s Mb/s" % (r["dev"], r.get("speed") or "?")})
        e = r["_err"]
        if e:
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "%d Ethernet error%s on %s (CRC/alignment/collisions)" % (e, "" if e == 1 else "s", r["dev"])})
        if r["_missed"] > 100:
            outs.append({"start": int(r["ts"]), "end": int(r["ts"]), "polls": 0,
                         "why": "%d packets missed by %s (NIC receive overrun: router CPU/buffer, not the cable)"
                                % (r["_missed"], r["dev"])})
    outs.sort(key=lambda o: o["start"], reverse=True)
    data["incidents"] = [{"ts": o["start"], "start": time.strftime("%Y-%m-%d %H:%M", time.localtime(o["start"])),
                          "end": time.strftime("%Y-%m-%d %H:%M", time.localtime(o["end"])),
                          "mins": round((o["end"] - o["start"]) / 60 + (interval / 60 if o["polls"] else 0)),
                          "why": o["why"]} for o in outs[:200]]

    data["events"] = [{"ts": int(e["ts"]), "time": e["time"], "type": e["type"], "prio": e["prio"], "msg": e["message"]}
                      for e in reversed(events) if e["type"] != "LOGIN"][:300]

    last = summ[-1] if summ else {}
    data["latest"] = {k: v for k, v in last.items() if not k.startswith("_")}
    data["modem_info"] = load_state(cfg).get("modem_info", {})

    # Maintenance log + 24 h before/after summary
    def window(lo, hi):
        rows = [r for r in summ if lo <= int(r["ts"]) < hi]
        okr = [r for r in rows if r.get("ok") == "1"]
        if not okr:
            return None
        med = lambda k: (lambda v: sorted(v)[len(v) // 2] if v else None)([fv(r, k) for r in okr if fv(r, k) is not None])
        hrs = (int(rows[-1]["ts"]) - int(rows[0]["ts"]) + interval) / 3600.0
        unc = sum(int(fv(r, "uncorr_delta") or 0) for r in okr)
        ev = [e for e in events if lo <= int(e["ts"]) < hi]
        return {"ds": [med("ds_power_min"), med("ds_power_max")], "us": [med("us_power_min"), med("us_power_max")],
                "uncorr_day": round(unc * 24 / hrs) if hrs >= 1 else None, "hours": round(hrs, 1),
                "t3t4": sum(1 for e in ev if e["type"] in ("T3", "T4")),
                "drw": sum(1 for e in ev if e["type"] == "DRW")}
    def settled_after(t, mtype=""):
        """First healthy sample at/after t that is followed by another healthy one:
        modem reachable, no reboot/re-registration, no packet loss. Used as the
        start of 'show data since' for entries without an end time, so the
        disruption of the work itself (a reboot, a re-registration) is excluded.
        Searches up to an hour; falls back to t."""
        cand = [r for r in summ if t < int(r["ts"]) <= t + 3600]
        if mtype == "modem-reboot":
            # a sample taken seconds after the command can still see the old uptime:
            # start only after the sample that saw the reboot, if there is one
            hit = [i for i, r in enumerate(cand) if r["_reb"] and int(r["ts"]) <= t + 1800]
            if hit:
                cand = cand[hit[0] + 1:]
        ok = lambda r: (r.get("ok") == "1" and not r["_reb"] and not r["_rel"]
                        and (fv(r, "ping_loss") or 0) == 0)
        for i, r in enumerate(cand):
            if ok(r) and i + 1 < len(cand) and ok(cand[i + 1]):
                return int(r["ts"])
        return t
    mrows = sorted(load_maint(cfg), key=lambda r: int(r["ts"]))
    maint = []
    for i, r in enumerate(mrows, 1):
        t0 = int(r["ts"])
        t1 = int(r["end_ts"]) if r.get("end_ts") else t0
        since = t1 if t1 > t0 else settled_after(t0, r["type"])
        maint.append({"n": i, "id": r["id"], "ts": t0, "end": t1 if t1 > t0 else None, "since": since,
                      "time": r["time"][:16], "end_time": r.get("end_time", "")[:16], "type": r["type"],
                      "note": r["note"], "source": r["source"], "status": r["status"],
                      "before": window(t0 - 86400, t0), "after": window(t1, t1 + 86400)})
    data["maint"] = maint

    # Downloads: link CSVs (never state.json, which holds the session key)
    web = cfg["web_dir"]
    dl = os.path.join(web, "data")
    os.makedirs(dl, exist_ok=True)
    for d in (web, dl):
        os.chmod(d, 0o755)
    for p in glob.glob(os.path.join(cfg["data_dir"], "*.csv*")):
        os.chmod(p, 0o644)  # symlinked into the web dir for download
    for p in glob.glob(os.path.join(dl, "*.csv*")):
        os.remove(p)
    files = []
    for p in sorted(glob.glob(os.path.join(cfg["data_dir"], "*.csv")) +
                    glob.glob(os.path.join(cfg["data_dir"], "*.csv.gz")), reverse=True):
        n = os.path.basename(p)
        try:
            os.symlink(p, os.path.join(dl, n))
        except OSError:
            shutil.copy(p, os.path.join(dl, n))
        files.append({"name": n, "kb": round(os.path.getsize(p) / 1024)})
    data["files"] = files

    page = HTML.replace("/*__DATA__*/null", json.dumps(data, separators=(",", ":")).replace("</", "<\\/"))
    tmp = os.path.join(web, "index.html.tmp")
    with open(tmp, "w") as f:
        f.write(page)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(web, "index.html"))
    return os.path.join(web, "index.html")


