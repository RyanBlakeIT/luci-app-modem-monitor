#!/usr/bin/env python3
"""
modem-monitor - log Arris SURFboard S33 signal stats and event log on OpenWrt,
and build an HTML evidence report (signal levels, errors, T3/T4 timeouts,
reboots, outages, packet loss).

Commands:
  modem-monitor daemon   run forever (used by /etc/init.d/modem-monitor)
  modem-monitor poll     take one sample now
  modem-monitor report   rebuild the HTML report now
  modem-monitor test     log in to the modem and print what it returns
  modem-monitor test --raw   same, plus the raw HNAP responses
  modem-monitor reboot-modem [--note "why"]   reboot the modem and log it
  modem-monitor mark "note" [--type T] [--time "YYYY-MM-DD HH:MM"] [--end ...]
                         add a maintenance-log entry (types: tech, modem-reboot,
                         router-change, isp-call, outage, other)
  modem-monitor maint-list [--json] | maint-edit ID [--type --time --end --note]
  modem-monitor maint-del ID | maint-confirm ID | maint-import FILE.csv
  modem-monitor update-check [--json] [--cached]   is a newer release on GitHub?
  modem-monitor update-install   download (verified) and install the newer release
  modem-monitor update-status    progress of a running install (JSON)
  modem-monitor summary [--from YYYY-MM-DD] [--to YYYY-MM-DD]
                         one-page printable summary for a complaint (default: last 30 days)
  modem-monitor alert-test   send a test notification to every configured alert channel
  modem-monitor export   bundle all data + diagnostics into one .zip
                         (MAC/public IP addresses masked; --full keeps them)

Settings live in UCI: /etc/config/modem_monitor (edit in LuCI under
Status > Cable Modem > Settings).
"""

import csv
import glob
import hashlib
import hmac
import json
import os
import re
import shlex
import shutil
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request
import zipfile
from datetime import datetime, timedelta

VERSION = "1.2.2"
HNAP_NS = "http://purenetworks.com/HNAP1/"

