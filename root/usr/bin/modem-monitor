function tables(){const lo=SINCE||0,DL=D.daylist||[],K=DL.map(()=>({T3:0,T4:0,SYNC:0,PROVISION:0,DRW:0,uncorr:0,us_max:null,reboots:0,relocks:0,failed:0,loss:0,link_err:0,link_drops:0,missed:0,polls:0,any:false}));
 (D.evc||[]).forEach(e=>{if(e[0]>=lo){K[e[2]][e[1]]++;K[e[2]].any=true}});
 (D.samples||[]).forEach(r=>{if(r[0]<lo)return;const x=K[r[7]];x.any=true;x.polls++;x.failed+=r[1];x.reboots+=r[2];x.relocks+=r[3];x.uncorr+=r[4];if(r[5]!=null)x.us_max=x.us_max==null?r[5]:Math.max(x.us_max,r[5]);if((r[6]||0)>0)x.loss++});
 (D.lk||[]).forEach(r=>{if(r[0]<lo)return;const x=K[r[4]];x.any=true;x.link_err+=r[1];x.missed+=r[2];x.link_drops+=r[3]});
