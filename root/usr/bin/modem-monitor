  (wid.length?(nar.length?"<div style='margin-top:6px'>":"<div>")+"<b>Spread across the band</b> on "+wid.map(i=>i.day+" ("+i.total.toLocaleString()+")").join(", ")+".</div>":"")+"</div>";
