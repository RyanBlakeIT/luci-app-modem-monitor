  ci.forEach((i,k)=>{const v=H.v[j][i];g+="<rect x="+(Lp+k*cw).toFixed(1)+" y="+y+" width="+Math.max(1,cw-1).toFixed(1)+" height="+(rh-1)+" rx=1 fill='"+(v>0?"color-mix(in srgb,var(--s1) "+Math.round(12+88*lg(v))+"%,var(--surface-1))":"var(--grid)")+"'/>"})});
 const nx=Math.min(5,ci.length-1);for(let q=0;q<=nx;q++){const k=nx?Math.round(q*(ci.length-1)/nx):0;g+="<text x="+(Lp+k*cw+cw/2).toFixed(1)+" y="+(Hh-5)+" text-anchor=middle font-size=10 fill='var(--text-muted)'>"+esc(fmtT(H.cols[ci[k]],rg.span))+"</text>"}
 g+="<rect class=hit x="+Lp+" y="+Tp+" width="+(W-Lp-4)+" height="+(rows.length*rh)+" fill=transparent /></svg><div class=tip></div>";
