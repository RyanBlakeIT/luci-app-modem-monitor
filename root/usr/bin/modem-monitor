# --------------------------------------------------------------------------
# Modem reboot and maintenance commands
# --------------------------------------------------------------------------

def reboot_modem(cfg, note="", force=False):
    st = load_state(cfg)
    now = time.time()
    last = st.get("last_reboot_issued", 0)
    if not force and now - last < 600:
        raise ModemError("a reboot was issued %d minutes ago; wait 10 minutes or use --force"
                         % ((now - last) // 60))
    m = S33(cfg, st)
    eee, led = cfg.get("modem_eee", "0"), cfg.get("modem_led", "1")
    try:
        info = m.call(["GetArrisConfigurationInfo"]).get("GetArrisConfigurationInfoResponse", {})
        for k, v in info.items():
            kl = k.lower()
            if isinstance(v, (str, int)) and "result" not in kl:
                if "eee" in kl:
                    eee = str(v)
                elif "led" in kl:
                    led = str(v)
    except ModemError as e:
        log("could not read current EEE/LED settings (%s); using configured %s/%s" % (e, eee, led))
    payload = {"Action": "reboot", "SetEEEEnable": eee, "LED_Status": led}
    issued_note = "Reboot issued from router" + (": " + note if note else "")
    try:
        r = m.set("SetArrisConfigurationInfo", payload)
        res = (r.get("SetArrisConfigurationInfoResponse") or {}).get("SetArrisConfigurationInfoResult", "")
        if str(res).upper() not in ("OK", "REBOOT", ""):
            raise ModemError("modem answered %r to the reboot request" % res)
        outcome = "modem accepted the reboot (%s)" % (res or "no result field")
    except Unreachable:
        # The modem can drop the connection as it goes down.
        outcome = "no reply (modem probably already rebooting)"
        issued_note += " (no reply; check the uptime reset)"
    st.pop("uid", None)  # the session dies with the reboot
    st["last_reboot_issued"] = int(now)
    save_state(cfg, st)
    add_maint(cfg, now, "modem-reboot", issued_note, source="router", status="confirmed")
    return outcome


def _opts(args, flags=("--type", "--time", "--end", "--note", "--status")):
    """Tiny argv parser: returns (positional, {flag: value}, set_of_bool_flags)."""
    pos, kv, bools, i = [], {}, set(), 0
    while i < len(args):
        a = args[i]
        if a in flags and i + 1 < len(args):
            kv[a[2:]] = args[i + 1]
            i += 2
        elif a.startswith("--"):
            bools.add(a[2:])
            i += 1
        else:
            pos.append(a)
            i += 1
    return pos, kv, bools


def maint_cli(cfg, cmd, args):
    pos, kv, bools = _opts(args)
    rows = load_maint(cfg)
    if cmd == "mark":
        note = kv.get("note") or " ".join(pos)
        if not note:
            raise ValueError('usage: modem-monitor mark "note" [--type tech] [--time "YYYY-MM-DD HH:MM"] [--end ...]')
        end = parse_local_time(kv["end"]) if kv.get("end") else None
        r = add_maint(cfg, parse_local_time(kv.get("time")), kv.get("type", "other"), note, end_ts=end)
        print("added #%s %s %s: %s" % (r["id"], r["time"], r["type"], r["note"]))
    elif cmd == "maint-list":
        if "json" in bools:
            print(json.dumps(sorted(rows, key=lambda r: -int(r["ts"]))))
        else:
            for r in sorted(rows, key=lambda r: -int(r["ts"])):
                print("#%-3s %s%s  %-13s %-9s %-9s %s" % (r["id"], r["time"][:16],
                      (" - " + r["end_time"][11:16]) if r.get("end_time") else "        ",
                      r["type"], r["source"], r["status"], r["note"]))
    elif cmd in ("maint-edit", "maint-del", "maint-confirm"):
        if not pos:
            raise ValueError("usage: modem-monitor %s ID" % cmd)
        hit = [r for r in rows if str(r["id"]) == pos[0]]
        if not hit:
            raise ValueError("no maintenance entry #%s" % pos[0])
        r = hit[0]
        if cmd == "maint-del":
            rows.remove(r)
            print("deleted #%s" % r["id"])
        elif cmd == "maint-confirm":
            r["status"] = "confirmed"
            print("confirmed #%s" % r["id"])
        else:
            if "type" in kv:
                if kv["type"] not in MAINT_TYPES:
                    raise ValueError("type must be one of: " + ", ".join(MAINT_TYPES))
                r["type"] = kv["type"]
            if "time" in kv:
                r["ts"] = parse_local_time(kv["time"])
                r["time"] = _fmt(r["ts"])
            if "end" in kv:
                e = parse_local_time(kv["end"]) if kv["end"] else ""
                r["end_ts"], r["end_time"] = e, _fmt(e) if e else ""
            if "note" in kv:
                r["note"] = " ".join(kv["note"].split())[:500]
            r["status"] = kv.get("status", "confirmed")  # an edited suggestion counts as reviewed
            print("updated #%s" % r["id"])
        save_maint(cfg, rows)
    elif cmd == "maint-import":
        if not pos:
            raise ValueError("usage: modem-monitor maint-import FILE.csv  (columns: time,end_time,type,note[,source])")
        have = {(r["time"][:16], r["type"], r["note"]) for r in rows}
        n = skipped = 0
        with open(pos[0], newline="") as f:
            for x in csv.DictReader(f):
                ts = parse_local_time(x["time"])
                end = parse_local_time(x["end_time"]) if x.get("end_time") else None
                key = (_fmt(ts)[:16], x["type"], " ".join(x["note"].split()))
                if key in have:
                    skipped += 1
                    continue
                add_maint(cfg, ts, x["type"], x["note"], source=x.get("source") or "backfill",
                          status="confirmed", end_ts=end, rows=rows)
                have.add(key)
                n += 1
        save_maint(cfg, rows)
        print("imported %d entr%s (%d already present)" % (n, "y" if n == 1 else "ies", skipped))
    if cmd != "maint-list":
        try:
            build_report(cfg)
        except Exception as e:
            log("report error: %r" % e)


# --------------------------------------------------------------------------
# Export: one zip with all data + diagnostics
# --------------------------------------------------------------------------

MAC_RE = re.compile(r"\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b")
IP_RE = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")


def _private_ip(ip):
    try:
        a, b = (int(x) for x in ip.split(".")[:2])
    except ValueError:
        return True
    return a in (0, 10, 127) or (a == 192 and b == 168) or (a == 172 and 16 <= b <= 31) or (a == 169 and b == 254)


def redact(text):
    text = MAC_RE.sub("xx:xx:xx:xx:xx:xx", text)
    return IP_RE.sub(lambda m: m.group(0) if _private_ip(m.group(0)) else "x.x.x.x", text)


def _run(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (r.stdout + r.stderr).rstrip()
    except (OSError, subprocess.SubprocessError) as e:
        return "(unavailable: %s)" % e


def system_report(cfg):
    dev = wan_device(cfg) or "?"
    st = load_state(cfg)
    safe_state = {k: v for k, v in st.items() if k not in ("uid", "private_key", "seen_events")}
    safe_state["seen_events_count"] = len(st.get("seen_events", []))
    uci = "\n".join(re.sub(r"(\.password=).*", r"\1'(removed)'", l)
                    for l in _run(["uci", "-q", "show", "modem_monitor"]).splitlines())
    logs = _run(["logread", "-e", "modem-monitor"]).splitlines()[-300:]
    nics = sorted(n for n in os.listdir("/sys/class/net") if n.startswith("eth")) if os.path.isdir("/sys/class/net") else []
    # IRQ affinity for each NIC's interrupts
    irq = []
    for line in _read("/proc/interrupts").splitlines():
        m = re.match(r"\s*(\d+):", line)
        if m and any(re.search(r"\b%s\b" % re.escape(n), line) for n in nics):
            n = m.group(1)
            irq.append("IRQ %s  smp_affinity=%s  list=%s  | %s" % (
                n, _read("/proc/irq/%s/smp_affinity" % n), _read("/proc/irq/%s/smp_affinity_list" % n),
                " ".join(line.split()[-3:])))
    rps = ["%s: %s" % (q, _read(q)) for n in nics
           for q in sorted(glob.glob("/sys/class/net/%s/queues/rx-*/rps_cpus" % n))]
    sysctl = ["%s = %s" % (k, _read("/proc/sys/net/core/" + k))
              for k in ("netdev_budget", "netdev_budget_usecs", "netdev_max_backlog", "rps_sock_flow_entries")]
    missed = []
    for n in nics:
        for line in _run(["ethtool", "-S", n]).splitlines():
            if "missed" in line or "drop" in line:
                missed.append("%s %s" % (n, line.strip()))
    # Modem access + DDNS conflict check (an alias on the WAN device can be
    # picked up by ddns-scripts using ip_source=interface)
    mode = cfg.get("modem_route") or ("off" if cfg.get("add_modem_route") == "0" else "host")
    ddns = _run(["uci", "-q", "show", "ddns"])
    warn = []
    secs = {}
    for line in ddns.splitlines():
        m = re.match(r"ddns\.([^.=]+)\.(\w+)='?([^']*)'?$", line)
        if m:
            secs.setdefault(m.group(1), {})[m.group(2)] = m.group(3)
    alias_present = cfg.get("modem_alias_ip", "192.168.100.10") in _run(["ip", "-4", "addr", "show", "dev", dev])
    for name, o in secs.items():
        if o.get("ip_source") == "interface" and o.get("ip_interface") == dev and o.get("enabled", "1") != "0":
            warn.append("WARNING: ddns section '%s' uses ip_source=interface on %s%s" % (
                name, dev, "; the modem alias address is present there and can be picked up as the WAN IP"
                if alias_present else " (no modem alias present now, so no conflict)"))
    access = "\n".join(["mode: %s" % mode, "ip route get %s: %s" % (cfg["host"], _run(["ip", "route", "get", cfg["host"]])),
                        _run(["ip", "-4", "addr", "show", "dev", dev])] + (warn or ["DDNS check: no conflict found"]))
    mi = st.get("modem_info", {})
    parts = [
        ("Generated", time.strftime("%Y-%m-%d %H:%M:%S %Z")),
        ("modem-monitor version", VERSION),
        ("ISP / report note", "%s / %s" % (cfg.get("isp_name") or "(not set)", cfg.get("report_note") or "(not set)")),
        ("OpenWrt release", _read("/etc/openwrt_release")),
        ("Uptime", _run(["uptime"])),
        ("Settings (uci, password removed)", uci),
        ("Monitor state (session keys removed)", json.dumps(safe_state, indent=1, sort_keys=True)),
        ("Modem", "model %s, firmware %s, hardware %s (read %s)" % (
            mi.get("model", "?"), mi.get("firmware", "?"), mi.get("hardware", "?"), _fmt(mi["ts"]) if mi.get("ts") else "never")),
        ("WAN device", dev),
        ("Modem access and DDNS check", access),
        ("ip -s link show " + dev, _run(["ip", "-s", "link", "show", "dev", dev])),
        ("ethtool " + dev, _run(["ethtool", dev])),
        ("ethtool -S " + dev, _run(["ethtool", "-S", dev])),
        ("NIC IRQ affinity (/proc/irq/*/smp_affinity)", "\n".join(irq) or "(none found)"),
        ("RPS (rps_cpus)", "\n".join(rps) or "(none found)"),
        ("net.core sysctls", "\n".join(sysctl)),
        ("NIC missed/drop counters (ethtool -S, all eth*)", "\n".join(missed) or "(none)"),
        ("Data directory", _run(["ls", "-l", cfg["data_dir"]])),
        ("Disk space", _run(["df", "-h", cfg["data_dir"]])),
        ("logread -e modem-monitor (last 300 lines)", "\n".join(logs)),
    ]
    return "".join("==== %s ====\n%s\n\n" % (h, b) for h, b in parts)


def export(cfg, full=False):
    web = cfg["web_dir"]
    os.makedirs(web, exist_ok=True)
    for old in glob.glob(os.path.join(web, "modem-monitor-export-*.zip")):
        os.remove(old)
    name = "modem-monitor-export-%s.zip" % time.strftime("%Y%m%d-%H%M%S")
    path = os.path.join(web, name)
    tmp = path + ".tmp"
    try:
        import zlib  # noqa: F401
        comp = zipfile.ZIP_DEFLATED
    except ImportError:
        comp = zipfile.ZIP_STORED
    clean = (lambda t: t) if full else redact
    files = sorted(glob.glob(os.path.join(cfg["data_dir"], "*.csv")))
    with zipfile.ZipFile(tmp, "w", comp) as z:
        for p in files:
            n = os.path.basename(p)
            if n == "events.csv":
                with open(p, encoding="utf-8", errors="replace") as f:
                    z.writestr("data/" + n, clean(f.read()))
            else:
                z.write(p, "data/" + n)
        rep = os.path.join(web, "index.html")
        if os.path.exists(rep):
            with open(rep, encoding="utf-8", errors="replace") as f:
                z.writestr("report.html", clean(f.read()))
        lat = os.path.join(web, "latest.json")
        if os.path.exists(lat):
            z.write(lat, "latest.json")
        z.writestr("system.txt", clean(system_report(cfg)))
        z.writestr("README.txt",
                   "Cable modem monitor export (modem-monitor %s), %s\n\n"
                   "data/summary-YYYY-MM.csv   one row per sample: levels, error counts, ping\n"
                   "data/channels-YYYY-MM.csv  per-channel power/SNR/error counters\n"
                   "data/events.csv            modem event log entries\n"
                   "data/link-YYYY-MM.csv      router-to-modem Ethernet counters\n"
                   "report.html                the signal report (open in a browser)\n"
                   "system.txt                 versions, settings, NIC counters, monitor log\n\n"
                   "%s\n" % (VERSION, time.strftime("%Y-%m-%d %H:%M:%S"),
                             "Addresses are NOT masked (--full)." if full else
                             "MAC addresses and public IP addresses are masked; the files on the router are unchanged."))
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return path


# --------------------------------------------------------------------------
# Test command (used by the LuCI "Test connection" button)
# --------------------------------------------------------------------------

def test(cfg, raw=False):
    st = load_state(cfg) if os.path.isdir(cfg["data_dir"]) else {}
    st.pop("login_backoff_until", None)  # manual test always tries
    st.pop("uid", None)
    m = S33(cfg, st)
    print("Modem: %s  user: %s" % (cfg["host"], cfg["username"]))
    try:
        m.login()
    except ModemError as e:
        print("FAILED: %s" % e)
        if os.path.isdir(cfg["data_dir"]):
            save_state(cfg, st)
        return 1
    print("Login OK (%s, HMAC-%s)" % (st["scheme"].upper(), st["algo"].upper()))
    resp = m.call(["GetCustomerStatusDownstreamChannelInfo", "GetCustomerStatusUpstreamChannelInfo",
                   "GetCustomerStatusConnectionInfo", "GetCustomerStatusSoftware"])
    sw = resp.get("GetCustomerStatusSoftwareResponse", {})
    for k in ("StatusSoftwareModelName", "StatusSoftwareSfVer", "StatusSoftwareHdVer"):
        if sw.get(k):
            print("%s: %s" % (k.replace("StatusSoftware", ""), sw[k]))
    ds = parse_downstream(resp.get("GetCustomerStatusDownstreamChannelInfoResponse", {}).get("CustomerConnDownstreamChannel"))
    us = parse_upstream(resp.get("GetCustomerStatusUpstreamChannelInfoResponse", {}).get("CustomerConnUpstreamChannel"))
    up = parse_uptime(resp.get("GetCustomerStatusConnectionInfoResponse"))
    print("Uptime: %s" % (str(timedelta(seconds=up)) if up is not None else "unknown"))
    print("\nDownstream: %d channels" % len(ds))
    for c in ds:
        print("  ch %-3s %-8s %-9s %8s MHz  power %6s dBmV  SNR %5s dB  corr %s  uncorr %s"
              % (c["ch"], c["lock"], c["mod"], c["freq"], c["power"], c["snr"], c["corr"], c["uncorr"]))
    print("\nUpstream: %d channels" % len(us))
    for c in us:
        print("  ch %-3s %-8s %-9s %8s MHz  power %6s dBmV" % (c["ch"], c["lock"], c["mod"], c["freq"], c["power"]))
    try:
        lr = m.call(["GetCustomerStatusLog"]).get("GetCustomerStatusLogResponse", {})
        evs = parse_events(lr)
        print("\nEvent log: %d entries (last 8 shown)" % len(evs))
        for e in evs[-8:]:
            print("  %s %s [%s] %s" % (e["date"], e["time"], classify(e["msg"]), e["msg"]))
    except ModemError as e:
        print("\nEvent log: unavailable (%s)" % e)
        lr = {}
    if raw:
        print("\n--- raw ---")
        print(json.dumps(resp, indent=1)[:20000])
        print(json.dumps(lr, indent=1)[:20000])
    if os.path.isdir(cfg["data_dir"]):
        save_state(cfg, st)
    return 0


# --------------------------------------------------------------------------

def daemon(cfg):
    interval = max(60, int(fnum(cfg, "interval")))
    rep_every = max(60, int(fnum(cfg, "report_interval")))
    log("started v%s, polling %s every %ds" % (VERSION, cfg["host"], interval))
    last_rep = 0
    last_prune = 0
    while True:
        t0 = time.time()
        try:
            poll(cfg)
        except Exception as e:  # never die; procd would respawn anyway
            log("poll error: %r" % e)
        if time.time() - last_rep >= rep_every:
            try:
                build_report(cfg)
            except Exception as e:
                log("report error: %r" % e)
            last_rep = time.time()
        if time.time() - last_prune >= 86400:
            try:
                prune(cfg)
            except OSError:
                pass
            last_prune = time.time()
        time.sleep(max(5, interval - (time.time() - t0)))


def main():
    # LuCI buttons run us via rpcd, which uses umask 077. uhttpd refuses to
    # serve files that aren't world-readable, so force sane permissions.
    os.umask(0o022)
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    cfg = load_config()
    if cmd in ("poll", "daemon", "report"):
        os.makedirs(cfg["data_dir"], exist_ok=True)
        os.makedirs(cfg["web_dir"], exist_ok=True)
    if cmd == "daemon":
        daemon(cfg)
    elif cmd == "poll":
        r = poll(cfg)
        print("ok" if r["ok"] else "modem error: %s" % r["error"])
        build_report(cfg)
    elif cmd == "report":
        print(build_report(cfg))
    elif cmd in ("mark", "maint-list", "maint-edit", "maint-del", "maint-confirm", "maint-import"):
        os.makedirs(cfg["data_dir"], exist_ok=True)
        os.makedirs(cfg["web_dir"], exist_ok=True)
        try:
            maint_cli(cfg, cmd, args[1:])
        except (ValueError, OSError, KeyError) as e:
            print("error: %s" % e)
            sys.exit(2)
    elif cmd == "reboot-modem":
        pos, kv, bools = _opts(args[1:])
        try:
            print(reboot_modem(cfg, kv.get("note") or " ".join(pos), "force" in bools))
            build_report(cfg)
        except ModemError as e:
            print("error: %s" % e)
            sys.exit(1)
    elif cmd == "export":
        p = export(cfg, "--full" in args)
        print("%s (%d KB)" % (os.path.basename(p), round(os.path.getsize(p) / 1024)))
        print(p)
    elif cmd == "test":
        sys.exit(test(cfg, "--raw" in args))
    elif cmd in ("version", "--version"):
        print(VERSION)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
