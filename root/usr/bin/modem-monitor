 $("#ingress").innerHTML=(!ING.length)?"<div class='ing ok'>No day in this range had 1,000+ uncorrectables, so there is no error pattern to judge.</div>":
  "<div class=ing>"+(nar.length?"<b>Likely ingress on "+nar.length+" day"+(nar.length===1?"":"s")+"</b>: most errors were on 3 adjacent channels.<ul>"+nar.slice().reverse().map(i=>"<li>"+i.day+": <b>"+i.share+"%</b> of "+i.total.toLocaleString()+" on "+i.fmin+"–"+i.fmax+" MHz (ch "+i.chs.map(esc).join(", ")+")"+(i.ofdm?"; "+i.ofdm.toLocaleString()+" on OFDM":"")+"</li>").join("")+"</ul>":"")+
  (wid.length?(nar.length?"<div style='margin-top:6px'>":"<div>")+"<b>Spread across the band</b> on "+wid.map(i=>i.day+" ("+i.total.toLocaleString()+")").join(", ")+".</div>":"")+"</div>";
