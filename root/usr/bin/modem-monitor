  let best=null;ser.forEach(s=>s.pts.forEach(p=>{const d=Math.abs(p[0]-t);if(!best||d<best)best=d}));if(best===null||best>step*2){tip.style.display="none";xh.style.display="none";return}
  let rows=[],tt=null;ser.forEach(s=>{let q=null;s.pts.forEach(p=>{if(!q||Math.abs(p[0]-t)<Math.abs(q[0]-t))q=p});if(q&&Math.abs(q[0]-t)<=step*2){tt=tt??q[0];rows.push("<div><i style='background:var(--s"+s.ci+")'></i>"+esc(s.name)+": <b>"+q[1]+"</b> "+esc(c.unit==="per interval"?"":c.unit)+"</div>")}});
  MK.filter(m=>Math.abs(m.ts-t)<=(x1-x0)/60||(m.end&&t>=m.ts&&t<=m.end)).forEach(m=>rows.push("<div class=sub>#"+m.n+" "+esc(m.type)+": "+esc(m.note.length>70?m.note.slice(0,70)+"\u2026":m.note)+"</div>"));
  xh.setAttribute("x1",X(tt));xh.setAttribute("x2",X(tt));xh.style.display="";
  tip.innerHTML="<div class=sub>"+fmtFull(tt)+(rg.bucket?" (+"+Math.round(rg.bucket/60)+" min)":"")+"</div>"+rows.join("");tip.style.display="block";
  const cr=card.getBoundingClientRect();let lx=e.clientX-cr.left+12;if(lx+tip.offsetWidth>cr.width)lx=e.clientX-cr.left-tip.offsetWidth-12;tip.style.left=lx+"px";tip.style.top=(e.clientY-cr.top+12)+"px"});
 svg.addEventListener("mouseleave",()=>{tip.style.display="none";xh.style.display="none"});
 return card}
function count(lo){
 const t={T3:0,T4:0,DRW:0,uncorr:0,us_max:null,reboots:0,relocks:0,failed:0,loss_polls:0,polls:0,link_err:0,missed:0,missed_flag:false,link_drops:0,drops:0,lostch:0};
 (D.evc||[]).forEach(e=>{if(e[0]>=lo&&(e[1]==="T3"||e[1]==="T4"||e[1]==="DRW"))t[e[1]]++});
 (D.samples||[]).forEach(r=>{if(r[0]<lo)return;t.polls++;t.failed+=r[1];t.reboots+=r[2];t.relocks+=r[3];t.uncorr+=r[4];t.drops+=r[8]||0;t.lostch+=r[9]||0;if(r[5]!=null)t.us_max=t.us_max==null?r[5]:Math.max(t.us_max,r[5]);if((r[6]||0)>0)t.loss_polls++});
 (D.lk||[]).forEach(r=>{if(r[0]<lo)return;t.link_err+=r[1];t.missed+=r[2];t.link_drops+=r[3];if(r[2]>100)t.missed_flag=true});
 return t}
function tiles(rg){const t=count(Math.max(D.now-rg.span,SINCE||0)),u=T.us_power_max,li=D.link_info||{};
 const items=[["T3 timeouts",t.T3,"upstream ranging failures",t.T3>0],["T4 timeouts",t.T4,"modem lost contact, reset",t.T4>0],["Upstream power warnings",t.DRW,"dynamic range window violations",t.DRW>0],["Uncorrectable codewords",t.uncorr.toLocaleString(),"damaged downstream data",t.uncorr>0],
  ["Peak upstream power",t.us_max==null?"\u2013":t.us_max+" dBmV","guideline max "+u,t.us_max!=null&&t.us_max>u],["Modem reboots",t.reboots,"uptime reset",t.reboots>0],["Re-registrations",t.relocks,"lost signal, no reboot",t.relocks>0],
  ["Modem unreachable",t.failed,"of "+t.polls+" samples",t.failed>0],["Samples with packet loss",t.loss_polls,"of "+t.polls+" samples",t.loss_polls>0]];
 if(D.hires_on)items.push(["Short dropouts",t.drops,"from 1-second pings",t.drops>0]);
 items.push(["Samples with missing channels",t.lostch,"partial service",t.lostch>0]);
 if((D.lk||[]).length)items.push(["Router\u2013modem Ethernet errors",t.link_err,t.link_drops+" link drop"+(t.link_drops===1?"":"s")+" \u00b7 "+(li.dev||"WAN")+(li.speed?" "+li.speed+" Mb/s":""),t.link_err>0||t.link_drops>0]);
 if((D.lk||[]).length&&t.missed)items.push(["Router NIC missed packets",t.missed.toLocaleString(),t.missed_flag?"over 100 in one sample: router tuning":"receive-buffer overruns",t.missed_flag]);
 $("#tiles").innerHTML=items.map(i=>"<div class='tile"+(i[3]?" bad":"")+"'><div class=k>"+esc(i[0])+"</div><div class=v>"+esc(i[1])+"</div><div class=n>"+esc(i[2])+"</div></div>").join("")}
