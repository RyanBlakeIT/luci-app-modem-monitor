  tip.innerHTML="<div class=sub>"+fmtFull(t)+" (+"+(H.size>=86400?"1 day":H.size/3600+" h")+")</div><div>"+(r.ofdm?"OFDM ":"Ch "+esc(r.ch)+" · ")+r.freq+" MHz: <b>"+v.toLocaleString()+"</b> uncorrectables</div>";tip.style.display="block";
