function heat(rg){const H=rg.heat,el=$("#heat"),lo=Math.max(D.now-rg.span,SINCE||0);
 const ING=(D.ingress||[]).filter(i=>i.ts+86400>lo&&i.ts>=D.now-rg.span-86400);
